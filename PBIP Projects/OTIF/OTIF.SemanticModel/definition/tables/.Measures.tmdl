table '.Measures'
	lineageTag: ed18203f-eca1-4302-a05b-062fd66e2fa1

	/// Distinct Salesforce case count.
	measure Complaints = DISTINCTCOUNT ( Complaints[CaseNumber] )
		displayFolder: Quality
		lineageTag: fd33d280-3bd1-43ea-81e3-d53782bbcbd5

	/// ([Orders] minus [Complaints]) divided by [Orders]. Orders and complaints are unrelated populations at different grains and over different windows, so this can return a negative value once filtered.
	measure 'Orders W/o Complaints' = DIVIDE ( [Orders] - [Complaints], [Orders] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Quality
		lineageTag: 7c7fa426-b566-4b60-98b4-f07478ea69e6

	/// Order line count.
	measure 'Order Lines' = COUNT('FactSalesDetail'[OrderKey])
		formatString: #,0
		displayFolder: OTIF by Line
		lineageTag: 9b263b66-0f6e-48e6-8115-b3e453583035

	/// Distinct order count.
	measure Orders = DISTINCTCOUNT('FactSalesDetail'[Order Num])
		formatString: #,0
		displayFolder: OTIF Header
		lineageTag: 5aed99d0-0b67-4627-9166-8f1182c05858

	/// [Orders] minus [Orders (Late)].
	measure 'On Time Orders (Header)' =
			
			[Orders] - [Orders (Late)]
		formatString: #,0
		displayFolder: OTIF Header
		lineageTag: 7f981b0b-d326-4155-905a-0613d2e53815

	/// [On Time Orders (Header)] divided by [Orders]. Order grain, against the promised date.
	measure 'On Time Order % (Header)' =
			
			DIVIDE(
			    [On Time Orders (Header)],
			    [Orders]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF Header
		lineageTag: f574cf8f-1dd5-4ccb-a313-a1a040649a6c

	/// Line-grain on-time rate against the promised date, read from the stored [On Time] flag: [Order Lines (On Time)] divided by [Order Lines]. Does not respond to the 'Reason Filter' slicer.
	measure 'Shipped as Promised % (Lines)' =
			
			DIVIDE(
			    [Order Lines (On Time)],
			    [Order Lines]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF by Line
		lineageTag: ac1e9b22-1f3a-486e-a0e6-20e6b7c5cdc5

	/// Distinct orders having at least one line flagged late.
	measure 'Orders (Late)' =
			
			CALCULATE ( DISTINCTCOUNT ( 'FactSalesDetail'[Order Num] ), 'FactSalesDetail'[On Time] = 0 )
		formatString: 0
		displayFolder: OTIF Header
		lineageTag: ed5c5566-958d-4038-a8a8-8f90edac022b

	/// [Order Lines] minus [Order Lines (On Time)].
	measure 'Order Lines (Late)' = [Order Lines]-[Order Lines (On Time)]
		formatString: 0
		displayFolder: OTIF by Line
		lineageTag: cab8217c-9397-4b26-9eb8-7307c059582f

	/// Distinct (OrderLineID, RevisionReason) pairs - a reason counts once per order line however many times it recurs on that line.
	measure 'OTIF Episodes (1 per line per reason)' =
			
			COUNTROWS (
			    SUMMARIZE (
			        FactScheduleChange,
			        FactScheduleChange[OrderLineID],
			        FactScheduleChange[RevisionReason]
			    )
			)
		formatString: 0
		lineageTag: 2092e637-f40d-4d17-8f5c-bb0f5438fb80

	/// Order lines with no OTIF-relevant revision, summed from the [On Time] flag.
	measure 'Order Lines (On Time)' = SUM('FactSalesDetail'[On Time])
		formatString: 0
		displayFolder: OTIF by Line
		lineageTag: a9463a87-94ba-40d3-8a67-379c3cf13b11

	/// Distinct (OrderLineID, RevisionReason) pairs, attributed only to the revision with the most recent ChangeDate. On a ChangeDate axis each pair falls in a single month; on an Actual Ship Date axis it equals [OTIF Episodes (1 per line per reason)].
	measure 'OTIF Episodes (latest line/reason only)' =
			CALCULATE (
			    COUNTROWS (
			        SUMMARIZE (
			            FactScheduleChange,
			            FactScheduleChange[OrderLineID],
			            FactScheduleChange[RevisionReason]
			        )
			    ),
			    FactScheduleChange[Is Latest Line-Reason Change] = 1
			)
		formatString: 0
		lineageTag: 0f677487-6b45-4ea9-843d-6b9267baa8ad

	/// Distinct orders having at least one line whose OTIF-relevant revision reason is selected in the 'Reason Filter' slicer. Equals [Orders (Late)] when every reason is selected.
	measure 'Orders (Late, Reason-Filtered)' =
			VAR SelReasons = VALUES ( 'Reason Filter'[Reason Code] )
			VAR LateLineIDs =
			    CALCULATETABLE (
			        VALUES ( FactScheduleChange[OrderLineID] ),
			        FactScheduleChange[Is OTIF Relevant] = TRUE (),
			        TREATAS ( SelReasons, FactScheduleChange[RevisionReason] )
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'FactSalesDetail'[Order Num] ),
			        TREATAS ( LateLineIDs, 'FactSalesDetail'[Order Line ID] )
			    )
		formatString: 0
		displayFolder: OTIF Header (Reason Filter)
		lineageTag: f37bcea3-d23e-45d5-81a6-71eaeb0ea4e3

	/// [Orders] minus [Orders (Late, Reason-Filtered)]. The denominator is unaffected by the 'Reason Filter' slicer.
	measure 'On Time Orders (Reason-Filtered)' = [Orders] - [Orders (Late, Reason-Filtered)]
		formatString: #,0
		displayFolder: OTIF Header (Reason Filter)
		lineageTag: 38be58e4-7d7d-47e9-ba4d-57a2ec7bd603

	/// [On Time Orders (Reason-Filtered)] divided by [Orders]. Responds to the 'Reason Filter' slicer; the denominator does not.
	measure 'On Time Order % (Reason-Filtered)' = DIVIDE ( [On Time Orders (Reason-Filtered)], [Orders] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF Header (Reason Filter)
		lineageTag: 4b22f99e-cf82-42b6-ae78-325e9e830030

	/// Distinct shipped orders - Actual Ship Date on or after 2000-01-01, which excludes the JDE empty-date sentinel.
	measure 'Orders In Scope' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'FactSalesDetail'[Order Num] ),
			    'FactSalesDetail'[Actual Ship Date] >= DATE ( 2000, 1, 1 )
			)
		formatString: 0
		lineageTag: 87cfd7de-b413-4fde-8a2b-94f43509fe56

	/// Distinct shipped orders carrying at least one OTIF-relevant revision whose reason is selected in the 'Reason Filter' slicer. No selection counts every reason.
	measure 'Late Orders (reason-filtered)' =
			VAR SelectedReasons = VALUES ( 'Reason Filter'[Reason Code] )
			VAR LateLineKeys =
			    CALCULATETABLE (
			        DISTINCT ( FactScheduleChange[OrderLineID] ),
			        FactScheduleChange[Is OTIF Relevant] = TRUE (),
			        TREATAS ( SelectedReasons, FactScheduleChange[RevisionReason] )
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'FactSalesDetail'[Order Num] ),
			        TREATAS ( LateLineKeys, 'FactSalesDetail'[Order Line ID] ),
			        'FactSalesDetail'[Actual Ship Date] >= DATE ( 2000, 1, 1 )
			    )
		formatString: 0
		lineageTag: 2f15e482-9163-4c35-9005-f8dc1983f78e

	/// Order-grain on-time rate against the promised date, recomputed from the 'Reason Filter' selection: ([Orders In Scope] minus [Late Orders (reason-filtered)]) divided by [Orders In Scope].
	measure 'Shipped as Promised % (dynamic)' =
			
			DIVIDE ( [Orders In Scope] - [Late Orders (reason-filtered)], [Orders In Scope] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5acc2718-184d-4261-adbd-379694aa2cbf

	/// Count of order lines that shipped on or before the requested date.
	measure 'Shipped as Requested' = SUM('FactSalesDetail'[Shipped as Requested])
		formatString: #,0
		lineageTag: bec23ec9-c345-4929-9e67-be666ad79398

	/// [Shipped as Requested] divided by [Order Lines]. Line-grain on-time rate against the customer's requested date, as opposed to the negotiated promised date. The denominator is all lines in context, not only shipped ones; an unshipped line carries the JDE empty ship date, which precedes any requested date and therefore scores as on time. Filter to shipped lines, or use a date axis on Actual Ship Date, for a shipped-only rate.
	measure 'Shipped as Requested %' = DIVIDE ( [Shipped as Requested], [Order Lines] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 627bcac7-005e-45fd-8f31-7259003e1eb7

	/// Order lines that missed the requested date: [Order Lines] minus [Shipped as Requested].
	measure 'Late to Requested' = [Order Lines]-[Shipped as Requested]
		formatString: 0
		lineageTag: c98f69ee-fc15-4d29-b485-324905dbf2dd

	/// Distinct late orders scored on the original JDE reason codes, ignoring Revision Log Editor overrides and exclusions. Compare with [Orders (Late)] to size the effect of those edits.
	measure 'Orders (Late, As Reported)' =
			
			CALCULATE ( DISTINCTCOUNT ( 'FactSalesDetail'[Order Num] ), 'FactSalesDetail'[On Time (As Reported)] = 0 )
		formatString: 0
		displayFolder: OTIF Header (As Reported)
		lineageTag: adcc61dc-0c96-4548-9232-2f8d2a4abb54

	/// The viewer's principal name. Never blank, so it must not be bound to a grid field well - use [Current User (Grid)] or [Current User (Revisions)] instead.
	measure 'Current User' = USERPRINCIPALNAME()
		lineageTag: c8cbe507-743f-4084-be05-8690ce0211ff

	/// Shipped order lines - Actual Ship Date on or after 2000-01-01, which excludes the JDE empty-date sentinel. Line-grain denominator.
	measure 'Lines In Scope' =
			
			CALCULATE (
			    COUNTROWS ( 'FactSalesDetail' ),
			    'FactSalesDetail'[Actual Ship Date] >= DATE ( 2000, 1, 1 )
			)
		formatString: 0
		lineageTag: 45a9ece7-c12e-4e4d-a637-9073749c611b

	/// Shipped order lines carrying at least one OTIF-relevant revision whose reason is selected in the 'Reason Filter' slicer. Line grain. No selection counts every reason.
	measure 'Late Lines (reason-filtered)' =
			VAR SelectedReasons = VALUES ( 'Reason Filter'[Reason Code] )
			VAR LateLineKeys =
			    CALCULATETABLE (
			        DISTINCT ( FactScheduleChange[OrderLineID] ),
			        FactScheduleChange[Is OTIF Relevant] = TRUE (),
			        TREATAS ( SelectedReasons, FactScheduleChange[RevisionReason] )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'FactSalesDetail' ),
			        TREATAS ( LateLineKeys, 'FactSalesDetail'[Order Line ID] ),
			        'FactSalesDetail'[Actual Ship Date] >= DATE ( 2000, 1, 1 )
			    )
		formatString: 0
		lineageTag: 32f87ce9-2da4-4ca3-8261-6df5108b0f42

	/// Line-grain on-time rate against the promised date, recomputed at query time from the 'Reason Filter' selection: ([Lines In Scope] minus [Late Lines (reason-filtered)]) divided by [Lines In Scope].
	measure 'Shipped as Promised % (Lines, dynamic)' =
			
			DIVIDE ( [Lines In Scope] - [Late Lines (reason-filtered)], [Lines In Scope] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8e62079f-1151-4b98-a32a-23072186c2bc

	/// Average promised-date slip, in days, across the OTIF-relevant revisions in context. Excluded revisions are ignored.
	measure 'Avg Days Moved' =
			CALCULATE (
			    AVERAGE ( FactScheduleChange[Days Moved] ),
			    FactScheduleChange[Is OTIF Relevant] = TRUE ()
			)
		formatString: 0.0
		displayFolder: OTIF by Reason
		lineageTag: 3c9d1a5e-42b7-4f80-9d16-5a0e7c2b8f31

	/// Target rate for the reference line on the trend charts, taken from the 'OTIF Target' what-if slicer. Returns blank at 0, which removes the line from the chart. FALLBACK RAISED 0.96 -> 0.99 on 2026-08-07 (Bryan). The fallback is what renders -- no page carries the slicer. Keep in step with the Executive Dashboard PBIP, which has its own copy.
	measure 'OTIF Target Line' =
			VAR t = SELECTEDVALUE ( 'OTIF Target'[OTIF Target], 0.99 )
			RETURN
			    IF ( t <= 0, BLANK (), t )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Targets
		lineageTag: 7b2f4c81-9e30-4a6d-b5c7-1d84e0f9a237

	/// [Shipped as Promised % (Lines, dynamic)] restricted to the Americas region.
	measure 'Shipped as Promised % — Americas' = CALCULATE ( [Shipped as Promised % (Lines, dynamic)], 'Dim Region'[Region] = "Americas" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF by Line\By Region
		lineageTag: a41e7d92-3c65-4b08-8f27-6e0b91d3c5a4

	/// [Shipped as Promised % (Lines, dynamic)] restricted to the EMEA region.
	measure 'Shipped as Promised % — EMEA' = CALCULATE ( [Shipped as Promised % (Lines, dynamic)], 'Dim Region'[Region] = "EMEA" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF by Line\By Region
		lineageTag: b52f8e03-4d76-4c19-9038-7f1ca2e4d6b5

	/// [Shipped as Promised % (Lines, dynamic)] restricted to the Asia region.
	measure 'Shipped as Promised % — Asia' = CALCULATE ( [Shipped as Promised % (Lines, dynamic)], 'Dim Region'[Region] = "Asia" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF by Line\By Region
		lineageTag: c63f9f14-5e87-4d2a-a149-801db3f5e7c6

	/// [Shipped as Promised % (Lines, dynamic)] across all regions. Clearing filters on Dim Region removes only a region cross-filter; every other slicer still applies.
	/// All-region line rate for the trend charts. Blanks itself when only one region is in play, because the region picker on these pages is the Order Company slicer — that filter sits on FactSalesDetail and REMOVEFILTERS('Dim Region') cannot clear it, so with one company selected Total collapses onto that region's own line and, drawing last, hides it under the orange Total colour (Ivan, 2026-07-30). Region count is taken over the whole selected date window so Total does not flicker on months where only one region shipped.
	measure 'Shipped as Promised % — Total' =
			VAR RegionsInPlay =
			    CALCULATE ( DISTINCTCOUNT ( 'FactSalesDetail'[Region] ), ALLSELECTED ( DateTable ) )
			RETURN
			    IF (
			        RegionsInPlay <= 1,
			        BLANK (),
			        CALCULATE ( [Shipped as Promised % (Lines, dynamic)], REMOVEFILTERS ( 'Dim Region' ) )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF by Line\By Region
		lineageTag: d74fa025-6f98-4e3b-b25a-912ec406f8d7

	/// [Shipped as Requested %] restricted to the Americas region.
	measure 'Shipped as Requested % — Americas' = CALCULATE ( [Shipped as Requested %], 'Dim Region'[Region] = "Americas" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Shipped as Requested\By Region
		lineageTag: e850b136-709a-4f4c-836b-a23fd517098e

	/// [Shipped as Requested %] restricted to the EMEA region.
	measure 'Shipped as Requested % — EMEA' = CALCULATE ( [Shipped as Requested %], 'Dim Region'[Region] = "EMEA" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Shipped as Requested\By Region
		lineageTag: f961c247-81ab-405d-947c-b34e0628190f

	/// [Shipped as Requested %] restricted to the Asia region.
	measure 'Shipped as Requested % — Asia' = CALCULATE ( [Shipped as Requested %], 'Dim Region'[Region] = "Asia" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Shipped as Requested\By Region
		lineageTag: 0a72d358-92bc-4165-a58d-c45107392a10

	/// [Shipped as Requested %] across all regions. Clearing filters on Dim Region removes only a region cross-filter; every other slicer still applies.
	measure 'Shipped as Requested % — Total' = CALCULATE ( [Shipped as Requested %], REMOVEFILTERS ( 'Dim Region' ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Shipped as Requested\By Region
		lineageTag: 1b83e469-a3cd-4276-b69e-d5621844b321

	/// Returns 1 when the order line has a revision matching the current reason selection, and 1 for every line when no reason is filtered. Reverses the revision-to-line relationship inside the measure only, so reason slicers can reach the order-line grids without a bidirectional relationship. Apply as a visual-level filter, is 1.
	measure 'Matches Reason Selection' =
			VAR AnyReasonFilter =
			    ISFILTERED ( 'Reason Codes'[Revision Reason & Description] )
			        || ISFILTERED ( 'Reason Codes'[Code] )
			        || ISFILTERED ( 'Reason Codes'[Category] )
			        || ISFILTERED ( FactScheduleChange[RevisionReason] )
			VAR MatchingRevisions =
			    CALCULATE (
			        COUNTROWS ( FactScheduleChange ),
			        CROSSFILTER ( FactSalesDetail[Order Line ID], FactScheduleChange[OrderLineID], BOTH )
			    )
			RETURN
			    IF (
			        NOT AnyReasonFilter,
			        1,
			        IF ( NOT ISBLANK ( MatchingRevisions ) && MatchingRevisions > 0, 1, 0 )
			    )
		formatString: 0
		displayFolder: Cross-filter
		lineageTag: 4ac586c0-d267-42ea-bc2a-c5ff563bef74

	/// Distinct shipped orders. Denominator for the order-grain Shipped as Requested.
	measure 'Requested Orders In Scope' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'FactSalesDetail'[Order Num] ),
			    'FactSalesDetail'[Actual Ship Date] >= DATE ( 2000, 1, 1 )
			)
		formatString: #,0
		displayFolder: Shipped as Requested\Orders
		lineageTag: 6c0e97f9-64a1-48c7-987c-c1a5f3e32ec7

	/// Orders where every shipped line in context met its requested date.
	measure 'Requested Orders On Time' =
			
			COUNTROWS (
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( 'FactSalesDetail'[Order Num] ),
			            "@AllLinesOnRequestedDate",
			                CALCULATE ( MIN ( 'FactSalesDetail'[Shipped as Requested] ) )
			        ),
			        [@AllLinesOnRequestedDate] = 1
			    )
			)
		formatString: #,0
		displayFolder: Shipped as Requested\Orders
		lineageTag: 475eb876-a21b-4f14-b5a7-bdf7d107445e

	/// [Requested Orders In Scope] minus [Requested Orders On Time].
	measure 'Requested Orders Late' = [Requested Orders In Scope] - [Requested Orders On Time]
		formatString: #,0
		displayFolder: Shipped as Requested\Orders
		lineageTag: 87628589-e1f6-4ddf-8dac-e0a841976b2c

	/// [Requested Orders On Time] divided by [Requested Orders In Scope]. Order grain, against the requested date.
	measure 'Shipped as Requested % (Orders)' = DIVIDE ( [Requested Orders On Time], [Requested Orders In Scope] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Shipped as Requested\Orders
		lineageTag: 20b32e64-b38b-4c40-9d5f-0d2ae3659e50

	/// Returns 1 when the order line passes the 'OTIF Impact Selector' toggle: always under 'All orders', and only for lines carrying an OTIF-relevant revision under 'OTIF-impact orders'. Apply as a visual-level filter, is 1.
	measure 'Matches OTIF Impact Selection' =
			
			VAR ImpactOnly =
			    SELECTEDVALUE ( 'OTIF Impact Selector'[Selection], "All orders" ) = "OTIF-impact orders"
			VAR HasImpact =
			    CALCULATE (
			        COUNTROWS ( FactScheduleChange ),
			        FactScheduleChange[Is OTIF Relevant] = TRUE (),
			        CROSSFILTER ( FactSalesDetail[Order Line ID], FactScheduleChange[OrderLineID], BOTH )
			    ) > 0
			RETURN
			    IF ( NOT ImpactOnly || HasImpact, 1, 0 )
		formatString: 0
		displayFolder: Cross-filter
		lineageTag: 8dbb7f34-8036-4efb-a451-e6f04e076fe6

	/// Viewer identity for grids over FactSalesDetail. Blank where the fact has no rows in context, which keeps blank-row removal working so the grid still respects page filters.
	measure 'Current User (Grid)' = IF ( NOT ISBLANK ( [Order Lines] ), USERPRINCIPALNAME () )
		lineageTag: d4686c37-654e-4c04-9665-03fc96065656

	/// Comma-separated list of every Order Company, for the writeback visuals' Company List field well. Reads the unrelated 'Companies' table, so a page filtered to one company still returns the full picklist. Blank where FactSalesDetail has no rows.
	measure 'Company List (All)' =
			IF (
			    NOT ISBLANK ( [Order Lines] ),
			    CONCATENATEX ( Companies, Companies[Order Company], "," )
			)
		lineageTag: 7bd1eaf3-3235-4ca3-900c-5221d1e1640e

	/// Viewer identity for grids over FactScheduleChange. Blank where the revision ledger has no rows in context, which keeps blank-row removal working so the grid still respects page filters and cross-filtering.
	measure 'Current User (Revisions)' = IF ( NOT ISBLANK ( COUNTROWS ( FactScheduleChange ) ), USERPRINCIPALNAME () )
		lineageTag: 3f67a900-d721-4540-a995-1a4c9b5c0513

	/// Order line count at PARENT grain: split children (1.001, 1.002, ...) collapse into their parent line. 68,077 vs 82,928 at line grain on the 2026-08-04 data. Freight lines are counted, exactly as [Order Lines] counts them, so the two measures are directly comparable.
	measure 'Order Lines (Parent)' = DISTINCTCOUNT ( 'FactSalesDetail'[Parent Order Line ID] )
		formatString: #,0
		displayFolder: OTIF by Parent Line
		lineageTag: c3e91a47-8b62-4d05-9f18-2a7d64c0b391

	/// Split children absorbed by the parent roll-up: [Order Lines] minus [Order Lines (Parent)]. This is the split inflation, 14,851 lines (17.9%) on the 2026-08-04 data.
	measure 'Split Lines Collapsed' = [Order Lines] - [Order Lines (Parent)]
		formatString: #,0
		displayFolder: OTIF by Parent Line
		lineageTag: 6f28d5b3-4c19-4e87-a260-91b3e7f5c8d2

	/// Late count at PARENT grain. Agreed rule (2026-08-04): the parent row's own status decides and children are ignored. The parent is the lowest [Line Num] in the family - the .000 row where one exists, and the lowest child for the 117 families that have none, so no separate fallback branch is needed. Measured: 2,741, against 2,756 under an any-child-late rule; the two rules differ on 15 of 68,077 families.
	measure 'Order Lines (Parent, Late)' =
			COUNTROWS (
			    FILTER (
			        VALUES ( 'FactSalesDetail'[Parent Order Line ID] ),
			        VAR MinLine = CALCULATE ( MIN ( 'FactSalesDetail'[Line Num] ) )
			        RETURN
			            CALCULATE (
			                MAX ( 'FactSalesDetail'[Late] ),
			                'FactSalesDetail'[Line Num] = MinLine
			            ) = 1
			    )
			)
		formatString: #,0
		displayFolder: OTIF by Parent Line
		lineageTag: 0b7c4e92-5d38-41a6-8e73-c6f2905ba14e

	/// [Order Lines (Parent)] minus [Order Lines (Parent, Late)].
	measure 'Order Lines (Parent, On Time)' = [Order Lines (Parent)] - [Order Lines (Parent, Late)]
		formatString: #,0
		displayFolder: OTIF by Parent Line
		lineageTag: 8d1f60ca-2e75-4b93-9c04-5a7e38d1f6b0

	/// On-time line % at parent grain, so split lines are not double-counted in the denominator. Compare against [On Time Line %] to show the effect of the roll-up.
	measure 'On Time Line % (Parent)' = DIVIDE ( [Order Lines (Parent, On Time)], [Order Lines (Parent)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: OTIF by Parent Line
		lineageTag: 4e5b8237-9a16-4c60-b8d5-73f1c2e094a7

	/// Order qty with FREIGHT EXCLUDED ([Line Type] = "FS"). This is the roll-up-safe quantity: freight rides inside a parent family at .010 as 1 EA BILLABLE FREIGHT, and summing it into 15 TO of product is meaningless. Use this, not [Qty Ordered], whenever the grain is [Parent Order Line ID]. Verified 2026-08-04: with FS excluded, none of the 8,119 multi-row families disagree on Item, UoM or Master Planning Family, so the sum is well defined.
	measure 'Qty Ordered (ex Freight)' = CALCULATE ( SUM ( 'FactSalesDetail'[Qty Ordered] ), 'FactSalesDetail'[Line Type] <> "FS" )
		formatString: #,##0
		displayFolder: OTIF by Parent Line
		lineageTag: 91a3c7d5-6b20-4f18-8347-e0d9b2f5a6c8

	/// [Order Lines] with DateTable joined on Promised Delivery Date instead of Actual Ship Date, so unshipped lines land on the calendar by their current promise. Open orders have no Actual Ship Date, which makes the active relationship drop them from any DateTable axis or slicer - this is the measure the OTIF Backlog (Open Orders) page reads.
	measure 'Order Lines (Backlog)' =
			CALCULATE (
			    [Order Lines],
			    USERELATIONSHIP ( 'FactSalesDetail'[Promised Delivery Date], 'DateTable'[Date] )
			)
		formatString: #,0
		displayFolder: OTIF Backlog (Open Orders)
		lineageTag: 5e8a2c47-9d13-4b6f-a0e2-7c4f81d3b952

	/// [Order Lines (Late)] under the Promised Delivery Date relationship. See [Order Lines (Backlog)].
	measure 'Order Lines (Late, Backlog)' =
			CALCULATE (
			    [Order Lines (Late)],
			    USERELATIONSHIP ( 'FactSalesDetail'[Promised Delivery Date], 'DateTable'[Date] )
			)
		formatString: 0
		displayFolder: OTIF Backlog (Open Orders)
		lineageTag: 1b6d9f30-4a78-4c25-8e91-d5a3c60e7f14

	/// [OTIF Episodes (latest line/reason only)] under the Promised Delivery Date relationship. DateTable reaches FactScheduleChange through FactSalesDetail, so revisions on unshipped lines stay visible on the promise calendar. See [Order Lines (Backlog)].
	measure 'OTIF Episodes (Backlog)' =
			CALCULATE (
			    [OTIF Episodes (latest line/reason only)],
			    USERELATIONSHIP ( 'FactSalesDetail'[Promised Delivery Date], 'DateTable'[Date] )
			)
		formatString: 0
		displayFolder: OTIF Backlog (Open Orders)
		lineageTag: 9f2c5a81-3e67-4d09-b48c-a17e6b204d38

	column Value
		formatString: 0
		lineageTag: e6e10859-5ea4-47ad-9f2c-07e9e8d55f09
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition '.Measures' = calculated
		mode: import
