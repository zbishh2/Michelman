/// Disconnected what-if slicer of OTIF-relevant revision reasons (OTIF='X' in the SharePoint Code dim). Drives the 'Reason-Filtered' OTIF measures so a user can isolate or exclude reason codes (e.g. L2) and see the recomputed On Time %. NOT related to any table on purpose — selection is read via VALUES() inside the measures, so it never filters the order universe (denominator stays full).
table 'Reason Filter'
	lineageTag: 68030054-2dfc-4256-8800-a4514dd1b2fb

	column 'Reason Code'
		lineageTag: 57721a15-8e82-44f8-8228-033263440117
		summarizeBy: none
		isNameInferred
		sourceColumn: [Reason Code]

		annotation SummarizationSetBy = Automatic

	column Reason
		lineageTag: 4c15939d-7f19-475f-8a1a-b954031f85e7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Reason]

		annotation SummarizationSetBy = Automatic

	partition 'Reason Filter' = calculated
		mode: import
		source =
				SELECTCOLUMNS (
				    FILTER (
				        'Reason Codes',
				        UPPER ( TRIM ( 'Reason Codes'[OTIF] ) ) = "X"
				    ),
				    "Reason Code", 'Reason Codes'[Code],
				    "Reason", 'Reason Codes'[Code] & "  —  " & 'Reason Codes'[Description]
				)

