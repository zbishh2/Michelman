	/// Resolves a complaint to a region from the Salesforce Region field, falling back to Location when Region is Global or blank. Join key to 'Dim Region'[Region]. Unresolvable rows return "Unmapped", which has its own dimension member so they stay visible.
	column 'Region Mapped' = ```
			
			  VAR ByRegion =
			      SWITCH (
			          TRUE (),
			          Complaints[Region] = "Americas", "Americas",
			          Complaints[Region] = "EMEA", "EMEA",
			          Complaints[Region] IN { "Asia", "China", "India", "Pacific Rim" }, "Asia",
			          BLANK ()   // Global / (Blank) -> not resolvable, fall through to Location
			      )
			  VAR ByLocation =
			      SWITCH (
			          TRUE (),
			          Complaints[Location] IN { "Kemper", "Shell" }, "Americas",
			          Complaints[Location] IN { "Aubange", "Windhof" }, "EMEA",
			          Complaints[Location] = "Singapore", "Asia",
			          BLANK ()   // All Sites / (Blank) -> not resolvable
			      )
			  RETURN
			      COALESCE ( ByRegion, ByLocation, "Unmapped" )
			```
		lineageTag: 45cf05f0-ad4c-4458-82d9-e58a5f62b8cf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

