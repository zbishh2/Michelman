	partition Complaints = m
		mode: import
		source =
				let
				    Source = Sql.Databases("EDWDEV"),
				    EDW = Source{[Name = "EDW"]}[Data],
				    BIQL_TbSF_Case = EDW{[Schema = "BIQL", Item = "TbSF_Case"]}[Data],
				    // 2026-06-24: expanded the column set for Jessica's drill-through + lower-right
				    // table asks (customer / qty / UOM / case detail). All adds are plain readable
				    // columns already on BIQL.TbSF_Case — no new tables/joins. Grain unchanged
				    // (one row per case), so existing measures are unaffected. Open picks flagged
				    // with ⚠ below are best-guess defaults — confirm with Jessica, then prune.
				    Kept = Table.SelectColumns(
				        BIQL_TbSF_Case,
				        {
				            // --- existing KPI columns ---
				            "CaseNumber", "Date_of_Occurance__c", "CreatedDate",
				            "Level_1__c", "Level_2__c", "Region__c", "Location__c",
				            "Complaint_Valid__c", "RecordTypeId", "LotSKey",
				            "Product_Code__c", "Champion__c",
				            // --- case detail (readable) ---
				            "Status", "Subject", "Description",
				            "Responsible_Department__c",
				            "Root_Cause_Detail_1__c", "Root_Cause_Detail_2__c",
				            "Root_Cause_Description__c", "Preventive_Action__c",
				            "Lot_Number__c",                                    // readable lot (LotSKey is just the surrogate)
				            // --- customer / qty / UOM ---
				            "Address Name", "Customer_Code__c",                 // ⚠ "Customer": Address Name = readable name; also Sold_To_Customer_Code__c / Ship_To_Customer_Code__c if she means sold-to/ship-to
				            "Account_Segmentation__c",                          // customer segmentation
				            "Quantity_Impacted__c", "Quantity_Delivered__c",   // ⚠ two qty fields — Jessica picks which is "Quantity"
				            "UOM__c"
				            // Product_ID / Champion_ID are raw SF IDs — resolved to names by the joins at the end of this query.
				        }
				    ),
				    Renamed = Table.RenameColumns(
				        Kept,
				        {
				            {"Date_of_Occurance__c", "Date_of_Occurrence"},   // raw SF field name is misspelled ("Occurance")
				            {"Level_1__c", "Level_1"},
				            {"Level_2__c", "Level_2"},
				            {"Region__c", "Region"},
				            {"Location__c", "Location"},
				            {"Complaint_Valid__c", "Complaint_Valid"},
				            {"Product_Code__c", "Product_ID"},
				            {"Champion__c", "Champion_ID"},
				            {"Status", "Case_Status"},
				            {"Responsible_Department__c", "Responsible_Department"},
				            {"Root_Cause_Detail_1__c", "Root_Cause_Detail_1"},   // ⚠ no dedicated "Root Cause Type" col — Detail_1 is the closest; confirm mapping
				            {"Root_Cause_Detail_2__c", "Root_Cause_Detail_2"},
				            {"Root_Cause_Description__c", "Root_Cause_Description"},
				            {"Preventive_Action__c", "Preventive_Action"},
				            {"Lot_Number__c", "Lot_Number"},
				            {"Address Name", "Customer"},
				            {"Customer_Code__c", "Customer_Code"},
				            {"Account_Segmentation__c", "Customer_Segmentation"},
				            {"Quantity_Impacted__c", "Quantity_Impacted"},
				            {"Quantity_Delivered__c", "Quantity_Delivered"},
				            {"UOM__c", "UOM"}
				        }
				    ),
				    Typed = Table.TransformColumnTypes(
				        Renamed,
				        {
				            {"Date_of_Occurrence", type date},
				            {"CreatedDate", type datetime}
				        },
				        "en-US"
				    ),
				    OdsSource    = Sql.Databases("ODSDEV"),
				    ODS_SF       = OdsSource{[Name = "ODS_SalesForce"]}[Data],
				    Product2Dim  = Table.SelectColumns(
				        ODS_SF{[Schema = "dbo", Item = "Product2"]}[Data], {"Id", "Name", "ProductCode"}),
				    UserDim      = Table.SelectColumns(
				        ODS_SF{[Schema = "dbo", Item = "User"]}[Data], {"Id", "Name"}),
				    JoinProduct  = Table.NestedJoin(
				        Typed, {"Product_ID"}, Product2Dim, {"Id"}, "Product2Join", JoinKind.LeftOuter),
				    AddProduct   = Table.ExpandTableColumn(
				        JoinProduct, "Product2Join", {"Name", "ProductCode"}, {"Product_Name", "Product_Code"}),
				    JoinChampion = Table.NestedJoin(
				        AddProduct, {"Champion_ID"}, UserDim, {"Id"}, "UserJoin", JoinKind.LeftOuter),
				    AddChampion  = Table.ExpandTableColumn(
				        JoinChampion, "UserJoin", {"Name"}, {"Champion_Name"})
				in
				    AddChampion

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

