	column 'Revision Reasons' =
			
			VAR RelevantRows =
			    FILTER (
			        RELATEDTABLE ( FactScheduleChange ),
			        FactScheduleChange[Is OTIF Relevant] = TRUE()
			            && NOT ISBLANK ( FactScheduleChange[RevisionReason] )
			    )
			VAR ReasonSummary =
			    GROUPBY (
			        RelevantRows,
			        FactScheduleChange[RevisionReason],
			        "TotalDaysMoved",
			            SUMX ( CURRENTGROUP (), FactScheduleChange[Days Moved .] )
			    )
			RETURN
			    CONCATENATEX (
			        ReasonSummary,
			        FactScheduleChange[RevisionReason]
			            & " ("
			            & [TotalDaysMoved]
			            & " Days)",
			        ", ",
			        FactScheduleChange[RevisionReason],
			        ASC
			    )
		lineageTag: f29352e6-d5fe-4ec2-9911-c99a78eb2c14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Shipped as Requested' = IF('FactSalesDetail'[Actual Ship Date]<='FactSalesDetail'[Requested Date],1,0)
		formatString: 0
		lineageTag: f331e23a-59e2-4227-93f3-8d344962ff65
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// As-reported twin of [Relevant Revision Count]: counts OTIF-relevant revisions using the original JDE reason codes, ignoring user overwrites/excludes from the Revision Log Editor.
	column 'Relevant Revision Count (As Reported)' = VAR c = COUNTROWS ( FILTER ( RELATEDTABLE ( FactScheduleChange ), FactScheduleChange[Is OTIF Relevant (As Reported)] = TRUE() ) ) RETURN IF ( ISBLANK ( c ), 0, c )
		dataType: int64
		formatString: 0
		lineageTag: 474232eb-f196-477f-865f-48bace89b854
		summarizeBy: sum

	/// As-reported twin of [On Time]: uses the original JDE reason codes, ignoring user overwrites/excludes from the Revision Log Editor.
	column 'On Time (As Reported)' = IF(CALCULATE(COUNTROWS(FactScheduleChange),FactScheduleChange[Is OTIF Relevant (As Reported)]=true)>0,0,1)
		dataType: int64
		formatString: 0
		lineageTag: eec51f0a-c39b-4ca4-acce-d7d0a2d315ef
		summarizeBy: sum

	column 'Customer Segmentation' = RELATED('Sold-To'[Customer Segmentation])
		lineageTag: 63f510e7-177c-4a26-82b2-73e61b978238
