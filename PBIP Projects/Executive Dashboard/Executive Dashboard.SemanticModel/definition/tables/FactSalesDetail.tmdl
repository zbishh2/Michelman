	column OrderKey = ```
			
			    'FactSalesDetail'[Order Company] & "|"
			    & FORMAT('FactSalesDetail'[Order Num],"0") & "|"
			    & 'FactSalesDetail'[Order Type] & "|"
			    & 'FactSalesDetail'[Order Suffix] & "|"
			    & FORMAT('FactSalesDetail'[Line Num],"0")
			```
		lineageTag: 0da1872a-abce-4605-a10e-5966c5b075bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Count of all promised-date revisions (FactScheduleChange rows) for this order line, any reason code. Relevant-reason filtering still TODO pending Ivan's mapping.
	column 'Revision Count' = VAR c = COUNTROWS ( RELATEDTABLE ( FactScheduleChange ) ) RETURN IF ( ISBLANK ( c ), 0, c )
		dataType: int64
		formatString: 0
		lineageTag: 8c7b0fb3-a328-4648-bb49-f895388eddfd
		summarizeBy: sum

	/// Net signed days the promised date moved across all revisions for this line (negative = pulled earlier).
	column 'Net Days Moved' = VAR s = SUMX ( RELATEDTABLE ( FactScheduleChange ), FactScheduleChange[DaysMoved] ) RETURN IF ( ISBLANK ( s ), 0, s )
		dataType: int64
		formatString: 0
		lineageTag: 92d40e6f-50e3-470f-8137-84c522f26beb
		summarizeBy: sum

	/// Count of OTIF-relevant promised-date revisions for this line. >0 => OTIF miss (late). Drives the new OTIF measures.
	column 'Relevant Revision Count' = VAR c = COUNTROWS ( FILTER ( RELATEDTABLE ( FactScheduleChange ), FactScheduleChange[Is OTIF Relevant] = TRUE() ) ) RETURN IF ( ISBLANK ( c ), 0, c )
		dataType: int64
		formatString: 0
		lineageTag: 0c81a0de-098d-49ba-84ba-3d1deb3d7bf0
		summarizeBy: sum

	/// Net signed days the promised date moved across OTIF-relevant revisions only. Used for days-late buckets.
	column 'Relevant Net Days Moved' = VAR s = SUMX ( FILTER ( RELATEDTABLE ( FactScheduleChange ), FactScheduleChange[Is OTIF Relevant] = TRUE() ), FactScheduleChange[DaysMoved] ) RETURN IF ( ISBLANK ( s ), 0, s )
		dataType: int64
		formatString: 0.0
		lineageTag: 5fb12988-932b-4b64-a1fe-b35770086e36
		summarizeBy: sum

	column 'Target Line' = .99
		formatString: 0%;-0%;0%
		lineageTag: d4a25b86-bf5a-4977-8c73-201cebdac45c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'month year' = MONTH('FactSalesDetail'[Actual Ship Date]) & YEAR('FactSalesDetail'[Actual Ship Date])
