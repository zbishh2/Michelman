	column Region =
			SWITCH (
			    VALUE ( 'FactSalesDetail'[Order Company] ),
			    10, "Americas",
			    20, "EMEA",
			    30, "Asia",
			    34, "Asia",
			    35, "Asia",
			    "Unmapped"
