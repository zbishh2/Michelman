	partition DateTable = calculated
		mode: import
		source = ```
				
				  VAR MinDate = MIN ( MINX ('FactSalesDetail','FactSalesDetail'[GL Date] ), MINX ( Complaints, Complaints[Date_of_Occurrence] ) )
				  VAR MaxDate = MAX ( MAXX ( 'FactSalesDetail','FactSalesDetail'[GL Date] ), MAXX ( Complaints, Complaints[Date_of_Occurrence] ) )
				  RETURN
				  ADDCOLUMNS (
				      CALENDAR ( DATE ( YEAR ( MinDate ), 1, 1 ), DATE ( YEAR ( MaxDate ), 12, 31 ) ),
				      "Year", YEAR ( [Date] ),
				      "Month No", MONTH ( [Date] ),
				      "Month", FORMAT ( [Date], "mmm" ),
				      "Year-Month", FORMAT ( [Date], "MMM-YY" ),
				      "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				      "Year-Quarter", FORMAT ( [Date], "yyyy" ) & " Q" & FORMAT ( [Date], "Q" )
				  )
				```

	annotation PBI_Id = 9399b01b667945bba6864a01fd1f05af

