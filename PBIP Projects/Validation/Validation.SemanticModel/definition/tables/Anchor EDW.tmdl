/// Anchor holding the EDWPROD/EDW gateway binding. Returns one row. Never delete.
table 'Anchor EDW'
	lineageTag: 7a11da70-0000-4000-8000-000000000012

	column ok
		dataType: int64
		formatString: 0
		lineageTag: 7a11da70-0000-4000-8000-000000000012-c1
		summarizeBy: none
		sourceColumn: ok

		annotation SummarizationSetBy = Automatic

	partition 'Anchor EDW' = m
		mode: import
		source =
				let
				    Source = Sql.Database("EDWPROD", "EDW"),
				    Data = Value.NativeQuery(
				        Source,
				        "SET NOCOUNT ON; SELECT 1 AS ok",
				        null,
				        [EnableFolding = false]
				    )
				in
				    Data

