/// Anchor holding the SSASPROD/BIQLTabular gateway binding. Returns one row. Never delete.
table 'Anchor SSAS'
	lineageTag: 7a11da70-0000-4000-8000-000000000011

	column ok
		dataType: int64
		formatString: 0
		lineageTag: 7a11da70-0000-4000-8000-000000000011-c1
		summarizeBy: none
		sourceColumn: ok

		annotation SummarizationSetBy = Automatic

	partition 'Anchor SSAS' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [ Query = "EVALUATE ROW ( ""ok"", 1 )" ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

