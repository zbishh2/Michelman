	partition Sales = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				VAR PullRows =
				    FILTER (
				        'Sales',
				        'Sales'[Order Date] >= TODAY () - 1095
				            || 'Sales'[Promised Shipment Date] >= TODAY () - 1095
				            || 'Sales'[GL Date] >= TODAY () - 1095
				    )
				RETURN
				    SELECTCOLUMNS (
				        PullRows,
				        ""ItemBranchSKey"", 'Sales'[ItemBranchSKey],
				        ""BranchSKey"", 'Sales'[BranchSKey],
				        ""ShipToCustomerSKey"", 'Sales'[ShipToCustomerSKey],
				        ""SoldToCustomerSKey"", 'Sales'[SoldToCustomerSKey],
				        ""ParentCustomerSKey"", 'Sales'[ParentCustomerSKey],
				        ""BillToCustomerSKey"", 'Sales'[BillToCustomerSKey],
				        ""TerritoryManagerSKey"", 'Sales'[TerritoryManagerSKey],
				        ""BusinessUnitHeaderSKey"", 'Sales'[BusinessUnitHeaderSKey],
				        ""AddressNum"", 'Sales'[AddressNum],
				        ""AddressNumBillTo"", 'Sales'[AddressNumBillTo],
				        ""Order Company"", 'Sales'[Order Company],
				        ""Order Num"", 'Sales'[Order Num],
				        ""Order Suffix"", 'Sales'[Order Suffix],
				        ""Order Type"", 'Sales'[Order Type],
				        ""Order Type Desc"", 'Sales'[Order Type Desc],
				        ""Line Num"", 'Sales'[Line Num],
				        ""Line Type"", 'Sales'[Line Type],
				        ""Document Num"", 'Sales'[Document Num],
				        ""Document Type"", 'Sales'[Document Type],
				        ""Original Order Num"", 'Sales'[Original Order Num],
				        ""Shipment Num"", 'Sales'[Shipment Num],
				        ""Record Type"", 'Sales'[Record Type],
				        ""Sales Table Source"", 'Sales'[Sales Table Source],
				        ""Item Num 2nd"", 'Sales'[Item Num 2nd],
				        ""Description 1"", 'Sales'[Description 1],
				        ""Description 2"", 'Sales'[Description 2],
				        ""Status Code Last"", 'Sales'[Status Code Last],
				        ""Status Code Last Desc"", 'Sales'[Status Code Last Desc],
				        ""Status Code Next"", 'Sales'[Status Code Next],
				        ""Status Code Next Desc"", 'Sales'[Status Code Next Desc],
				        ""Open Order Flag"", 'Sales'[Open Order Flag],
				        ""Actuals vs Open"", 'Sales'[Actuals vs Open],
				        ""Cancelled_Flag"", 'Sales'[Cancelled_Flag],
				        ""Hold Orders Code"", 'Sales'[Hold Orders Code],
				        ""Filter - Active Order Types"", 'Sales'[Filter - Active Order Types],
				        ""Order Exclude"", 'Sales'[Order Exclude],
				        ""Reason Code"", 'Sales'[Reason Code],
				        ""Reason Code Desc"", 'Sales'[Reason Code Desc],
				        ""Revision Reason Code"", 'Sales'[Revision Reason Code],
				        ""Revision Reason"", 'Sales'[Revision Reason],
				        ""Order Date"", 'Sales'[Order Date],
				        ""GL Date"", 'Sales'[GL Date],
				        ""Invoice Date"", 'Sales'[Invoice Date],
				        ""Actual Ship Date"", 'Sales'[Actual Ship Date],
				        ""Promised Shipment Date"", 'Sales'[Promised Shipment Date],
				        ""Promised Delivery Date"", 'Sales'[Promised Delivery Date],
				        ""Original Promised Delivery Date"", 'Sales'[Original Promised Delivery Date],
				        ""Requested Date"", 'Sales'[Requested Date],
				        ""Scheduled Pick Date"", 'Sales'[Scheduled Pick Date],
				        ""Updated Date"", 'Sales'[Updated Date],
				        ""BusinessUnit"", 'Sales'[BusinessUnit],
				        ""QuantityOrdered"", 'Sales'[QuantityOrdered],
				        ""QuantityShipped"", 'Sales'[QuantityShipped],
				        ""QuantityBackordered"", 'Sales'[QuantityBackordered],
				        ""QuantityCanceledScrapped"", 'Sales'[QuantityCanceledScrapped],
				        ""QuantityOrderedPrimaryUOM"", 'Sales'[QuantityOrderedPrimaryUOM],
				        ""ConversionFactorKG"", 'Sales'[ConversionFactorKG],
				        ""ConversionFactorLB"", 'Sales'[ConversionFactorLB],
				        ""ConversionFactorPrimaryKG"", 'Sales'[ConversionFactorPrimaryKG],
				        ""ConversionFactorPrimaryLB"", 'Sales'[ConversionFactorPrimaryLB],
				        ""ConversionFactorWeightKG"", 'Sales'[ConversionFactorWeightKG],
				        ""ConversionFactorWeightLB"", 'Sales'[ConversionFactorWeightLB],
				        ""ConversionFactorUSD"", 'Sales'[ConversionFactorUSD],
				        ""ConversionFactorEUR"", 'Sales'[ConversionFactorEUR],
				        ""ConversionFactorLC"", 'Sales'[ConversionFactorLC],
				        ""UOM"", 'Sales'[UOM],
				        ""UOM Primary"", 'Sales'[UOM Primary],
				        ""UOM Weight"", 'Sales'[UOM Weight],
				        ""UnitWeight"", 'Sales'[UnitWeight],
				        ""AmountExtendedPrice"", 'Sales'[AmountExtendedPrice],
				        ""AmountExtendedCost"", 'Sales'[AmountExtendedCost],
				        ""AmountExtendedPriceNet"", 'Sales'[AmountExtendedPriceNet],
				        ""AmountOrderNet"", 'Sales'[AmountOrderNet],
				        ""AmountExtendedPriceUSD"", 'Sales'[AmountExtendedPriceUSD],
				        ""AmountExtendedCostUSD"", 'Sales'[AmountExtendedCostUSD],
				        ""AmountOrderNetUSD"", 'Sales'[AmountOrderNetUSD],
				        ""Open Amount"", 'Sales'[Open Amount],
				        ""Amount Unit Price"", 'Sales'[Amount Unit Price],
				        ""BackOrderedExtendedAmount"", 'Sales'[BackOrderedExtendedAmount],
				        ""BackOrderedExtendedCost"", 'Sales'[BackOrderedExtendedCost],
				        ""Exchange Rate USD"", 'Sales'[Exchange Rate USD],
				        ""Exchange Rate EUR"", 'Sales'[Exchange Rate EUR],
				        ""LocalCurrency"", 'Sales'[LocalCurrency],
				        ""Currency Code Base"", 'Sales'[Currency Code Base],
				        ""Currency Code From"", 'Sales'[Currency Code From],
				        ""Currency Mode"", 'Sales'[Currency Mode],
				        ""Make Site"", 'Sales'[Make Site],
				        ""Ship Site"", 'Sales'[Ship Site],
				        ""SalesforceOpportunityID"", 'Sales'[SalesforceOpportunityID],
				        ""Carrier Num"", 'Sales'[Carrier Num],
				        ""Carrier Name"", 'Sales'[Carrier Name],
				        ""Freight Handling Code"", 'Sales'[Freight Handling Code],
				        ""Mode Of Transport"", 'Sales'[Mode Of Transport],
				        ""TM Sales Rep Type"", 'Sales'[TM Sales Rep Type]
				    )
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

