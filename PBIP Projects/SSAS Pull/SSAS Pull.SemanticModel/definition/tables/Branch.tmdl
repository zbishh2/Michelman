		annotation SummarizationSetBy = Automatic

	column 'Branch Plant'
		dataType: string
		lineageTag: a5090000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	column 'Branch Plant Desc'
		dataType: string
		lineageTag: a5090000-0000-4000-8000-000000000004
		summarizeBy: none
		sourceColumn: Branch Plant Desc

		annotation SummarizationSetBy = Automatic

	column 'Branch Plant and Desc'
		dataType: string
		lineageTag: a5090000-0000-4000-8000-000000000005
		summarizeBy: none
		sourceColumn: Branch Plant and Desc

		annotation SummarizationSetBy = Automatic

	column 'Branch Plant Type'
		dataType: string
