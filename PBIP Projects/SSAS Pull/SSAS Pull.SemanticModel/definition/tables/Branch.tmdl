	partition Branch = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Branch',
				        ""BranchSKey"", 'Branch'[BranchSKey],
				        ""CompanySKey"", 'Branch'[CompanySKey],
				        ""Branch Plant"", 'Branch'[Branch Plant],
				        ""Branch Plant Desc"", 'Branch'[Branch Plant Desc],
				        ""Branch Plant and Desc"", 'Branch'[Branch Plant and Desc],
				        ""Branch Plant Type"", 'Branch'[Branch Plant Type],
				        ""Branch Plant Type Desc"", 'Branch'[Branch Plant Type Desc],
				        ""Branch Parent"", 'Branch'[Branch Parent],
				        ""Branch Type"", 'Branch'[Branch Type]
				)
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

