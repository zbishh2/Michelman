table Branch
	lineageTag: a5090000-0000-4000-8000-0000000000a1

	column BranchSKey
		dataType: int64
		lineageTag: a5090000-0000-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: BranchSKey

		annotation SummarizationSetBy = Automatic

	column CompanySKey
		dataType: int64
		lineageTag: a5090000-0000-4000-8000-000000000002
		summarizeBy: none
