	partition 'Item Branch' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Item Branch',
				        ""ItemBranchSKey"", 'Item Branch'[ItemBranchSKey],
				        ""ItemSKey"", 'Item Branch'[ItemSKey],
				        ""Business Unit"", 'Item Branch'[Business Unit],
				        ""Item Num Short"", 'Item Branch'[Item Num Short],
				        ""Item Num 2nd"", 'Item Branch'[Item Num 2nd],
				        ""Item Num 2nd Desc"", 'Item Branch'[Item Num 2nd Desc],
				        ""Item Num 2nd and Desc"", 'Item Branch'[Item Num 2nd and Desc],
				        ""Item Num 3rd"", 'Item Branch'[Item Num 3rd],
				        ""Item Bulk"", 'Item Branch'[Item Bulk],
				        ""Item Global Bulk"", 'Item Branch'[Item Global Bulk],
				        ""Item Num Bulk"", 'Item Branch'[Item Num Bulk],
				        ""Item Num Global Bulk"", 'Item Branch'[Item Num Global Bulk],
				        ""Global Bulk Filter"", 'Item Branch'[Global Bulk Filter],
				        ""Master Planning Family"", 'Item Branch'[Master Planning Family],
				        ""Master Planning Family Desc"", 'Item Branch'[Master Planning Family Desc],
				        ""Stocking Type"", 'Item Branch'[Stocking Type],
				        ""Stocking Type Desc"", 'Item Branch'[Stocking Type Desc],
				        ""Line Type"", 'Item Branch'[Line Type],
				        ""UOM Primary"", 'Item Branch'[UOM Primary],
				        ""UOM Pricing"", 'Item Branch'[UOM Pricing],
				        ""UOM Shipping"", 'Item Branch'[UOM Shipping],
				        ""Item Price Group"", 'Item Branch'[Item Price Group],
				        ""Item Price Group Desc"", 'Item Branch'[Item Price Group Desc],
				        ""Planner Num"", 'Item Branch'[Planner Num],
				        ""Planner Name"", 'Item Branch'[Planner Name],
				        ""Buyer Name"", 'Item Branch'[Buyer Name],
				        ""Branch Supplier Num"", 'Item Branch'[Branch Supplier Num],
				        ""Branch Supplier Name"", 'Item Branch'[Branch Supplier Name],
				        ""SafetyStock"", 'Item Branch'[SafetyStock],
				        ""Safety Stock SAFE"", 'Item Branch'[Safety Stock SAFE],
				        ""ReorderPoint"", 'Item Branch'[ReorderPoint],
				        ""ReorderQuantity"", 'Item Branch'[ReorderQuantity],
				        ""ReorderQuantityMinimum"", 'Item Branch'[ReorderQuantityMinimum],
				        ""ReorderQuantityMaximum"", 'Item Branch'[ReorderQuantityMaximum],
				        ""Qty Order Multiple"", 'Item Branch'[Qty Order Multiple],
				        ""Lead Time MFG_BP"", 'Item Branch'[Lead Time MFG_BP],
				        ""Shelf Life Days"", 'Item Branch'[Shelf Life Days],
				        ""Active Flag Status"", 'Item Branch'[Active Flag Status],
				        ""Sales Reporting Code 01"", 'Item Branch'[Sales Reporting Code 01],
				        ""Sales Reporting Code 01 Desc"", 'Item Branch'[Sales Reporting Code 01 Desc]
				)
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

