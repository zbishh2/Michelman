	partition Address = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Address',
				        ""AddressSKey"", 'Address'[AddressSKey],
				        ""Address Num"", 'Address'[Address Num],
				        ""Address Name"", 'Address'[Address Name],
				        ""Address and Name"", 'Address'[Address and Name],
				        ""Search Type"", 'Address'[Search Type],
				        ""Search Type Desc"", 'Address'[Search Type Desc],
				        ""Sales Business Unit"", 'Address'[Sales Business Unit],
				        ""Sales Business Unit Desc"", 'Address'[Sales Business Unit Desc],
				        ""Customer Segmentation"", 'Address'[Customer Segmentation],
				        ""Customer Segmentation Desc"", 'Address'[Customer Segmentation Desc],
				        ""Country Desc"", 'Address'[Country Desc],
				        ""State Desc"", 'Address'[State Desc],
				        ""CustomerYN"", 'Address'[CustomerYN],
				        ""SupplierYN"", 'Address'[SupplierYN]
				)
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

