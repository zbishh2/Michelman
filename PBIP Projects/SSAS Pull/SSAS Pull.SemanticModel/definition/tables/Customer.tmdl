	partition Customer = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Customer',
				        ""CustomerSKey"", 'Customer'[CustomerSKey],
				        ""AddressSKey"", 'Customer'[AddressSKey],
				        ""Customer Sold To Num"", 'Customer'[Customer Sold To Num],
				        ""Customer Sold To Name"", 'Customer'[Customer Sold To Name],
				        ""Customer Sold To and Name"", 'Customer'[Customer Sold To and Name],
				        ""Global Parent Num"", 'Customer'[Global Parent Num],
				        ""Global Parent Name"", 'Customer'[Global Parent Name],
				        ""Global Parent and Name"", 'Customer'[Global Parent and Name],
				        ""Related Sold to"", 'Customer'[Related Sold to],
				        ""Address Num Parent"", 'Customer'[Address Num Parent],
				        ""Address Num 4th"", 'Customer'[Address Num 4th],
				        ""Customer Segmentation"", 'Customer'[Customer Segmentation],
				        ""Customer Segmentation Desc"", 'Customer'[Customer Segmentation Desc],
				        ""Sales Business Unit"", 'Customer'[Sales Business Unit],
				        ""Sales Business Unit Desc"", 'Customer'[Sales Business Unit Desc],
				        ""Country"", 'Customer'[Country],
				        ""Country Desc"", 'Customer'[Country Desc],
				        ""State"", 'Customer'[State],
				        ""State Desc"", 'Customer'[State Desc],
				        ""City"", 'Customer'[City],
				        ""Type of Customer Desc"", 'Customer'[Type of Customer Desc],
				        ""Industry Group Desc"", 'Customer'[Industry Group Desc],
				        ""Region"", 'Customer'[Region],
				        ""Customer Status Desc"", 'Customer'[Customer Status Desc],
				        ""Business Group Description"", 'Customer'[Business Group Description]
				)
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

