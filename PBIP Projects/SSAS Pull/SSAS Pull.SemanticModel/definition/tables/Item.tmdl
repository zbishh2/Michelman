	partition Item = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Item',
				        ""ItemSKey"", 'Item'[ItemSKey],
				        ""ItemNumShort"", 'Item'[ItemNumShort],
				        ""ItemNum2nd"", 'Item'[ItemNum2nd],
				        ""ItemNum3rd"", 'Item'[ItemNum3rd],
				        ""ItemDesc01"", 'Item'[ItemDesc01],
				        ""ItemDesc02"", 'Item'[ItemDesc02],
				        ""StockingType"", 'Item'[StockingType],
				        ""StockingTypeDesc"", 'Item'[StockingTypeDesc],
				        ""MasterPlanningFamily"", 'Item'[MasterPlanningFamily],
				        ""MasterPlanningFamilyDesc"", 'Item'[MasterPlanningFamilyDesc],
				        ""ProductGroup"", 'Item'[ProductGroup],
				        ""ProductGroupDesc"", 'Item'[ProductGroupDesc],
				        ""ItemPriceGroup"", 'Item'[ItemPriceGroup],
				        ""ItemPriceGroupDesc"", 'Item'[ItemPriceGroupDesc],
				        ""CommodityClassCodes"", 'Item'[CommodityClassCodes],
				        ""CommodityClassCodesDesc"", 'Item'[CommodityClassCodesDesc],
				        ""CommoditySubClassCodes"", 'Item'[CommoditySubClassCodes],
				        ""CommoditySubClassCodesDesc"", 'Item'[CommoditySubClassCodesDesc],
				        ""SalesCatalogSections"", 'Item'[SalesCatalogSections],
				        ""SalesCatalogSectionsDesc"", 'Item'[SalesCatalogSectionsDesc],
				        ""SalesCatalogSubsections"", 'Item'[SalesCatalogSubsections],
				        ""SalesCatalogSubsectionsDesc"", 'Item'[SalesCatalogSubsectionsDesc],
				        ""SalesReportingCode03"", 'Item'[SalesReportingCode03],
				        ""SalesReportingCode03Desc"", 'Item'[SalesReportingCode03Desc],
				        ""SalesReportingCode04"", 'Item'[SalesReportingCode04],
				        ""SalesReportingCode04Desc"", 'Item'[SalesReportingCode04Desc],
				        ""ItemCategoryCode06"", 'Item'[ItemCategoryCode06],
				        ""ItemCategoryCode06Desc"", 'Item'[ItemCategoryCode06Desc],
				        ""ItemCategoryCode08"", 'Item'[ItemCategoryCode08],
				        ""ItemCategoryCode08Desc"", 'Item'[ItemCategoryCode08Desc],
				        ""ItemCategoryCode09"", 'Item'[ItemCategoryCode09],
				        ""ItemCategoryCode09Desc"", 'Item'[ItemCategoryCode09Desc],
				        ""ItemCategoryCode10"", 'Item'[ItemCategoryCode10],
				        ""ItemCategoryCode10Desc"", 'Item'[ItemCategoryCode10Desc],
				        ""CommercializationYear"", 'Item'[CommercializationYear],
				        ""CommercializationYearDesc"", 'Item'[CommercializationYearDesc],
				        ""LineType"", 'Item'[LineType],
				        ""ItemBulk"", 'Item'[ItemBulk],
				        ""ItemGlobalBulk"", 'Item'[ItemGlobalBulk],
				        ""UOMPrimary"", 'Item'[UOMPrimary],
				        ""UOMPricing"", 'Item'[UOMPricing],
				        ""UOMPurchasing"", 'Item'[UOMPurchasing],
				        ""UOMSecondary"", 'Item'[UOMSecondary],
				        ""UOMShipping"", 'Item'[UOMShipping],
				        ""UOMWeight"", 'Item'[UOMWeight],
				        ""UOMVolume"", 'Item'[UOMVolume],
				        ""HazardClass"", 'Item'[HazardClass],
				        ""HarmonizedShippingCode"", 'Item'[HarmonizedShippingCode],
				        ""UNNANum"", 'Item'[UNNANum],
				        ""PlanningCode"", 'Item'[PlanningCode],
				        ""OrderPolicyCode"", 'Item'[OrderPolicyCode],
				        ""LeadtimeLevel"", 'Item'[LeadtimeLevel],
				        ""DaysShelfLifeDays"", 'Item'[DaysShelfLifeDays],
				        ""BestBeforeDefaultDays"", 'Item'[BestBeforeDefaultDays],
				        ""SellByDefaultDays"", 'Item'[SellByDefaultDays],
				        ""LevelInventoryCost"", 'Item'[LevelInventoryCost],
				        ""UniqueFormulaIdentifier"", 'Item'[UniqueFormulaIdentifier],
				        ""DWIsCurrent"", 'Item'[DWIsCurrent]
				)
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

