	partition 'Purchase Order Receiver' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				VAR PullRows =
				    FILTER (
				        'Purchase Order Receiver',
				        'Purchase Order Receiver'[Received Date] >= TODAY () - 1095
				            || 'Purchase Order Receiver'[GL Date] >= TODAY () - 1095
				    )
				RETURN
				    SELECTCOLUMNS (
				        PullRows,
				        ""SupplierSKey"", 'Purchase Order Receiver'[SupplierSKey],
				        ""ItemBranchSKey"", 'Purchase Order Receiver'[ItemBranchSKey],
				        ""BranchSKey"", 'Purchase Order Receiver'[BranchSKey],
				        ""Address Num PO"", 'Purchase Order Receiver'[Address Num PO],
				        ""PurchaseOrderSKey"", 'Purchase Order Receiver'[PurchaseOrderSKey],
				        ""Order Company"", 'Purchase Order Receiver'[Order Company],
				        ""Order Num"", 'Purchase Order Receiver'[Order Num],
				        ""Order Suffix"", 'Purchase Order Receiver'[Order Suffix],
				        ""Order Type"", 'Purchase Order Receiver'[Order Type],
				        ""Line Num"", 'Purchase Order Receiver'[Line Num],
				        ""Line Type"", 'Purchase Order Receiver'[Line Type],
				        ""Match Record Type"", 'Purchase Order Receiver'[Match Record Type],
				        ""Document Num"", 'Purchase Order Receiver'[Document Num],
				        ""Document Type"", 'Purchase Order Receiver'[Document Type],
				        ""Document Company"", 'Purchase Order Receiver'[Document Company],
				        ""Status Code Last"", 'Purchase Order Receiver'[Status Code Last],
				        ""Status Code Next"", 'Purchase Order Receiver'[Status Code Next],
				        ""Supplier Invoice Num"", 'Purchase Order Receiver'[Supplier Invoice Num],
				        ""Location"", 'Purchase Order Receiver'[Location],
				        ""Description 1"", 'Purchase Order Receiver'[Description 1],
				        ""GL Date"", 'Purchase Order Receiver'[GL Date],
				        ""Order Date"", 'Purchase Order Receiver'[Order Date],
				        ""Received Date"", 'Purchase Order Receiver'[Received Date],
				        ""Received Date Line"", 'Purchase Order Receiver'[Received Date Line],
				        ""Transaction Date"", 'Purchase Order Receiver'[Transaction Date],
				        ""Requested Date"", 'Purchase Order Receiver'[Requested Date],
				        ""Original Promised Delivery Date"", 'Purchase Order Receiver'[Original Promised Delivery Date],
				        ""QuantityOrdered"", 'Purchase Order Receiver'[QuantityOrdered],
				        ""QuantityReceived"", 'Purchase Order Receiver'[QuantityReceived],
				        ""QuantityOpen"", 'Purchase Order Receiver'[QuantityOpen],
				        ""QuantityReturned"", 'Purchase Order Receiver'[QuantityReturned],
				        ""QuantityRejected"", 'Purchase Order Receiver'[QuantityRejected],
				        ""QuantityScrapped"", 'Purchase Order Receiver'[QuantityScrapped],
				        ""QuantityStocked"", 'Purchase Order Receiver'[QuantityStocked],
				        ""QuantityClosed"", 'Purchase Order Receiver'[QuantityClosed],
				        ""AmountExtendedCost"", 'Purchase Order Receiver'[AmountExtendedCost],
				        ""AmountReceived"", 'Purchase Order Receiver'[AmountReceived],
				        ""AmountOpen"", 'Purchase Order Receiver'[AmountOpen],
				        ""AmountUnitCost"", 'Purchase Order Receiver'[AmountUnitCost],
				        ""AmountPaidtoDate"", 'Purchase Order Receiver'[AmountPaidtoDate],
				        ""ConversionFactorKG"", 'Purchase Order Receiver'[ConversionFactorKG],
				        ""ConversionFactorLB"", 'Purchase Order Receiver'[ConversionFactorLB],
				        ""USDRate"", 'Purchase Order Receiver'[USDRate],
				        ""EURRate"", 'Purchase Order Receiver'[EURRate],
				        ""Currency Code Base"", 'Purchase Order Receiver'[Currency Code Base],
				        ""Currency Code From"", 'Purchase Order Receiver'[Currency Code From],
				        ""UOM Transaction"", 'Purchase Order Receiver'[UOM Transaction],
				        ""UOM Primary"", 'Purchase Order Receiver'[UOM Primary],
				        ""OnTimeFlag"", 'Purchase Order Receiver'[OnTimeFlag],
				        ""InFullFlag"", 'Purchase Order Receiver'[InFullFlag],
				        ""OnTimeInFullFlag"", 'Purchase Order Receiver'[OnTimeInFullFlag],
				        ""LateFlag"", 'Purchase Order Receiver'[LateFlag],
				        ""Days Off Target"", 'Purchase Order Receiver'[Days Off Target],
				        ""Delivery Status"", 'Purchase Order Receiver'[Delivery Status]
				    )
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

