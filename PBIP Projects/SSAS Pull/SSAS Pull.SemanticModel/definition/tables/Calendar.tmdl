	partition Calendar = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				VAR PullRows =
				    FILTER (
				        'Calendar',
				        'Calendar'[Calendar Date] >= DATE ( 2019, 1, 1 )
				            && 'Calendar'[Calendar Date] <= DATE ( 2030, 12, 31 )
				    )
				RETURN
				    SELECTCOLUMNS (
				        PullRows,
				        ""CalendarPattern"", 'Calendar'[CalendarPattern],
				        ""Calendar Date"", 'Calendar'[Calendar Date],
				        ""DateSKey"", 'Calendar'[DateSKey],
				        ""Year Num"", 'Calendar'[Year Num],
				        ""Quarter"", 'Calendar'[Quarter],
				        ""Year Quarter"", 'Calendar'[Year Quarter],
				        ""Period Num"", 'Calendar'[Period Num],
				        ""Year Period"", 'Calendar'[Year Period],
				        ""Period Desc Short"", 'Calendar'[Period Desc Short],
				        ""Calendar Month Num"", 'Calendar'[Calendar Month Num],
				        ""Calendar Month"", 'Calendar'[Calendar Month],
				        ""Calendar Month Short Desc"", 'Calendar'[Calendar Month Short Desc],
				        ""Week"", 'Calendar'[Week],
				        ""Calendar Day Num"", 'Calendar'[Calendar Day Num],
				        ""Period Begin Date"", 'Calendar'[Period Begin Date],
				        ""Period End Date"", 'Calendar'[Period End Date],
				        ""Relative Year"", 'Calendar'[Relative Year],
				        ""Relative Quarter"", 'Calendar'[Relative Quarter],
				        ""Relative Period"", 'Calendar'[Relative Period],
				        ""Relative Week"", 'Calendar'[Relative Week],
				        ""Relative Day"", 'Calendar'[Relative Day],
				        ""Holiday"", 'Calendar'[Holiday],
				        ""IsBusinessDay"", 'Calendar'[IsBusinessDay]
				    )
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

