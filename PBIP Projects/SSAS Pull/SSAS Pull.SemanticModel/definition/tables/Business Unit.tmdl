	partition 'Business Unit' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Business Unit',
				        ""BusinessUnitSKey"", 'Business Unit'[BusinessUnitSKey],
				        ""CompanySKey"", 'Business Unit'[CompanySKey],
				        ""Business Unit"", 'Business Unit'[Business Unit],
				        ""Business Unit Desc"", 'Business Unit'[Business Unit Desc],
				        ""Business Unit and Desc"", 'Business Unit'[Business Unit and Desc],
				        ""Business Unit Type"", 'Business Unit'[Business Unit Type],
				        ""Business Unit Type Desc"", 'Business Unit'[Business Unit Type Desc],
				        ""Business Unit Parent"", 'Business Unit'[Business Unit Parent],
				        ""Business Unit Parent Desc"", 'Business Unit'[Business Unit Parent Desc],
				        ""Division"", 'Business Unit'[Division],
				        ""Division Desc"", 'Business Unit'[Division Desc],
				        ""Region"", 'Business Unit'[Region],
				        ""Region Desc"", 'Business Unit'[Region Desc],
				        ""Grouping"", 'Business Unit'[Grouping],
				        ""Grouping Desc"", 'Business Unit'[Grouping Desc],
				        ""Territory"", 'Business Unit'[Territory],
				        ""Territory Desc"", 'Business Unit'[Territory Desc]
				)
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

