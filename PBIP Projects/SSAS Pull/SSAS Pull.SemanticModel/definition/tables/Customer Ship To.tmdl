	partition 'Customer Ship To' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Customer Ship To',
				        ""ShipToCustomerSKey"", 'Customer Ship To'[ShipToCustomerSKey],
				        ""AddressSKey"", 'Customer Ship To'[AddressSKey],
