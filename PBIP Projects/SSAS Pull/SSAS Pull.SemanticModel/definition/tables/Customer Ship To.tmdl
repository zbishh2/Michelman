				        ""Customer Segmentation Group"", 'Customer Ship To'[Customer Segmentation Group],
				        ""Customer Segmentation Strategic"", 'Customer Ship To'[Customer Segmentation Strategic],
				        ""Reporting Region"", 'Customer Ship To'[Reporting Region],
				        ""Reporting Region ANS"", 'Customer Ship To'[Reporting Region ANS],
				        ""Country"", 'Customer Ship To'[Country],
				        ""Country Desc"", 'Customer Ship To'[Country Desc],
				        ""State"", 'Customer Ship To'[State],
				        ""State Desc"", 'Customer Ship To'[State Desc],
				        ""City"", 'Customer Ship To'[City],
				        ""Type of Customer Desc"", 'Customer Ship To'[Type of Customer Desc],
				        ""Industry Group Desc"", 'Customer Ship To'[Industry Group Desc]
				)
				"
				        ]
				    ),
