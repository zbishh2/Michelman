	partition 'Territory Manager' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				SELECTCOLUMNS (
				    'Territory Manager',
				        ""TerritoryManagerSKey"", 'Territory Manager'[TerritoryManagerSKey],
				        ""Territory Manager Num"", 'Territory Manager'[Territory Manager Num],
				        ""Territory Manager"", 'Territory Manager'[Territory Manager],
				        ""Territory Manager and Name"", 'Territory Manager'[Territory Manager and Name],
				        ""TM Sales Rep Type"", 'Territory Manager'[TM Sales Rep Type],
				        ""CustomerCommissionTMSKey"", 'Territory Manager'[CustomerCommissionTMSKey],
				        ""Mailing Name"", 'Territory Manager'[Mailing Name],
				        ""TM Sales Rep Type TM1"", 'Territory Manager'[TM Sales Rep Type TM1]
				)
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

