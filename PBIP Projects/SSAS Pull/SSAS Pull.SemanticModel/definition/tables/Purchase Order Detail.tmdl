	partition 'Purchase Order Detail' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				VAR PullRows =
				    FILTER (
				        'Purchase Order Detail',
				        'Purchase Order Detail'[Order Date] >= TODAY () - 1095
				            || 'Purchase Order Detail'[GL Date] >= TODAY () - 1095
				            || 'Purchase Order Detail'[Received Date] >= TODAY () - 1095
				    )
				RETURN
				    SELECTCOLUMNS (
				        PullRows,
				        ""SupplierSKey"", 'Purchase Order Detail'[SupplierSKey],
				        ""ItemBranchSKey"", 'Purchase Order Detail'[ItemBranchSKey],
				        ""BranchSKey"", 'Purchase Order Detail'[BranchSKey],
				        ""AddressSKey"", 'Purchase Order Detail'[AddressSKey],
				        ""Address Num PO"", 'Purchase Order Detail'[Address Num PO],
				        ""Address Num Ship To"", 'Purchase Order Detail'[Address Num Ship To],
				        ""PurchaseOrderSKey"", 'Purchase Order Detail'[PurchaseOrderSKey],
				        ""Order Company"", 'Purchase Order Detail'[Order Company],
				        ""Order Num"", 'Purchase Order Detail'[Order Num],
				        ""Order Suffix"", 'Purchase Order Detail'[Order Suffix],
				        ""Order Type"", 'Purchase Order Detail'[Order Type],
				        ""Order Type Desc"", 'Purchase Order Detail'[Order Type Desc],
				        ""Line Num"", 'Purchase Order Detail'[Line Num],
				        ""Line Type"", 'Purchase Order Detail'[Line Type],
				        ""Original Order Num"", 'Purchase Order Detail'[Original Order Num],
				        ""Original Order Type"", 'Purchase Order Detail'[Original Order Type],
				        ""Related Order Num"", 'Purchase Order Detail'[Related Order Num],
				        ""Related Order Type"", 'Purchase Order Detail'[Related Order Type],
				        ""Status Code Last"", 'Purchase Order Detail'[Status Code Last],
				        ""Status Code Next"", 'Purchase Order Detail'[Status Code Next],
				        ""Hold Orders Code"", 'Purchase Order Detail'[Hold Orders Code],
				        ""Buyer Num"", 'Purchase Order Detail'[Buyer Num],
				        ""Buyer Name"", 'Purchase Order Detail'[Buyer Name],
				        ""Vendor Name"", 'Purchase Order Detail'[Vendor Name],
				        ""Transaction Originator"", 'Purchase Order Detail'[Transaction Originator],
				        ""Item Num_F4311"", 'Purchase Order Detail'[Item Num_F4311],
				        ""Business Unit"", 'Purchase Order Detail'[Business Unit],
				        ""Item Num Short"", 'Purchase Order Detail'[Item Num Short],
				        ""Location"", 'Purchase Order Detail'[Location],
				        ""Description 1"", 'Purchase Order Detail'[Description 1],
				        ""Description 2"", 'Purchase Order Detail'[Description 2],
				        ""Order Date"", 'Purchase Order Detail'[Order Date],
				        ""GL Date"", 'Purchase Order Detail'[GL Date],
				        ""Requested Date"", 'Purchase Order Detail'[Requested Date],
				        ""Promised Shipment Date"", 'Purchase Order Detail'[Promised Shipment Date],
				        ""Original Promised Date"", 'Purchase Order Detail'[Original Promised Date],
				        ""Original Promised Del Date"", 'Purchase Order Detail'[Original Promised Del Date],
				        ""Cancel Date"", 'Purchase Order Detail'[Cancel Date],
				        ""Received Date"", 'Purchase Order Detail'[Received Date],
				        ""FirstReceivedDate"", 'Purchase Order Detail'[FirstReceivedDate],
				        ""LastReceivedDate"", 'Purchase Order Detail'[LastReceivedDate],
				        ""Actual Ship Date"", 'Purchase Order Detail'[Actual Ship Date],
				        ""QuantityOrdered"", 'Purchase Order Detail'[QuantityOrdered],
				        ""QuantityOpen"", 'Purchase Order Detail'[QuantityOpen],
				        ""QuantityReceived"", 'Purchase Order Detail'[QuantityReceived],
				        ""QuantityRelieved"", 'Purchase Order Detail'[QuantityRelieved],
				        ""QuantityOnHold"", 'Purchase Order Detail'[QuantityOnHold],
				        ""QuantityCumulativeReceived"", 'Purchase Order Detail'[QuantityCumulativeReceived],
				        ""QuantityOrderedPrimaryUOM"", 'Purchase Order Detail'[QuantityOrderedPrimaryUOM],
				        ""AmountExtendedCost"", 'Purchase Order Detail'[AmountExtendedCost],
				        ""AmountExtendedPrice"", 'Purchase Order Detail'[AmountExtendedPrice],
				        ""AmountOpen"", 'Purchase Order Detail'[AmountOpen],
				        ""AmountReceived"", 'Purchase Order Detail'[AmountReceived],
				        ""AmountOnHold"", 'Purchase Order Detail'[AmountOnHold],
				        ""AmountRelieved"", 'Purchase Order Detail'[AmountRelieved],
				        ""PO Unit Cost"", 'Purchase Order Detail'[PO Unit Cost],
				        ""UnitCostPurchasing"", 'Purchase Order Detail'[UnitCostPurchasing],
				        ""ConversionFactorKG"", 'Purchase Order Detail'[ConversionFactorKG],
				        ""ConversionFactorLB"", 'Purchase Order Detail'[ConversionFactorLB],
				        ""USDRate"", 'Purchase Order Detail'[USDRate],
				        ""EURRate"", 'Purchase Order Detail'[EURRate],
				        ""Currency Code Base"", 'Purchase Order Detail'[Currency Code Base],
				        ""Currency Code From"", 'Purchase Order Detail'[Currency Code From],
				        ""UOM Transaction"", 'Purchase Order Detail'[UOM Transaction],
				        ""UOM Primary"", 'Purchase Order Detail'[UOM Primary],
				        ""UOM Purchasing"", 'Purchase Order Detail'[UOM Purchasing],
				        ""Supplier OTIF"", 'Purchase Order Detail'[Supplier OTIF],
				        ""OnTimeFlag"", 'Purchase Order Detail'[OnTimeFlag],
				        ""InFullFlag"", 'Purchase Order Detail'[InFullFlag],
				        ""OnTimeInFullFlag"", 'Purchase Order Detail'[OnTimeInFullFlag],
				        ""LateFlag"", 'Purchase Order Detail'[LateFlag],
				        ""Past Due Flag"", 'Purchase Order Detail'[Past Due Flag],
				        ""Days Off Target"", 'Purchase Order Detail'[Days Off Target],
				        ""Delivery Status"", 'Purchase Order Detail'[Delivery Status],
				        ""Delivery Score"", 'Purchase Order Detail'[Delivery Score],
				        ""Estimated Lead Time"", 'Purchase Order Detail'[Estimated Lead Time],
				        ""ActualLeadTime"", 'Purchase Order Detail'[ActualLeadTime],
				        ""Revision Count"", 'Purchase Order Detail'[Revision Count],
				        ""Count Number Reschedule"", 'Purchase Order Detail'[Count Number Reschedule],
				        ""Total Reschedule"", 'Purchase Order Detail'[Total Reschedule]
				    )
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

