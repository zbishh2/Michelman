/// Work orders from JDE F4801 via EDW, one row per work order, from 2024 onward. The batch population behind Right Time First Batch. The source query projects raw columns only; all batch scoping is done in the calculated columns on this table. Source query: edw_model/WorkOrders.m.
table WorkOrders
	lineageTag: 4a78ceaf-3c5e-45a3-8228-724301ebbfd0

	/// Surrogate key for the JDE work order (F4801.WADOCO). An identifier, so it is never summarised.
	column WorkOrderSKey
		dataType: int64
		formatString: 0
		lineageTag: 4d1dc049-2234-45ce-a5d7-3f7ad3ed9daa
		summarizeBy: none
		sourceColumn: WorkOrderSKey

		annotation SummarizationSetBy = Automatic

	/// The JDE work order number, as printed on the work order.
	column WorkOrderNum
		dataType: string
		lineageTag: 2f5a91b4-8c07-4d63-a19e-6b4c7f3d8e21
		summarizeBy: none
		sourceColumn: WorkOrderNum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	/// F4801 order date. The active join to DateTable.
	column 'Order Date'
		dataType: dateTime
		formatString: m/d/yy
		lineageTag: 9cc7b34c-72ab-42e9-b416-dcea2d4f4cf5
		summarizeBy: none
		sourceColumn: Order Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// F4801 completion date. Not joined to DateTable. JDE rewrites this as the work order status advances, so report on [Completion Date (SOP Basis)] instead.
	column 'Completion Date'
		dataType: dateTime
		formatString: m/d/yy
		lineageTag: 7b3e42a8-51d9-4c07-b6f2-9e18a5c3d740
		summarizeBy: none
		sourceColumn: Completion Date

		variation Variation
			isDefault
			relationship: d8a66db1-db09-4aab-b765-4b17513fbc99
			defaultHierarchy: LocalDateTable_cec2f101-e260-4189-830a-33efa15cb0b4.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// F4801 requested completion date. Not joined to DateTable.
	column 'Requested Date'
		dataType: dateTime
		formatString: m/d/yy
		lineageTag: c19f8d64-2a75-4b31-8e05-3d7061b2f9ac
		summarizeBy: none
		sourceColumn: Requested Date

		variation Variation
			isDefault
			relationship: c715f575-8ab5-403c-9c66-93cf9c71d49f
			defaultHierarchy: LocalDateTable_6637d993-b113-40ab-9310-9e49be2425ca.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// JDE company (F0010), reached through the branch. Shares its Region mapping with FactSalesDetail.
	column 'Order Company'
		dataType: string
		lineageTag: eeb9a675-5d5b-4be5-a3f5-b3386183b20a
		summarizeBy: none
		sourceColumn: Order Company

		annotation SummarizationSetBy = Automatic

	/// JDE branch plant (F0006). Bulk production runs at CINC, CIN2, SING and AUBA.
	column 'Branch Plant'
		dataType: string
		lineageTag: a897dc7f-e152-4448-8c63-731501cc7ac0
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	column 'Branch Plant Desc'
		dataType: string
		lineageTag: 3f1f50f2-8e7b-4028-b531-30a55e59326b
		summarizeBy: none
		sourceColumn: Branch Plant Desc

		annotation SummarizationSetBy = Automatic

	column BranchSKey
		dataType: int64
		formatString: 0
		lineageTag: 228b7fa7-1f8f-4e7a-81dc-5ae751913aa2
		summarizeBy: count
		sourceColumn: BranchSKey

		annotation SummarizationSetBy = Automatic

	/// Lot surrogate key. Not currently joined. Salesforce cases carry a lot key too, and it is the only batch-level link available between a case and a work order.
	column LotSKey
		dataType: int64
		formatString: 0
		lineageTag: 6a48a4ca-dd83-4f84-b039-5f3534952e6f
		summarizeBy: count
		sourceColumn: LotSKey

		annotation SummarizationSetBy = Automatic

	column OrderDateSKey
		dataType: int64
		formatString: 0
		lineageTag: bb1c6bd3-3f48-4518-a55d-f4c3f57bb65f
