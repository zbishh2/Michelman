// DimRevisionReason — calculated table for the executive model.
// Schedule-revision reason codes (RFRV / JDE UDC 42/RR) + descriptions.
// Relate DimRevisionReason[RevisionReason] 1 -> * FactScheduleChange[RevisionReason].
// ** ReasonCategory + CountsAgainstOTIF are a DRAFT classification — confirm w/ Greg. **
// Codes/descriptions pulled live from PRODCTL.F0005 (42/RR) on 2026-06-10.
DimRevisionReason =
DATATABLE (
    "RevisionReason", STRING,
    "ReasonDescription", STRING,
    "ReasonCategory", STRING,
    "CountsAgainstOTIF", INTEGER,
    {
        { "",    "(No reason recorded)",            "Unspecified",                  1 },
        { "A1",  "Assigning Lot Number",            "Administrative / Scheduling",  0 },
        { "A2",  "Schedule pick date change",       "Administrative / Scheduling",  0 },
        { "A3",  "DO NOT USE",                      "No Impact (flagged)",          0 },
        { "A31", "CSR - no impact",                 "No Impact (flagged)",          0 },
        { "A32", "FMB - no impact",                 "No Impact (flagged)",          0 },
        { "A33", "RM issue - no impact",            "No Impact (flagged)",          0 },
        { "A34", "Equipment Issues - no impact",    "No Impact (flagged)",          0 },
        { "A35", "Capacity Issues - no impact",     "No Impact (flagged)",          0 },
        { "A36", "Labor Issues / RH - no impact",   "No Impact (flagged)",          0 },
        { "A4",  "Logistic review",                 "Administrative / Scheduling",  1 },
        { "A5",  "Int'l. Doc. Conv. Cor.",          "Administrative / Scheduling",  1 },
        { "A6",  "Scheduler Assign Dates",          "Administrative / Scheduling",  0 },
        { "C0",  "No effect / Pas effet client",    "Administrative / Scheduling",  0 },
        { "C1",  "Credit Hold / Paiement",          "Customer / Commercial",        1 },
        { "C2",  "Cust Req / Demande client",       "Customer / Commercial",        1 },
        { "C3",  "Branch Plant Change",             "Customer / Commercial",        1 },
        { "C4",  "Groupage",                        "Customer / Commercial",        1 },
        { "C5",  "Order Entry Error / CSR",         "Customer / Commercial",        1 },
        { "C6",  "Communication",                   "Customer / Commercial",        1 },
        { "C7",  "Customer Supplied Raw Mat.",      "Customer / Commercial",        1 },
        { "F1",  "FMB / Scale Up Issues",           "Production / Capacity",        1 },
        { "L1",  "Incorrect Item Set Up in JDE",    "Material / RM",                1 },
        { "L2",  "Raw Material not ordered / RM",   "Material / RM",                1 },
        { "L3",  "RM Delivery Issue / qt RM",       "Material / RM",                1 },
        { "L4",  "Shipping Error",                  "Carrier / Logistics",          1 },
        { "L5",  "Weather/Storm Related Delays",    "Material / RM",                1 },
        { "LCM", "Contract Manfacture Mat Delay",   "Material / RM",                1 },
        { "LFC", "FCST incorrect/RM not ordered",   "Material / RM",                1 },
        { "LIC", "Intercompany Material Delay",     "Material / RM",                1 },
        { "LQW", "Lower Quality Sales",             "Material / RM",                1 },
        { "P3",  "Equipment Issues",                "Production / Capacity",        1 },
        { "P4",  "Capacity Issues / capacite",      "Production / Capacity",        1 },
        { "P5",  "Labor Issues / RH",               "Production / Capacity",        1 },
        { "P6",  "SS Shortage / Inv Issues",        "Production / Capacity",        1 },
        { "P7",  "Intermediate Delay",              "Production / Capacity",        1 },
        { "P8",  "DNU - Lead Time Delay",           "Production / Capacity",        1 },
        { "P9",  "Pilot Plant Lead Time Delay",     "Production / Capacity",        1 },
        { "PD1", "1st Prod Delay / delai prod",     "Production / Capacity",        1 },
        { "PD2", "2nd Prod Delay / delai prod",     "Production / Capacity",        1 },
        { "PD3", "Multiple Production Delays",       "Production / Capacity",       1 },
        { "Q1",  "Non Conf Batch / Non FTRB",       "Quality",                      1 },
