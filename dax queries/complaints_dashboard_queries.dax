// =====================================================================
// Customer Complaints % — data-pull queries
// Target: Power BI Desktop DAX Query View (or SSMS against SSASDEV.BIQLTabular)
// Pattern: pull DETAIL ROWS with all filter columns exposed; do the filtering
//          report-side (slicers / measures) in Power BI, NOT in DAX here.
//
// Headline metric (built in PBI from these two tables, after report-side filters):
//   Complaints   = DISTINCTCOUNT ( Complaints[CaseNumber] )
//   Orders       = DISTINCTCOUNT ( Orders[Order Num] )
//   Clean Order% = DIVIDE ( [Orders] - [Complaints], [Orders] )
//
// ID columns (CaseNumber, LotSKey, Order Num) are forced to TEXT via & "" so
// Power BI imports them as attributes, not summable numbers (no Sigma icon,
// no accidental aggregation). DISTINCTCOUNT still works on text.
//
// NOTE on the date lines: GL Date / Date_of_Occurrence >= 2024-01-01 is an
// EXPORT-SIZE bound, not a business rule. Sales is line grain (millions of
// rows). Remove or widen as needed.
// =====================================================================


// ---------------------------------------------------------------------
// 1) COMPLAINTS  — source: SF_Case  — one row per case
// ---------------------------------------------------------------------
EVALUATE
SELECTCOLUMNS (
    FILTER ( SF_Case, SF_Case[Date_of_Occurance__c] >= DATE ( 2024, 1, 1 ) ),  // export-size bound only
    "CaseNumber",         SF_Case[CaseNumber] & "",        // text -> no Sigma
    "Date_of_Occurrence", SF_Case[Date_of_Occurance__c],
    "CreatedDate",        SF_Case[CreatedDate],
    "Level_1",            SF_Case[Level_1__c],
    "Level_2",            SF_Case[Level_2__c],
    "Region",             SF_Case[Region__c],
    "Location",           SF_Case[Location__c],
    "Complaint_Valid",    SF_Case[Complaint_Valid__c],
    "RecordTypeId",       SF_Case[RecordTypeId],
    "LotSKey",            SF_Case[LotSKey] & "",           // text -> no Sigma
    "Product_ID",         SF_Case[Product_Code__c],        // SF Product2 id — name pending
    "Champion_ID",        SF_Case[Champion__c]             // SF User id — name pending
)
ORDER BY [Date_of_Occurrence]


// ---------------------------------------------------------------------
// 2) ORDERS  — source: Sales fact  — LINE grain (one row per order line)
// ---------------------------------------------------------------------
// Returned at line grain so the report can filter on line-level attributes,
// THEN DISTINCTCOUNT(Order Num). Report-side filters to apply:
//   Order Type   -> keep S4 / SO / SD / SZ
//   Record Type  -> keep order rows (drop flattened GL/ledger)
//   Cancelled_Flag / Status Code Last -> drop cancelled (980) if desired
//   Line Type / Exclude Freight       -> drop FS freight if desired
//   Order Company -> region rollup + Singapore (30/34/35) dedup
//   Filter - Active Order Types -> may already encode the keep-list
// Date axis = GL Date.
EVALUATE
SELECTCOLUMNS (
    FILTER ( Sales,
        NOT ISBLANK ( Sales[GL Date] )
            && Sales[GL Date] >= DATE ( 2024, 1, 1 ) ),  // export-size bound only
    "Order Num",            Sales[Order Num] & "",        // text -> no Sigma
    "Order Company",        Sales[Order Company],
    "Order Type",           Sales[Order Type],
    "Order Type Desc",      Sales[Order Type Desc],
    "Record Type",          Sales[Record Type],
    "Line Type",            Sales[Line Type],
    "Exclude Freight",      Sales[Exclude Freight Line Types],
    "Filter Active Types",  Sales[Filter - Active Order Types],
    "Cancelled_Flag",       Sales[Cancelled_Flag],
    "Order Exclude",        Sales[Order Exclude],
    "Status Code Last",     Sales[Status Code Last],
    "GL Date",              Sales[GL Date],
    "Actual Ship Date",     Sales[Actual Ship Date]
)


// ---------------------------------------------------------------------
// 3) ORDERS BY SHIP DATE  — source: Sales fact  — LINE grain
// ---------------------------------------------------------------------
// Same columns/grain as query (2), but bounded on ACTUAL SHIP DATE and the
// GL Date requirement is DROPPED. Purpose: ship-date denominator analysis.
//
// WHY a separate pull: query (2) requires NOT ISBLANK(GL Date), so it can only
// ever contain GL-posted orders. Orders that have SHIPPED but are not yet
// GL/ledger-posted (the ~10% the Cognos source-of-truth counts and the GL-Date
// export does not) have a blank GL Date and are therefore absent from query (2).
// Re-bucketing query (2) by ship date would NOT recover them. This query removes
// the GL-Date gate and bounds on Actual Ship Date so those orders are captured,
// letting us test whether a ship-date denominator reconciles with Cognos.
//
// GL Date is still returned (may be blank) so you can see ship-vs-GL lag and
// flag the shipped-not-yet-posted rows.
EVALUATE
SELECTCOLUMNS (
    FILTER ( Sales,
        NOT ISBLANK ( Sales[Actual Ship Date] )
            && Sales[Actual Ship Date] >= DATE ( 2024, 1, 1 ) ),  // export-size bound only
    "Order Num",            Sales[Order Num] & "",        // text -> no Sigma
    "Order Company",        Sales[Order Company],
    "Order Type",           Sales[Order Type],
    "Order Type Desc",      Sales[Order Type Desc],
    "Record Type",          Sales[Record Type],
    "Line Type",            Sales[Line Type],
    "Exclude Freight",      Sales[Exclude Freight Line Types],
    "Filter Active Types",  Sales[Filter - Active Order Types],
    "Cancelled_Flag",       Sales[Cancelled_Flag],
    "Order Exclude",        Sales[Order Exclude],
    "Status Code Last",     Sales[Status Code Last],
    "GL Date",              Sales[GL Date],               // may be blank (shipped, not yet posted)
    "Actual Ship Date",     Sales[Actual Ship Date]
)


// ---------------------------------------------------------------------
// HELPER probes (run ad hoc; not part of the export)
// ---------------------------------------------------------------------
// Distinct Record Type values + row counts (find the order-vs-GL split, Q9):
// EVALUATE SUMMARIZECOLUMNS ( Sales[Record Type], "Rows", COUNTROWS ( Sales ) ) ORDER BY [Rows] DESC
//
// Distinct Order Type values present (sanity-check the keep list, Q8):
// EVALUATE SUMMARIZECOLUMNS ( Sales[Order Type], "Rows", COUNTROWS ( Sales ) ) ORDER BY [Rows] DESC
//
// Confirm Level_1 spelling on complaints (Q1):
// EVALUATE SUMMARIZECOLUMNS ( SF_Case[Level_1__c], "Cases", COUNTROWS ( SF_Case ) ) ORDER BY [Cases] DESC
