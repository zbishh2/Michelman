		sourceColumn: Country Name

	partition 'Customer Ship To' = m
		mode: import
		source =
				let
					Raw = AnalysisServices.Database("SSASPROD", "BIQLTabular", [Query = "
					EVALUATE
					SELECTCOLUMNS (
					    'Customer Ship To',
					    ""ShipToCustomerSKey"", 'Customer Ship To'[ShipToCustomerSKey],
					    ""Customer Code"", 'Customer Ship To'[Customer Ship To],
					    ""Customer Name"", TRIM ( 'Customer Ship To'[Customer Ship To Name] ),
					    ""Sales Business Unit"", 'Customer Ship To'[Sales Business Unit],
					    ""Customer Segmentation Description"", 'Customer Ship To'[Customer Segmentation Desc],
					    ""Country Name"", 'Customer Ship To'[Country Desc]
					)
					"]),
					Data = Table.TransformColumnNames(Raw, each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]") then Text.Middle(_, 1, Text.Length(_) - 2) else _)
				in
					Data

	annotation PBI_ResultType = Table
