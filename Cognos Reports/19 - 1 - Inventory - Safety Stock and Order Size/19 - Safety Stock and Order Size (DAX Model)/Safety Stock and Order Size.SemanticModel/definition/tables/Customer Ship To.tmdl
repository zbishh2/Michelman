table 'Customer Ship To'
	lineageTag: 19d3a000-0000-4000-8000-000000000001

	column ShipToCustomerSKey
		dataType: int64
		isHidden
		lineageTag: 19d30000-0000-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: ShipToCustomerSKey

	column 'Customer Code'
		dataType: int64
		formatString: 0
		lineageTag: 19d30000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: Customer Code

	column 'Customer Name'
		dataType: string
		lineageTag: 19d30000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: Customer Name

	column 'Sales Business Unit'
		dataType: string
		lineageTag: 19d30000-0000-4000-8000-000000000004
		summarizeBy: none
		sourceColumn: Sales Business Unit

	column 'Customer Segmentation Description'
		dataType: string
		lineageTag: 19d30000-0000-4000-8000-000000000005
