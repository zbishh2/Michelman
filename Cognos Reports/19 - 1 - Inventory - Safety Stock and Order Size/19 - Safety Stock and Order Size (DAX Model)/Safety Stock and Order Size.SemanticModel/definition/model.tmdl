model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Safety Stock", "Customer Ship To", "Customer", "Territory Manager", "Shipments", "Last Refreshed"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Safety Stock'
ref table Shipments
ref table 'Last Refreshed'
ref table 'Customer Ship To'
ref table Customer
ref table 'Territory Manager'

ref cultureInfo en-US
