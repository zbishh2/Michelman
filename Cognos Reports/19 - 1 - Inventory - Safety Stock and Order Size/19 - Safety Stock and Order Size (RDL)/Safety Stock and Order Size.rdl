  <DataSets>
    <DataSet Name="dsSafetyStock">
      <Query>
        <DataSourceName>SSASPROD_BIQLTabular</DataSourceName>
        <CommandText>DEFINE
    VAR R19SafetyStock =
        FILTER (
            'Item Branch',
            TRIM ( 'Item Branch'[Business Unit] ) IN { "CINC", "CIN2", "AUBA", "AUB2", "SING", "SNG4" }
                &amp;&amp; 'Item Branch'[SafetyStock] &gt; 1
                &amp;&amp; TRIM ( 'Item Branch'[Stocking Type] ) &lt;&gt; "O"
                &amp;&amp; CONTAINSSTRING ( 'Item Branch'[Master Planning Family], "F" )
        )
EVALUATE
SELECTCOLUMNS (
    R19SafetyStock,
    "BranchPlant", TRIM ( 'Item Branch'[Business Unit] ),
    "BulkItem", 'Item Branch'[Item Bulk],
    "ItemNumber2nd", 'Item Branch'[Item Num 2nd],
    "StockTypeCode", TRIM ( 'Item Branch'[Stocking Type] ),
    "MasterPlanningFamily", TRIM ( 'Item Branch'[Master Planning Family] ),
    "LeadTimeOrderToShip", 'Item Branch'[Lead Time MFG_BP],
    "PlannerNumber", 'Item Branch'[Planner Num],
    "PlannerName", TRIM ( 'Item Branch'[Planner Name] ),
    "SafetyStock", 'Item Branch'[SafetyStock],
    "UnitOfMeasurePrimary", TRIM ( 'Item Branch'[UOM Primary] )
)
ORDER BY [BulkItem], [ItemNumber2nd], [BranchPlant]</CommandText>
      </Query>
      <Fields>
        <Field Name="BranchPlant">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[BranchPlant]</DataField>
        </Field>
        <Field Name="BulkItem">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[BulkItem]</DataField>
        </Field>
        <Field Name="ItemNumber2nd">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[ItemNumber2nd]</DataField>
        </Field>
        <Field Name="StockTypeCode">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[StockTypeCode]</DataField>
        </Field>
        <Field Name="MasterPlanningFamily">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[MasterPlanningFamily]</DataField>
        </Field>
        <Field Name="LeadTimeOrderToShip">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[LeadTimeOrderToShip]</DataField>
        </Field>
        <Field Name="PlannerNumber">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[PlannerNumber]</DataField>
        </Field>
        <Field Name="PlannerName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[PlannerName]</DataField>
        </Field>
        <Field Name="SafetyStock">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[SafetyStock]</DataField>
        </Field>
        <Field Name="UnitOfMeasurePrimary">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[UnitOfMeasurePrimary]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsShipments">
      <Query>
        <DataSourceName>SSASPROD_BIQLTabular</DataSourceName>
        <CommandText>DEFINE
    VAR R19EligibleSales =
        FILTER (
            Sales,
            VAR R19GlobalBulk =
                TRIM ( RELATED ( 'Item Branch'[Item Global Bulk] ) )
            VAR R19TaxItemKey =
                IF (
                    R19GlobalBulk IN { "", "-" },
                    TRIM ( Sales[Item Num 2nd] ),
                    R19GlobalBulk
                )
            RETURN
                TRIM ( Sales[Record Type] ) = "Sales Detail"
                    &amp;&amp; TRIM ( Sales[Status Code Next] ) = "999"
                    &amp;&amp; TRIM ( Sales[BusinessUnit] ) IN { "CINC", "CIN2", "AUBA", "AUB2", "SING", "SNG4" }
                    &amp;&amp; Sales[Promised Shipment Date] &gt;= TODAY () - 183
                    &amp;&amp; NOT ( TRIM ( Sales[Order Type] ) IN { "S5", "ST" } )
                    &amp;&amp; NOT ( CONTAINSSTRING ( Sales[Line Type], "F" ) )
                    &amp;&amp; NOT ( TRIM ( Sales[Status Code Last] ) IN { "980", "984" } )
                    &amp;&amp; Sales[QuantityOrderedPrimaryUOM] &gt; 0
                    &amp;&amp; TRIM ( RELATED ( 'Customer Ship To'[Sales Business Unit] ) ) &lt;&gt; "INT"
                    &amp;&amp; CONTAINSSTRING ( RELATED ( 'Item Branch'[Master Planning Family] ), "F" )
                    &amp;&amp; NOT ( R19TaxItemKey IN { "IGST", "CGST", "SGST", "CVD", "ADD" } )
        )
    VAR R19ShipmentGroups =
        SUMMARIZECOLUMNS (
            Sales[Order Company],
            Sales[BusinessUnit],
            Sales[Order Num],
            'Item Branch'[Item Bulk],
            Sales[Item Num 2nd],
            Sales[Order Date],
            Sales[UOM],
            Sales[Promised Shipment Date],
            Sales[Scheduled Pick Date],
            'Customer Ship To'[Customer Ship To],
            'Customer Ship To'[Customer Ship To Name],
            'Customer'[Global Parent Name],
            'Customer Ship To'[Customer Segmentation Desc],
            'Territory Manager'[Mailing Name],
            'Customer Ship To'[Country Desc],
            R19EligibleSales,
            "OrderedQuantity", SUM ( Sales[QuantityOrderedPrimaryUOM] ),
            "OrderedQuantityLBs", SUM ( Sales[QuantityOrderedLB] ),
            "OrderedQuantityKGs", SUM ( Sales[QuantityOrderedKG] )
        )
EVALUATE
SELECTCOLUMNS (
    R19ShipmentGroups,
    "OrderCompany", Sales[Order Company],
    "BranchPlant", TRIM ( Sales[BusinessUnit] ),
    "OrderNumber", Sales[Order Num],
    "BulkItem", IF ( ISBLANK ( 'Item Branch'[Item Bulk] ), "-", 'Item Branch'[Item Bulk] ),
    "ItemNumber2nd", Sales[Item Num 2nd],
    "OrderedDate", Sales[Order Date],
    "OrderedQuantity", [OrderedQuantity],
    "OrderingUnitOfMeasure", TRIM ( Sales[UOM] ),
    "OrderedQuantityLBs", [OrderedQuantityLBs],
    "OrderedQuantityKGs", [OrderedQuantityKGs],
    "PromisedShipDate", Sales[Promised Shipment Date],
    "ScheduledPickDate", Sales[Scheduled Pick Date],
    "CustomerCode", 'Customer Ship To'[Customer Ship To],
    "CustomerName", TRIM ( 'Customer Ship To'[Customer Ship To Name] ),
    "GlobalParentName", TRIM ( 'Customer'[Global Parent Name] ),
    "CustomerSegmentationDescription", 'Customer Ship To'[Customer Segmentation Desc],
    "TMName", IF ( ISBLANK ( 'Territory Manager'[Mailing Name] ), "Not Available", TRIM ( 'Territory Manager'[Mailing Name] ) ),
    "CountryName", 'Customer Ship To'[Country Desc],
    "ReportDate", TODAY ()
)
ORDER BY [BulkItem], [ItemNumber2nd], [OrderNumber]</CommandText>
      </Query>
      <Fields>
        <Field Name="OrderCompany">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[OrderCompany]</DataField>
        </Field>
        <Field Name="BranchPlant">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[BranchPlant]</DataField>
        </Field>
        <Field Name="OrderNumber">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[OrderNumber]</DataField>
        </Field>
        <Field Name="BulkItem">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[BulkItem]</DataField>
        </Field>
        <Field Name="ItemNumber2nd">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[ItemNumber2nd]</DataField>
        </Field>
        <Field Name="OrderedDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[OrderedDate]</DataField>
        </Field>
        <Field Name="OrderedQuantity">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[OrderedQuantity]</DataField>
        </Field>
        <Field Name="OrderingUnitOfMeasure">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[OrderingUnitOfMeasure]</DataField>
        </Field>
        <Field Name="OrderedQuantityLBs">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[OrderedQuantityLBs]</DataField>
        </Field>
        <Field Name="OrderedQuantityKGs">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[OrderedQuantityKGs]</DataField>
        </Field>
        <Field Name="PromisedShipDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[PromisedShipDate]</DataField>
        </Field>
        <Field Name="ScheduledPickDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[ScheduledPickDate]</DataField>
        </Field>
        <Field Name="CustomerCode">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[CustomerCode]</DataField>
        </Field>
        <Field Name="CustomerName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[CustomerName]</DataField>
        </Field>
        <Field Name="GlobalParentName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[GlobalParentName]</DataField>
        </Field>
        <Field Name="CustomerSegmentationDescription">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[CustomerSegmentationDescription]</DataField>
        </Field>
        <Field Name="TMName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[TMName]</DataField>
        </Field>
        <Field Name="CountryName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[CountryName]</DataField>
        </Field>
        <Field Name="ReportDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[ReportDate]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsRefresh">
      <Query>
        <DataSourceName>SSASPROD_BIQLTabular</DataSourceName>
        <CommandText>EVALUATE
ROW (
    "LastRefreshed",
    CALCULATE ( MAX ( Audit[DateUpdated] ) )
)</CommandText>
      </Query>
      <Fields>
        <Field Name="LastRefreshed">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[LastRefreshed]</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
