		annotation UnderlyingDateTimeDataType = Date

	column 'Completed Date'
		dataType: dateTime
		formatString: d MMM, yyyy
		lineageTag: 5c75e508-9140-4621-b282-a4d6ca22810e
		summarizeBy: none
		sourceColumn: Completed Date

