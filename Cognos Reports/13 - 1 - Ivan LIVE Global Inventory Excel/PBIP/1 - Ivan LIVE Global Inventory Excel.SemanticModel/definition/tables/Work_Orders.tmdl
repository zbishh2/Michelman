table Work_Orders
	lineageTag: c6f0fcbf-b60d-48b3-91c5-de0feb46e931

	column 'Branch Plant'
		dataType: string
		lineageTag: 7c98bb80-88ad-4bce-9be9-4dc8e3608ef3
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	column 'Global Bulk Item'
		dataType: string
		lineageTag: 18b1adf5-5e24-419e-9b13-8a729443fb5b
		summarizeBy: none
		sourceColumn: Global Bulk Item

		annotation SummarizationSetBy = Automatic

	column 'Bulk Item'
		dataType: string
		lineageTag: f4c1ff75-07f9-4e62-a799-6530b6af8dec
		summarizeBy: none
		sourceColumn: Bulk Item

		annotation SummarizationSetBy = Automatic

	column '2nd Item Number'
		dataType: string
		lineageTag: 4897e9ee-8561-467f-ba5e-dd8c545b38fb
		summarizeBy: none
		sourceColumn: 2nd Item Number

		annotation SummarizationSetBy = Automatic

	column 'WO Number'
		dataType: int64
		formatString: 0
		lineageTag: 39f55266-ea59-4763-b960-dd70c0701ba1
		summarizeBy: none
		sourceColumn: WO Number

		annotation SummarizationSetBy = User

	column 'WO Status'
		dataType: string
		lineageTag: 7cec2505-cb2a-48a6-8420-d44ad62dc9a7
		summarizeBy: none
		sourceColumn: WO Status

		annotation SummarizationSetBy = Automatic

	column 'Order Date'
		dataType: dateTime
		formatString: d MMM, yyyy
		lineageTag: db53f687-3ba9-482a-a0b4-12e4da02a0a1
		summarizeBy: none
		sourceColumn: Order Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Start Date'
		dataType: dateTime
		formatString: d MMM, yyyy
		lineageTag: c552a0d4-08e7-4475-a032-d971468297a6
		summarizeBy: none
		sourceColumn: Start Date

