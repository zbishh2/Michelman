  <DataSets>
    <DataSet Name="InventoryDates">
      <Query>
        <DataSourceName>SSASPROD_BIQLTabular_ISH</DataSourceName>
        <CommandText>EVALUATE
VAR AvailableInventoryDates =
    SUMMARIZECOLUMNS (
        'Calendar Inventory Snapshot'[Calendar Date],
        FILTER (
            VALUES ( 'Branch'[Branch Plant] ),
            TRIM ( 'Branch'[Branch Plant] ) IN { "CINC", "CIN2" }
        ),
        FILTER (
            VALUES ( 'Inventory Snapshot'[CostMethod] ),
            TRIM ( 'Inventory Snapshot'[CostMethod] ) = "07"
        ),
        "QuantityOnHandLB", [Qty On Hand LB]
    )
RETURN
SELECTCOLUMNS (
    FILTER ( AvailableInventoryDates, NOT ISBLANK ( [QuantityOnHandLB] ) ),
    "InventoryDate", 'Calendar Inventory Snapshot'[Calendar Date],
    "InventoryDateLabel", FORMAT ( 'Calendar Inventory Snapshot'[Calendar Date], "M/d/yyyy" )
)
ORDER BY [InventoryDate] DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="InventoryDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[InventoryDate]</DataField>
        </Field>
        <Field Name="InventoryDateLabel">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[InventoryDateLabel]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LatestInventoryDate">
      <Query>
        <DataSourceName>SSASPROD_BIQLTabular_ISH</DataSourceName>
        <CommandText>EVALUATE
VAR AvailableInventoryDates =
    SUMMARIZECOLUMNS (
        'Calendar Inventory Snapshot'[Calendar Date],
        FILTER (
            VALUES ( 'Branch'[Branch Plant] ),
            TRIM ( 'Branch'[Branch Plant] ) IN { "CINC", "CIN2" }
        ),
        FILTER (
            VALUES ( 'Inventory Snapshot'[CostMethod] ),
            TRIM ( 'Inventory Snapshot'[CostMethod] ) = "07"
        ),
        "QuantityOnHandLB", [Qty On Hand LB]
    )
RETURN
TOPN (
    1,
    SELECTCOLUMNS (
        FILTER ( AvailableInventoryDates, NOT ISBLANK ( [QuantityOnHandLB] ) ),
        "InventoryDate", 'Calendar Inventory Snapshot'[Calendar Date]
    ),
    [InventoryDate], DESC
)</CommandText>
      </Query>
      <Fields>
        <Field Name="InventoryDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[InventoryDate]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="InventoryTier2">
      <Query>
        <DataSourceName>SSASPROD_BIQLTabular_ISH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="InventoryDate">
            <Value>=Parameters!InventoryDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS (
    'Branch'[Branch Plant],
    'Item Branch'[Item Num 2nd],
    'Item Branch'[Item Num Bulk],
    'Item Branch'[Item Num Global Bulk],
    'Item Branch'[Master Planning Family],
    'Calendar Inventory Snapshot'[Calendar Date],
    FILTER (
        VALUES ( 'Branch'[Branch Plant] ),
        TRIM ( 'Branch'[Branch Plant] ) IN { "CINC", "CIN2" }
    ),
    FILTER (
        VALUES ( 'Calendar Inventory Snapshot'[Calendar Date] ),
        'Calendar Inventory Snapshot'[Calendar Date]
            = DATEVALUE ( @InventoryDate ) + TIMEVALUE ( @InventoryDate )
    ),
    FILTER (
        VALUES ( 'Inventory Snapshot'[CostMethod] ),
        TRIM ( 'Inventory Snapshot'[CostMethod] ) = "07"
    ),
    "Quantity on Hand LBs", [Qty On Hand LB]
)
ORDER BY
    'Branch'[Branch Plant],
    'Item Branch'[Item Num 2nd],
    'Item Branch'[Item Num Bulk],
    'Item Branch'[Item Num Global Bulk]</CommandText>
      </Query>
      <Fields>
        <Field Name="Branch_Plant">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Branch[Branch Plant]</DataField>
        </Field>
        <Field Name="Item_Num_2nd">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Item Branch[Item Num 2nd]</DataField>
        </Field>
        <Field Name="Bulk_Item">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Item Branch[Item Num Bulk]</DataField>
        </Field>
        <Field Name="Global_Bulk_Item">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Item Branch[Item Num Global Bulk]</DataField>
        </Field>
        <Field Name="Master_Planning_Family">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Item Branch[Master Planning Family]</DataField>
        </Field>
        <Field Name="Quantity_on_Hand_LBs">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>[Quantity on Hand LBs]</DataField>
        </Field>
        <Field Name="Inventory_Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Calendar Inventory Snapshot[Calendar Date]</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
