table Snapshot
	lineageTag: 20a1a000-0000-4000-8000-000000000001

	measure K_KG_TO_LB = 2.2045992
		lineageTag: 20a1b000-0000-4000-8000-0000000000b0

	measure 'Quantity on Hand LBs' = VAR DatesInContext = DISTINCTCOUNT('Snapshot'[Inventory Date]) RETURN IF(DatesInContext > 1, BLANK(), SUM('Snapshot'[Quantity on Hand LBs (Row)]))
		formatString: #,0.00
		lineageTag: 20a1b000-0000-4000-8000-0000000000b1

	measure 'Quantity on Hand LBs (Latest in Range)' = VAR LastDate = MAX('Snapshot Date'[Date]) RETURN CALCULATE(SUM('Snapshot'[Quantity on Hand LBs (Row)]), 'Snapshot Date'[Date] = LastDate)
		formatString: #,0.00
		isHidden
		lineageTag: 20a1b000-0000-4000-8000-0000000000b2

	column 'Inventory Date'
		dataType: dateTime
		formatString: d MMM, yyyy
		lineageTag: 20a10000-0000-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: Inventory Date

		annotation SummarizationSetBy = Automatic

	column 'Branch Plant'
		dataType: string
		lineageTag: 20a10000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	column '2nd Item Number'
		dataType: string
		lineageTag: 20a10000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: 2nd Item Number

