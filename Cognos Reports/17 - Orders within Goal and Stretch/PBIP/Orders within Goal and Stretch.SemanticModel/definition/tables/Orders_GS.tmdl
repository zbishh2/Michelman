	/// Business days from first pick-confirm (525, shown as Order Date) to first ship (540, shown as Confirmation Date). Weekend-endpoint behavior matches the Cognos floored-week formula exactly.
	column 'Business Days' =
			VAR StartDate = INT ( Orders_GS[Order Date] )
			VAR EndDate = INT ( Orders_GS[Confirmation Date] )
			VAR Days = EndDate - StartDate
			VAR StartDow = WEEKDAY ( StartDate, 2 )
			VAR EndDow = WEEKDAY ( EndDate, 2 )
			VAR WeekendDays =
			    TRUNC ( ( Days + StartDow ) / 7 ) * 2
			        - IF ( StartDow = 7, 1, 0 )
			        + IF ( EndDow = 6, 1, 0 )
			RETURN
			    Days - WeekendDays
		dataType: int64
		formatString: 0
		lineageTag: b2022d65-44e8-4cf8-93ab-3e44bda9cb3d
		summarizeBy: none

		changedProperty = IsHidden

	column Goal =
			IF (
			    ( Orders_GS[Company Level 2] = "RAME" && Orders_GS[Business Days] <= 1 )
			        || ( Orders_GS[Company Level 2] IN { "REUR", "RASI" } && Orders_GS[Business Days] <= 2 ),
			    1,
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: 7fc83168-deae-4bb9-a120-2b8caef92cf3
		summarizeBy: sum

	column Stretch = IF ( Orders_GS[Business Days] <= 1, 1, 0 )
		dataType: int64
		formatString: 0
		lineageTag: 214e0445-5a6e-4874-83b8-2e344e0cea1e
		summarizeBy: sum

	column >48h = IF ( Orders_GS[Business Days] > 2, 1, 0 )
