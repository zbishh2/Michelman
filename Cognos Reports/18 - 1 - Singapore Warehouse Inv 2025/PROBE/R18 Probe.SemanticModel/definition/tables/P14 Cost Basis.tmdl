table 'P14 Cost Basis'
	lineageTag: 18000f00-0000-4000-8000-000000000001

	column k_date
		dataType: string
		lineageTag: 18000f01-0000-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: k_date

		annotation SummarizationSetBy = Automatic

	column bu
		dataType: string
		lineageTag: 18000f01-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: bu

		annotation SummarizationSetBy = Automatic

