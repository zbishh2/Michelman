model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Singapore Inventory", "Lot Status", "Americas Inventory", "Aubange Inventory", "Last Refreshed"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Singapore Inventory'
ref table 'Lot Status'
ref table 'Americas Inventory'
ref table 'Aubange Inventory'
ref table 'Last Refreshed'

ref cultureInfo en-US

