table 'Inventory Snapshot'
	lineageTag: 18b1a000-0000-4000-8000-000000000001

	measure 'Total Extended Cost USD' = SUM('Inventory Snapshot'[Extended Cost USD])
		formatString: \$#,0;(\$#,0)
		lineageTag: 18b10000-0000-4000-8000-0000000000b1

	column 'Inventory Date'
		dataType: dateTime
		formatString: m/d/yyyy
		lineageTag: 18b10000-0000-4000-8000-000000000001
		summarizeBy: none
