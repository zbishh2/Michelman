	measure 'Inventory Date' =
			VAR q = [On Hand]
			RETURN
			    IF(NOT ISBLANK(q), MAX('Select Date'[Date]))
		formatString: d MMM, yyyy
		displayFolder: Report Engine
		lineageTag: 14a1da07-0000-4000-8000-000000000080

	measure 'On Hand' =
			VAR d = MAX('Select Date'[Date])
			RETURN
			    SUMX(
			        FILTER(
			            'Snapshot',
			            VAR md = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			            RETURN 'Snapshot'[Quantity on Hand] > 0
			                && md >= 'Snapshot'[Interval Start]
			                && md <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			                && 'Snapshot'[Has Item Match]
			                && 'Snapshot'[Has Lot Match]
			                && 'Snapshot'[Has Company Match]
			                && 'Snapshot'[In Family Scope]
			        ),
			        'Snapshot'[Quantity on Hand]
			    )
		formatString: #,0.00
		displayFolder: Report Engine
		lineageTag: 14a1da07-0000-4000-8000-000000000081

	measure 'OH KGs' =
			VAR d = MAX('Select Date'[Date])
			RETURN
			    SUMX(
			        FILTER(
			            'Snapshot',
			            VAR md = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			            RETURN 'Snapshot'[Quantity on Hand] > 0
			                && md >= 'Snapshot'[Interval Start]
			                && md <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			                && 'Snapshot'[Has Item Match]
			                && 'Snapshot'[Has Lot Match]
			                && 'Snapshot'[Has Company Match]
			                && 'Snapshot'[In Family Scope]
