			    )
		formatString: #,0.00
		displayFolder: Report Engine
		lineageTag: 14a1da07-0000-4000-8000-000000000083

	measure 'OH USD' =
			VAR d = MAX('Select Date'[Date])
			VAR borrowPool =
			    FILTER(
			        ALL('Snapshot'),
			        VAR md2 = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			        RETURN 'Snapshot'[ItemCostSKey] <> -1
			            && md2 >= 'Snapshot'[Interval Start]
			            && md2 <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			            && 'Snapshot'[Has Item Match]
			            && 'Snapshot'[Has Lot Match]
			            && 'Snapshot'[Has Company Match]
			            && 'Snapshot'[In Family Scope]
			    )
			RETURN
			    SUMX(
			        FILTER(
			            'Snapshot',
			            VAR md = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			            RETURN 'Snapshot'[Quantity on Hand] > 0
			                && md >= 'Snapshot'[Interval Start]
			                && md <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			                && 'Snapshot'[Has Item Match]
			                && 'Snapshot'[Has Lot Match]
			                && 'Snapshot'[Has Company Match]
			                && 'Snapshot'[In Family Scope]
			        ),
			        VAR itm = 'Snapshot'[ItemSKey]
			        VAR bu = 'Snapshot'[Branch Plant]
			        VAR own = 'Snapshot'[Unit Cost (Lot)]
			        VAR cost =
			            IF(
			                own <> 0,
			                own,
			                MAXX(
			                    FILTER(borrowPool, 'Snapshot'[ItemSKey] = itm && 'Snapshot'[Branch Plant] = bu),
			                    'Snapshot'[Unit Cost (Lot)]
			                )
			            )
			        VAR cur = RELATED('Company'[Currency Code])
			        VAR fx =
			            IF(
			                cur = "USD",
			                1.0,
			                LOOKUPVALUE('FX Rate'[Exchange Rate (to USD)], 'FX Rate'[Currency], cur, 'FX Rate'[Rate Date], d)
			            )
			        RETURN 'Snapshot'[Quantity on Hand] * cost * fx
			    )
		formatString: #,0.00
		displayFolder: Report Engine
		lineageTag: 14a1da07-0000-4000-8000-000000000084

	measure 'OH EUR' =
			VAR d = MAX('Select Date'[Date])
			VAR fxE = LOOKUPVALUE('FX Rate'[Exchange Rate (to USD)], 'FX Rate'[Currency], "EUR", 'FX Rate'[Rate Date], d)
			VAR borrowPool =
			    FILTER(
			        ALL('Snapshot'),
			        VAR md2 = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			        RETURN 'Snapshot'[ItemCostSKey] <> -1
			            && md2 >= 'Snapshot'[Interval Start]
			            && md2 <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			            && 'Snapshot'[Has Item Match]
			            && 'Snapshot'[Has Lot Match]
			            && 'Snapshot'[Has Company Match]
			            && 'Snapshot'[In Family Scope]
			    )
			RETURN
			    SUMX(
			        FILTER(
			            'Snapshot',
			            VAR md = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			            RETURN 'Snapshot'[Quantity on Hand] > 0
			                && md >= 'Snapshot'[Interval Start]
			                && md <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			                && 'Snapshot'[Has Item Match]
			                && 'Snapshot'[Has Lot Match]
			                && 'Snapshot'[Has Company Match]
			                && 'Snapshot'[In Family Scope]
			        ),
			        VAR itm = 'Snapshot'[ItemSKey]
			        VAR bu = 'Snapshot'[Branch Plant]
			        VAR own = 'Snapshot'[Unit Cost (Lot)]
			        VAR cost =
			            IF(
			                own <> 0,
			                own,
			                MAXX(
			                    FILTER(borrowPool, 'Snapshot'[ItemSKey] = itm && 'Snapshot'[Branch Plant] = bu),
			                    'Snapshot'[Unit Cost (Lot)]
			                )
			            )
			        VAR cur = RELATED('Company'[Currency Code])
			        VAR fxeur =
			            SWITCH(
			                TRUE(),
			                cur = "EUR", 1.0,
			                cur = "USD", DIVIDE(1.0, fxE),
			                DIVIDE(LOOKUPVALUE('FX Rate'[Exchange Rate (to USD)], 'FX Rate'[Currency], cur, 'FX Rate'[Rate Date], d), fxE)
			            )
			        RETURN 'Snapshot'[Quantity on Hand] * cost * fxeur
			    )
		formatString: #,0.00
		displayFolder: Report Engine
		lineageTag: 14a1da07-0000-4000-8000-000000000085

	measure 'Cost Source' =
			VAR d = MAX('Select Date'[Date])
			VAR pop =
			    FILTER(
			        'Snapshot',
			        VAR md = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			        RETURN 'Snapshot'[Quantity on Hand] > 0
			            && md >= 'Snapshot'[Interval Start]
			            && md <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			            && 'Snapshot'[Has Item Match]
			            && 'Snapshot'[Has Lot Match]
			            && 'Snapshot'[Has Company Match]
			            && 'Snapshot'[In Family Scope]
			    )
			VAR own = MAXX(pop, 'Snapshot'[Unit Cost (Lot)])
			VAR itm = MAXX(pop, 'Snapshot'[ItemSKey])
			VAR bu = MAXX(pop, 'Snapshot'[Branch Plant])
			VAR borrowed =
			    MAXX(
			        FILTER(
			            ALL('Snapshot'),
			            VAR md2 = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			            RETURN 'Snapshot'[ItemSKey] = itm
			                && 'Snapshot'[Branch Plant] = bu
			                && 'Snapshot'[ItemCostSKey] <> -1
			                && md2 >= 'Snapshot'[Interval Start]
			                && md2 <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			        ),
			        'Snapshot'[Unit Cost (Lot)]
			    )
			RETURN
			    IF(
			        COUNTROWS(pop) = 0,
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            own <> 0, "Own lot cost",
			            NOT ISBLANK(borrowed), "Borrowed from item/branch cost carrier",
			            "No cost available"
			        )
			    )
		displayFolder: Report Engine
		lineageTag: 14a1da07-0000-4000-8000-000000000086

	measure 'Output Rows' =
			VAR d = MAX('Select Date'[Date])
			RETURN
			    COUNTROWS(
			        SUMMARIZE(
			            FILTER(
			                'Snapshot',
			                VAR md = IF('Snapshot'[CompanySKey] = 2, d + 1, d)
			                RETURN 'Snapshot'[Quantity on Hand] > 0
			                    && md >= 'Snapshot'[Interval Start]
			                    && md <= COALESCE('Snapshot'[Interval Stop], DATE(9999, 12, 31))
			                    && 'Snapshot'[Has Item Match]
			                    && 'Snapshot'[Has Lot Match]
			                    && 'Snapshot'[Has Company Match]
			                    && 'Snapshot'[In Family Scope]
			            ),
			            'Snapshot'[Region],
			            'Snapshot'[Branch Plant],
			            'Snapshot'[Global Bulk Item],
			            'Snapshot'[Bulk Item],
			            'Snapshot'[2nd Item Number],
			            'Snapshot'[Stock Type Code],
			            'Snapshot'[GL Class Code],
			            'Snapshot'[Location],
			            'Snapshot'[Lot Number],
			            'Snapshot'[Supplier Lot Number],
			            'Snapshot'[Lot Status (Position)],
			            'Snapshot'[Master Planning Family],
			            'Snapshot'[Primary Unit of Measure],
			            'Snapshot'[On Hand Date],
			            'Snapshot'[Lot Expiry Date],
			            'Snapshot'[Memo Lot 1],
			            'Snapshot'[Memo Lot 2],
			            'Snapshot'[Commodity Class Description],
			            'Snapshot'[Commodity Sub Class Description]
			        )
			    )
		formatString: #,0
		displayFolder: Report Engine
		lineageTag: 14a1da07-0000-4000-8000-000000000087

