	column 'KG per Primary Unit (Dim)' =
			VAR itm = 'Snapshot'[Item Short ID]
			VAR bu = 'Snapshot'[Branch Plant]
			VAR exact = FILTER('UOM Conversion', 'UOM Conversion'[Item Short ID] = itm && 'UOM Conversion'[Branch Plant] = bu)
			VAR fallback = FILTER('UOM Conversion', 'UOM Conversion'[Item Short ID] = itm && 'UOM Conversion'[Branch Plant] = "")
			VAR bestExact = TOPN(1, exact, 'UOM Conversion'[Primary Preference], ASC, 'UOM Conversion'[From UOM], ASC)
			VAR bestFallback = TOPN(1, fallback, 'UOM Conversion'[Primary Preference], ASC, 'UOM Conversion'[From UOM], ASC)
			RETURN
			    IF(COUNTROWS(exact) > 0, MINX(bestExact, 'UOM Conversion'[KG per Primary Unit]), MINX(bestFallback, 'UOM Conversion'[KG per Primary Unit]))
		dataType: double
		displayFolder: Weights (KG-LB)
		lineageTag: 14a1da07-0000-4000-8000-000000000040
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'LB per Primary Unit (Dim)' =
			VAR itm = 'Snapshot'[Item Short ID]
			VAR bu = 'Snapshot'[Branch Plant]
			VAR exact = FILTER('UOM Conversion', 'UOM Conversion'[Item Short ID] = itm && 'UOM Conversion'[Branch Plant] = bu)
			VAR fallback = FILTER('UOM Conversion', 'UOM Conversion'[Item Short ID] = itm && 'UOM Conversion'[Branch Plant] = "")
			VAR bestExact = TOPN(1, exact, 'UOM Conversion'[Primary Preference], ASC, 'UOM Conversion'[From UOM], ASC)
			VAR bestFallback = TOPN(1, fallback, 'UOM Conversion'[Primary Preference], ASC, 'UOM Conversion'[From UOM], ASC)
			RETURN
			    IF(COUNTROWS(exact) > 0, MINX(bestExact, 'UOM Conversion'[LB per Primary Unit]), MINX(bestFallback, 'UOM Conversion'[LB per Primary Unit]))
		dataType: double
		displayFolder: Weights (KG-LB)
		lineageTag: 14a1da07-0000-4000-8000-000000000041
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Weight Source' = SWITCH(TRUE(), 'Snapshot'[Primary Unit of Measure] = "KG" || 'Snapshot'[Primary Unit of Measure] = "LB", "Constant (KG/LB primary)", 'Snapshot'[KG per Primary Unit (Dim)] < 0, "DW sentinel -1: x20 KG / x44 LB", ISBLANK('Snapshot'[KG per Primary Unit (Dim)]), "No conversion row", "Dim factor per primary unit")
		displayFolder: Weights (KG-LB)
		lineageTag: 14a1da07-0000-4000-8000-000000000042
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Quantity KGs' =
			VAR raw = 'Snapshot'[Quantity on Hand] * 'Snapshot'[KG per Primary Unit (Dim)]
			RETURN
			    SWITCH(
			        TRUE(),
			        'Snapshot'[Primary Unit of Measure] = "KG", 'Snapshot'[Quantity on Hand],
			        'Snapshot'[Primary Unit of Measure] = "LB", 'Snapshot'[Quantity on Hand] * 0.45359237,
			        raw < 0, -raw * 20,
			        raw
			    )
		displayFolder: Weights (KG-LB)
		lineageTag: 14a1da07-0000-4000-8000-000000000043
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Quantity LBs' =
			VAR raw = 'Snapshot'[Quantity on Hand] * 'Snapshot'[LB per Primary Unit (Dim)]
			RETURN
			    SWITCH(
			        TRUE(),
			        'Snapshot'[Primary Unit of Measure] = "LB", 'Snapshot'[Quantity on Hand],
			        'Snapshot'[Primary Unit of Measure] = "KG", 'Snapshot'[Quantity on Hand] * 2.20462262,
			        raw < 0, -raw * 44,
			        raw
			    )
		displayFolder: Weights (KG-LB)
		lineageTag: 14a1da07-0000-4000-8000-000000000044
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Quantity KGs (No Guard)' =
			SWITCH(
			    TRUE(),
			    'Snapshot'[Primary Unit of Measure] = "KG", 'Snapshot'[Quantity on Hand],
			    'Snapshot'[Primary Unit of Measure] = "LB", 'Snapshot'[Quantity on Hand] * 0.45359237,
			    'Snapshot'[Quantity on Hand] * 'Snapshot'[KG per Primary Unit (Dim)]
			)
		displayFolder: Weights (KG-LB)
		lineageTag: 14a1da07-0000-4000-8000-000000000045
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Quantity LBs (No Guard)' =
			SWITCH(
			    TRUE(),
			    'Snapshot'[Primary Unit of Measure] = "LB", 'Snapshot'[Quantity on Hand],
			    'Snapshot'[Primary Unit of Measure] = "KG", 'Snapshot'[Quantity on Hand] * 2.20462262,
			    'Snapshot'[Quantity on Hand] * 'Snapshot'[LB per Primary Unit (Dim)]
			)
		displayFolder: Weights (KG-LB)
		lineageTag: 14a1da07-0000-4000-8000-000000000046
		summarizeBy: none

		annotation SummarizationSetBy = User

