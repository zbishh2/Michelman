	measure 'QOH (SQL)' =
			CALCULATE(
			    SUM(Inventory[Quantity on Hand]),
			    TREATAS(VALUES('Snapshot'[Region]), Inventory[REGION]),
			    TREATAS(VALUES('Snapshot'[Branch Plant]), Inventory[Branch Plant]),
			    TREATAS(VALUES('Snapshot'[Location]), Inventory[Location]),
			    TREATAS(VALUES('Snapshot'[Lot Number]), Inventory[Lot Number]),
			    TREATAS(VALUES('Snapshot'[2nd Item Number]), Inventory[2nd Item Number])
			)
		formatString: #,0.00
