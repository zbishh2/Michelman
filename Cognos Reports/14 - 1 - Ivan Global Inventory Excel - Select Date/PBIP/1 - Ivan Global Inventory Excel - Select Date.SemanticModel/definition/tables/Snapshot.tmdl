	column 'Commodity Class Description'
		dataType: string
		displayFolder: Joined in SQL (Item Branch)
		lineageTag: 14a1da07-0000-4000-8000-0000000000a3
		summarizeBy: none
		sourceColumn: Commodity Class Description

		annotation SummarizationSetBy = Automatic

	column 'Commodity Sub Class Description'
		dataType: string
		displayFolder: Joined in SQL (Item Branch)
		lineageTag: 14a1da07-0000-4000-8000-0000000000a4
		summarizeBy: none
		sourceColumn: Commodity Sub Class Description

		annotation SummarizationSetBy = Automatic

	partition Snapshot = m
		mode: import
		source =
				let
				    Source = Sql.Database("EDWPROD", "EDW"),
				    WinStart = Date.ToText(Date.AddMonths(Date.From(DateTime.LocalNow()), -13), "yyyy-MM-dd"),
				    Data = Value.NativeQuery(
				        Source,
				        "
				        SET NOCOUNT ON;
				
				        SELECT z.ItemSKey, z.BU, z.StockType, z.MPF, z.CommodityClassDesc, z.CommoditySubClassDesc
				        INTO #ib
				        FROM (
				            SELECT ib.ItemSKey,
				                   ISNULL(LTRIM(RTRIM(ib.[Business Unit])), '') AS BU,
				                   ib.[Stocking Type]                  AS StockType,
				                   ib.[Master Planning Family]         AS MPF,
				                   ib.[Commodity Class Codes Desc]     AS CommodityClassDesc,
				                   ib.[Commodity Sub Class Codes Desc] AS CommoditySubClassDesc,
				                   ROW_NUMBER() OVER (PARTITION BY ib.ItemSKey, ISNULL(LTRIM(RTRIM(ib.[Business Unit])), '')
				                                      ORDER BY ib.ItemBranchSKey) AS rn
				            FROM BIQL.TbItemBranch ib
				        ) z
				        WHERE z.rn = 1;
				
				        CREATE UNIQUE CLUSTERED INDEX ix_ib ON #ib (ItemSKey, BU);
				
				        SELECT
				            snap.ItemSKey                             AS [ItemSKey],
				            snap.LotSKey                              AS [LotSKey],
				            snap.CompanySKey                          AS [CompanySKey],
				            snap.ItemCostSKey                         AS [ItemCostSKey],
				            snap.ItemNumShort                         AS [Item Short ID],
				            LTRIM(RTRIM(snap.BusinessUnit))           AS [Branch Plant],
				            LTRIM(RTRIM(snap.Location))               AS [Location],
				            LTRIM(RTRIM(snap.LotNum))                 AS [Lot Number],
				            snap.LotStatusCode                        AS [Lot Status (Position)],
				            snap.CategoryGLF41021                     AS [GL Class Code],
				            LTRIM(RTRIM(snap.UOMPrimary))             AS [Primary Unit of Measure],
				            snap.QuantityOnHandPrimaryUOM             AS [Quantity on Hand],
				            snap.AmountUnitCost                       AS [Unit Cost (Lot)],
				            snap.LastReceiptDate                      AS [Last Receipt Date],
				            snap.StartDate                            AS [Interval Start],
				            snap.StopDate                             AS [Interval Stop],
				            ib.StockType                              AS [Stock Type Code],
				            ib.MPF                                    AS [Master Planning Family],
				            ib.CommodityClassDesc                     AS [Commodity Class Description],
				            ib.CommoditySubClassDesc                  AS [Commodity Sub Class Description]
				        FROM dbo.FactInventorySnapshot_History snap
				            LEFT JOIN #ib ib ON ib.ItemSKey = snap.ItemSKey
				                            AND ib.BU = LTRIM(RTRIM(snap.BusinessUnit))
				        WHERE (snap.StopDate IS NULL OR snap.StopDate >= CAST('" & WinStart & "' AS date))
				          AND LTRIM(RTRIM(snap.BusinessUnit)) IN ('CINC','CIN2','CIN4','AUBA','AUB2','SING','SNG4','MUM3','SHAN')
				        ",
				        null,
				        [EnableFolding = false]
				    )
				in
				    Data

	annotation PBI_ResultType = Table

