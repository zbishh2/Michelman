table 'Escor Lot Info'
	lineageTag: 14a1a000-0000-4000-8000-000000000003

	column 'Branch Plant'
		dataType: string
		lineageTag: 14a10000-0000-4000-8000-00000000002e
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	column 'Bulk Item'
		dataType: string
		lineageTag: 14a10000-0000-4000-8000-00000000002f
		summarizeBy: none
		sourceColumn: Bulk Item

		annotation SummarizationSetBy = Automatic

	column '2nd Item Number'
		dataType: string
		lineageTag: 14a10000-0000-4000-8000-000000000030
		summarizeBy: none
		sourceColumn: 2nd Item Number

		annotation SummarizationSetBy = Automatic

	column 'Item Short ID'
		dataType: int64
		formatString: 0
		lineageTag: 14a10000-0000-4000-8000-000000000031
		summarizeBy: count
		sourceColumn: Item Short ID

		annotation SummarizationSetBy = Automatic

	column 'Lot Number'
		dataType: string
		lineageTag: 14a10000-0000-4000-8000-000000000032
		summarizeBy: none
		sourceColumn: Lot Number

		annotation SummarizationSetBy = Automatic

	column 'Supplier Lot Number'
		dataType: string
		lineageTag: 14a10000-0000-4000-8000-000000000033
		summarizeBy: none
		sourceColumn: Supplier Lot Number

		annotation SummarizationSetBy = Automatic

	column 'Memo Lot 1'
		dataType: string
		lineageTag: 14a10000-0000-4000-8000-000000000034
		summarizeBy: none
		sourceColumn: Memo Lot 1

		annotation SummarizationSetBy = Automatic

	column 'Memo Lot 2'
		dataType: string
		lineageTag: 14a10000-0000-4000-8000-000000000035
		summarizeBy: none
		sourceColumn: Memo Lot 2

		annotation SummarizationSetBy = Automatic

	column 'On Hand Date'
		dataType: dateTime
		formatString: d MMM, yyyy
		lineageTag: 14a10000-0000-4000-8000-000000000036
		summarizeBy: none
		sourceColumn: On Hand Date

		annotation SummarizationSetBy = Automatic

	partition 'Escor Lot Info' = m
		mode: import
		source =
				let
				    Source = Sql.Database("EDWPROD", "EDW"),
				    Data = Value.NativeQuery(
				        Source,
				        "
				        SELECT DISTINCT
				            LTRIM(RTRIM(lot.BusinessUnit))   AS [Branch Plant],
				            it.ItemBulk                      AS [Bulk Item],
				            it.ItemNum2nd                    AS [2nd Item Number],
				            lot.ItemNumShort                 AS [Item Short ID],
				            LTRIM(RTRIM(lot.LotNum))         AS [Lot Number],
				            lot.SupplierLotNum               AS [Supplier Lot Number],
				            lot.MemoLot1                     AS [Memo Lot 1],
				            lot.MemoLot2                     AS [Memo Lot 2],
				            lot.OnHandDate                   AS [On Hand Date]
				        FROM BIQL.DimLot lot
				            INNER JOIN BIQL.DimItem it ON it.ItemSKey = lot.ItemSKey
				        WHERE it.ItemBulk IN ('ESC5200','ESC5200.E','ESC5200.S')
				        ",
				        null,
				        [EnableFolding = true]
				    )
				in
				    Data

	annotation PBI_ResultType = Table

