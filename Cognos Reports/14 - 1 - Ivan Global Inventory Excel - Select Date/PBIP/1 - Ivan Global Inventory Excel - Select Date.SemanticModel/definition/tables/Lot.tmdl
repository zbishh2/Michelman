		summarizeBy: none
		sourceColumn: Sell by Date

		annotation SummarizationSetBy = Automatic

	column 'Item Bulk' = LOOKUPVALUE('Item'[Bulk Item], 'Item'[ItemSKey], 'Lot'[ItemSKey])
		lineageTag: 14a1da03-0000-4000-8000-00000000000d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Item 2nd Number' = LOOKUPVALUE('Item'[2nd Item Number], 'Item'[ItemSKey], 'Lot'[ItemSKey])
		lineageTag: 14a1da03-0000-4000-8000-00000000000e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is ESC Family' = 'Lot'[Item Bulk] IN {"ESC5200", "ESC5200.E", "ESC5200.S"}
		lineageTag: 14a1da03-0000-4000-8000-00000000000f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Lot = m
		mode: import
		source =
				let
				    Source = Sql.Database("EDWPROD", "EDW"),
				    Data = Value.NativeQuery(
				        Source,
				        "
				        SELECT
				            lot.LotSKey                       AS [LotSKey],
				            lot.ItemSKey                      AS [ItemSKey],
				            lot.ItemNumShort                  AS [Item Short ID],
				            LTRIM(RTRIM(lot.BusinessUnit))    AS [Branch Plant],
				            LTRIM(RTRIM(lot.LotNum))          AS [Lot Number],
				            lot.SupplierLotNum                AS [Supplier Lot Number],
				            lot.LotStatusCode                 AS [Lot Status (Master)],
				            lot.MemoLot1                      AS [Memo Lot 1],
				            lot.MemoLot2                      AS [Memo Lot 2],
				            lot.OnHandDate                    AS [On Hand Date],
				            lot.LotExpirationDate             AS [Lot Expiry Date],
				            lot.SellByDate                    AS [Sell by Date]
				        FROM BIQL.DimLot lot
				        ",
				        null,
				        [EnableFolding = true]
				    )
				in
				    Data

	annotation PBI_ResultType = Table

