model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Inventory", "Escor Inventory", "Escor Lot Info", "Last Refreshed"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Inventory
ref table 'Escor Inventory'
ref table 'Escor Lot Info'
ref table 'Select Date'
ref table 'Last Refreshed'

ref cultureInfo en-US
