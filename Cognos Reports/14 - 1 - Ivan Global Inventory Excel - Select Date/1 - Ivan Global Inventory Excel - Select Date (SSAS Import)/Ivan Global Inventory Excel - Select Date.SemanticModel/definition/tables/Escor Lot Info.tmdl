table 'Escor Lot Info'
	lineageTag: 14b10000-0000-4000-8000-000000000032

	column 'Branch Plant'
		dataType: string
		lineageTag: 14b10000-0000-4000-8000-000000000033
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	column 'Bulk Item'
		dataType: string
		lineageTag: 14b10000-0000-4000-8000-000000000034
		summarizeBy: none
		sourceColumn: Bulk Item

		annotation SummarizationSetBy = Automatic

	column '2nd Item Number'
		dataType: string
		lineageTag: 14b10000-0000-4000-8000-000000000035
		summarizeBy: none
		sourceColumn: 2nd Item Number

		annotation SummarizationSetBy = Automatic

	column 'Item Short ID'
		dataType: int64
		formatString: 0
		lineageTag: 14b10000-0000-4000-8000-000000000036
		summarizeBy: none
		sourceColumn: Item Short ID

		annotation SummarizationSetBy = Automatic

	column 'Lot Number'
		dataType: string
		lineageTag: 14b10000-0000-4000-8000-000000000037
		summarizeBy: none
		sourceColumn: Lot Number

		annotation SummarizationSetBy = Automatic

	column 'Supplier Lot Number'
		dataType: string
		lineageTag: 14b10000-0000-4000-8000-000000000038
		summarizeBy: none
		sourceColumn: Supplier Lot Number

		annotation SummarizationSetBy = Automatic

	column 'Memo Lot 1'
		dataType: string
		lineageTag: 14b10000-0000-4000-8000-000000000039
		summarizeBy: none
		sourceColumn: Memo Lot 1

		annotation SummarizationSetBy = Automatic

	column 'Memo Lot 2'
		dataType: string
		lineageTag: 14b10000-0000-4000-8000-00000000003a
		summarizeBy: none
		sourceColumn: Memo Lot 2

		annotation SummarizationSetBy = Automatic

	column 'On Hand Date'
		dataType: dateTime
		formatString: d MMM, yyyy
		lineageTag: 14b10000-0000-4000-8000-00000000003b
		summarizeBy: none
		sourceColumn: On Hand Date

		annotation SummarizationSetBy = Automatic

	partition 'Escor Lot Info' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular_ISH",
				        [
				            Query = "
				EVALUATE
				VAR EscorItemBranch =
				    DISTINCT (
				        SELECTCOLUMNS (
				            FILTER (
				                'Item Branch',
				                TRIM ( 'Item Branch'[Item Num Bulk] )
				                    IN { ""ESC5200"", ""ESC5200.E"", ""ESC5200.S"" }
				            ),
				            ""@ItemBranchISKey"", 'Item Branch'[ItemBranchISKey] & """",
				            ""Bulk Item"", TRIM ( 'Item Branch'[Item Num Bulk] ),
				            ""2nd Item Number"", TRIM ( 'Item Branch'[Item Num 2nd] )
				        )
				    )
				VAR EscorLots =
				    SELECTCOLUMNS (
				        'Lot',
				        ""@ItemBranchISKey"", 'Lot'[ItemBranchISKey] & """",
				        ""Branch Plant"", TRIM ( 'Lot'[Business Unit] ),
				        ""Item Short ID"", 'Lot'[Item Num Short],
				        ""Lot Number"", TRIM ( 'Lot'[Lot Num] ),
				        ""Supplier Lot Number"", TRIM ( 'Lot'[Supplier Lot Num] ),
				        ""Memo Lot 1"", 'Lot'[Memo Lot 1],
				        ""Memo Lot 2"", 'Lot'[Memo Lot 2],
				        ""On Hand Date"", 'Lot'[On Hand Date]
				    )
				RETURN
				    DISTINCT (
				        SELECTCOLUMNS (
				            NATURALINNERJOIN ( EscorItemBranch, EscorLots ),
				            ""Branch Plant"", [Branch Plant],
				            ""Bulk Item"", [Bulk Item],
				            ""2nd Item Number"", [2nd Item Number],
				            ""Item Short ID"", [Item Short ID],
				            ""Lot Number"", [Lot Number],
				            ""Supplier Lot Number"", [Supplier Lot Number],
				            ""Memo Lot 1"", [Memo Lot 1],
				            ""Memo Lot 2"", [Memo Lot 2],
				            ""On Hand Date"", [On Hand Date]
				        )
				    )
				ORDER BY [On Hand Date]
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table
