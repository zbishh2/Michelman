/// Forecast rows for the 70 CM bulk items from the first of the current month to the end of the month 450 days out, SSASPROD / BIQLTabular 'FactForecast'.
table Forecast
	lineageTag: a8135eec-821d-595d-8cc1-bb40e43a95d0

	measure 'Current Forecast' = SUM ( Forecast[Current Forecast (Line)] )
		formatString: #,##0
		lineageTag: ad26b2ba-565d-50eb-aa79-27dec0fe743d

	measure 'Current Forecast LB' = SUM ( Forecast[Current Forecast LB (Line)] )
		formatString: #,##0
		lineageTag: 346605ff-a296-5d0d-b7d9-2d35afd5cde5

	measure 'Current Forecast KG' = SUM ( Forecast[Current Forecast KG (Line)] )
		formatString: #,##0
		lineageTag: e01e4eed-32a6-5056-9061-6fe353c33aef

	/// Carries leading zeros ('00010'); stays text.
	column 'Company Code'
		dataType: string
		lineageTag: 7d514339-ad44-5554-892c-ca54a03d2a8d
		summarizeBy: none
		sourceColumn: Company Code

		annotation SummarizationSetBy = User

	column 'Branch Plant'
		dataType: string
		lineageTag: 2bc8954a-f4c1-588a-94a9-9304f818d34d
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = User

	column 'Global Bulk Item'
		dataType: string
		lineageTag: 33b9c942-985d-5558-80cc-fb4e450cebff
		summarizeBy: none
		sourceColumn: Global Bulk Item

		annotation SummarizationSetBy = User

	column 'Bulk Item'
		dataType: string
		lineageTag: bd5c9a38-99ae-5571-8883-46973c722313
		summarizeBy: none
		sourceColumn: Bulk Item

		annotation SummarizationSetBy = User

	column '2nd Item Number'
		dataType: string
		lineageTag: 5a94497d-6f1e-56fc-94e1-063888fa7a2b
		summarizeBy: none
		sourceColumn: 2nd Item Number

		annotation SummarizationSetBy = User

	column 'Item Description 1'
		dataType: string
		lineageTag: 21f001d3-c343-547d-9164-f0b2cdacb02c
		summarizeBy: none
		sourceColumn: Item Description 1

		annotation SummarizationSetBy = User

	/// Blank where the item carries none (the legacy warehouse shows '-').
	column 'Item Description 2'
		dataType: string
		lineageTag: 7578d51e-d4bc-50b5-8ecb-b60b43eabd51
		summarizeBy: none
		sourceColumn: Item Description 2

		annotation SummarizationSetBy = User

	column 'Requested Date'
		dataType: dateTime
		formatString: MMM d, yyyy
		lineageTag: 7786c8b5-9522-5d7a-aac0-5b48bf11edd8
		summarizeBy: none
		sourceColumn: Requested Date

		annotation SummarizationSetBy = User

	/// The customer's commission territory manager from EDW (field-level fallback: FactForecast carries a TM for FC-group customers only); blank where the customer has no FC or CS assignment (the legacy warehouse shows 'Not Available').
	column 'TM Name' = LOOKUPVALUE ( 'TM Assignment'[TM Name], 'TM Assignment'[Customer Code], Forecast[Customer Code] )
		dataType: string
		lineageTag: 47b1b158-7eec-555c-a666-f9f3fc23f962
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Line-grain input to [Current Forecast].
	column 'Current Forecast (Line)'
		dataType: double
		formatString: #,##0
		isHidden
		lineageTag: 05c7a6dc-e1eb-549b-a5f0-51b745bdb7df
		summarizeBy: none
		sourceColumn: Current Forecast (Line)

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	column 'Primary UOM'
		dataType: string
		lineageTag: 40eb62ac-36af-56cf-8530-d30388145b73
		summarizeBy: none
		sourceColumn: Primary UOM

		annotation SummarizationSetBy = User

	/// Line-grain input to [Current Forecast LB].
	column 'Current Forecast LB (Line)'
		dataType: double
		formatString: #,##0
		isHidden
		lineageTag: 777fc3ff-894f-5b83-91bc-223d1ada908d
		summarizeBy: none
		sourceColumn: Current Forecast LB (Line)

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Line-grain input to [Current Forecast KG].
	column 'Current Forecast KG (Line)'
		dataType: double
		formatString: #,##0
		isHidden
		lineageTag: 48e8dfa9-fc15-51cc-81aa-ef059cc09a13
		summarizeBy: none
		sourceColumn: Current Forecast KG (Line)

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Requested date.
	column Date
		dataType: dateTime
		formatString: MMM d, yyyy
		lineageTag: 23541e96-8bb6-56e5-a386-c2f997f7daaa
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = User

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 9c762a31-7dea-5ebc-9ce5-78d797f4afef
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column Month
		dataType: int64
		formatString: 0
		lineageTag: 95c9f581-5ff6-5d32-baec-6cd51db62a73
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = User

	/// Identifier - never aggregate.
	column 'Customer Code'
		dataType: int64
		formatString: 0
		lineageTag: add8a2ef-6c38-5432-9545-689e82ffd65f
		summarizeBy: none
		sourceColumn: Customer Code

		annotation SummarizationSetBy = User

	column 'Customer Name'
		dataType: string
		lineageTag: 8b470ab4-8273-5618-a01a-0a8541ba473c
		summarizeBy: none
		sourceColumn: Customer Name

		annotation SummarizationSetBy = User

	column 'Global Parent Name'
		dataType: string
		lineageTag: 901037c3-09f1-5bc0-8855-e53858d8725b
		summarizeBy: none
		sourceColumn: Global Parent Name

		annotation SummarizationSetBy = User

	column 'Chemist Name'
		dataType: string
		lineageTag: 2d42364d-3543-504f-b902-d887cc7a6ff9
		summarizeBy: none
		sourceColumn: Chemist Name

		annotation SummarizationSetBy = User

	partition Forecast = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				VAR Bulks = { ""161017CX"", ""161190PX"", ""171143PX"", ""171228PX.E"", ""181020CX.E"", ""181136IX"", ""181192IX"", ""181193EU.E"", ""191011CX"", ""191026CX.E"", ""191245PX"", ""23409A"", ""ABEX2525"", ""APT10"", ""APT11"", ""DMAEMA"", ""EMA3065"", ""ET2012.E"", ""ET2022.E"", ""ET4075.E"", ""ET440.E"", ""FERSUL7W"", ""HP1432AT"", ""HP1632"", ""MD4020"", ""MD4020C"", ""MD4020S"", ""MD4021"", ""MD4021C"", ""MD4021S"", ""MD4022"", ""MD4022C"", ""MD4023"", ""MD4023C"", ""MDU20"", ""MDU2012.E"", ""MDU2012B.E"", ""MDU4075.E"", ""MDU4075B.E"", ""MDU440.E"", ""MDU440B.E"", ""MPEG2000"", ""MW40504"", ""MW40514"", ""NP4LF"", ""NP4LF.S"", ""OMS"", ""PUD1.E"", ""STODSO"", ""U1001"", ""U101"", ""U201"", ""U2022"", ""U2022EU.E"", ""U2023"", ""U204"", ""U204EU.E"", ""U470"", ""U501"", ""U501B"", ""U502"", ""U502.E"", ""U502X1.E"", ""U601"", ""U701"", ""U802"", ""U802.E"", ""WAV501"", ""WD40"", ""WD40T"" }
				VAR WindowStart = DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), 1 )
				VAR WindowEnd = EOMONTH ( TODAY () + 450, 0 )
				VAR Forecasts =
				    FILTER (
				        FactForecast,
				        TRIM ( RELATED ( 'Item Branch'[Item Bulk] ) ) IN Bulks
				            && FactForecast[RequestedDate] >= WindowStart
				            && FactForecast[RequestedDate] <= WindowEnd
				            && FactForecast[QuantityForecast] > 0
				    )
				RETURN
				    SELECTCOLUMNS (
				        Forecasts,
				        ""Company Code"", FactForecast[Company],
				        ""Branch Plant"", TRIM ( FactForecast[BusinessUnit] ),
				        ""Global Bulk Item"", FactForecast[Global Bulk],
				        ""Bulk Item"", FactForecast[Bulk Item],
				        ""2nd Item Number"", FactForecast[ItemNum2nd],
				        ""Item Description 1"", RELATED ( 'Item Branch'[Item Num 2nd Desc] ),
				        ""Item Description 2"", RELATED ( 'Item Branch'[Description 2] ),
				        ""Requested Date"", FactForecast[RequestedDate],
				        ""Current Forecast (Line)"", FactForecast[QuantityForecast],
				        ""Primary UOM"", FactForecast[UOM Primary],
				        ""Current Forecast LB (Line)"", FactForecast[QuantityForecastLB],
				        ""Current Forecast KG (Line)"", FactForecast[QuantityForecastKG],
				        ""Date"", FactForecast[RequestedDate],
				        ""Year"", YEAR ( FactForecast[RequestedDate] ),
				        ""Month"", MONTH ( FactForecast[RequestedDate] ),
				        ""Customer Code"", FactForecast[AddressNum],
				        ""Customer Name"", RELATED ( 'Address'[Address Name] ),
				        ""Global Parent Name"", RELATED ( 'Address'[Global Parent Desc] ),
				        ""Chemist Name"", RELATED ( 'Item Branch'[Chemist Name] )
				    )
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table
