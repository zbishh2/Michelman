	/// Identifier - never aggregate.
	column 'Order Number'
		dataType: int64
		formatString: 0
		lineageTag: 76f2be28-98f4-5780-87ad-e0a8ea801c3b
		summarizeBy: none
		sourceColumn: Order Number

		annotation SummarizationSetBy = User

	/// Identifier - never aggregate.
	column 'Line Number'
		dataType: double
		lineageTag: 6da29ba1-ff4e-5801-9d73-1719f5a3af5c
		summarizeBy: none
		sourceColumn: Line Number

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	column 'Open Indicator'
		dataType: string
		lineageTag: 134b208d-dedc-52cb-947b-99f2a72973d7
		summarizeBy: none
		sourceColumn: Open Indicator

		annotation SummarizationSetBy = User

	column 'Global Bulk Item'
		dataType: string
		lineageTag: da794c59-2d15-520e-af2f-1acbec652c05
		summarizeBy: none
		sourceColumn: Global Bulk Item

		annotation SummarizationSetBy = User

	column 'Bulk Item'
		dataType: string
		lineageTag: 220fc6ca-0561-51bf-83af-30654674d96e
		summarizeBy: none
		sourceColumn: Bulk Item

		annotation SummarizationSetBy = User

	column '2nd Item Number'
		dataType: string
		lineageTag: ea82b0ef-58e1-53a5-ba76-0795bcc9fb25
		summarizeBy: none
		sourceColumn: 2nd Item Number

		annotation SummarizationSetBy = User

	column 'Description 1'
		dataType: string
		lineageTag: 6c7bd1d9-3c90-5080-8766-6c5ef795fd39
		summarizeBy: none
		sourceColumn: Description 1

		annotation SummarizationSetBy = User

	/// Blank where the sales line carries none (the legacy warehouse shows '-').
	column 'Description 2'
		dataType: string
		lineageTag: b3cd59fa-0cdb-5570-bc3b-7e69a822418c
		summarizeBy: none
		sourceColumn: Description 2

		annotation SummarizationSetBy = User

	column 'Freight Handling Code'
		dataType: string
		lineageTag: 35e7d473-2ee6-5f30-9a5c-f603c8a33f84
		summarizeBy: none
		sourceColumn: Freight Handling Code

		annotation SummarizationSetBy = User

	column 'Next Status'
		dataType: string
		lineageTag: b07b2ca8-3d72-5812-821a-2f97abd32b64
		summarizeBy: none
		sourceColumn: Next Status

		annotation SummarizationSetBy = User

	/// Line-grain input to [Order Net Amount USD]: the cube's net amount USD.
	column 'Order Net Amount USD (Line)'
		dataType: double
		formatString: #,##0
		isHidden
		lineageTag: 71b06371-800d-5136-919a-a65bec5fb603
		summarizeBy: none
		sourceColumn: Order Net Amount USD (Line)

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Line-grain input to [Order Net Amount EUR]: native EUR for EUR-currency companies, otherwise USD at the month-end EUR/USD rate A of the GL date.
	column 'Order Net Amount EUR (Line)'
		dataType: double
		formatString: #,##0
		isHidden
		lineageTag: 5a6c0fdf-162e-5bf4-ad44-cbf6d77dc3b6
		summarizeBy: none
		sourceColumn: Order Net Amount EUR (Line)

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Line-grain input to [Ordered Quantity LBs].
	column 'Ordered Quantity LBs (Line)'
		dataType: double
		formatString: #,##0
		isHidden
		lineageTag: cb559e9a-79ea-5c30-896a-a90ebccd9012
		summarizeBy: none
		sourceColumn: Ordered Quantity LBs (Line)

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Line-grain input to [Ordered Quantity KGs].
	column 'Ordered Quantity KGs (Line)'
		dataType: double
		formatString: #,##0
		isHidden
