/// Sales lines for the 70 CM bulk items since 2020, SSASPROD / BIQLTabular 'Sales'.
table Shipments
	lineageTag: 8c6563fa-597c-56fa-951d-50a9929ddf9c

	measure 'Order Net Amount USD' = SUM ( Shipments[Order Net Amount USD (Line)] )
		formatString: #,##0
		lineageTag: 3584783b-3cb1-5aac-816d-13e4b07a6a8b

	measure 'Order Net Amount EUR' = SUM ( Shipments[Order Net Amount EUR (Line)] )
		formatString: #,##0
		lineageTag: 4f3bc9b6-67ca-5a23-9fa8-386dd4d0c2e4

	measure 'Ordered Quantity LBs' = SUM ( Shipments[Ordered Quantity LBs (Line)] )
		formatString: #,##0
		lineageTag: b2900b7b-2c3a-5fdd-b2ec-9e8a8595c6b2

	measure 'Ordered Quantity KGs' = SUM ( Shipments[Ordered Quantity KGs (Line)] )
		formatString: #,##0
		lineageTag: de77aee2-62c2-5234-8e2b-d0d7d7886f44

	/// Carries leading zeros ('00010'); stays text.
	column 'Order Company'
		dataType: string
		lineageTag: dc41f039-b8d8-562e-906c-1cd41b1737b3
		summarizeBy: none
		sourceColumn: Order Company

		annotation SummarizationSetBy = User

	column 'Branch Plant'
