table BOM
	lineageTag: 1724e733-6e79-41bb-853c-f74462700133

	column 'Branch Plant'
		dataType: string
		lineageTag: 12745e2c-046b-473b-86f2-3bef25b6cb04
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	column 'Component Quantity'
		dataType: double
		lineageTag: 1f6641dc-2999-4da5-80dc-508e91cdd4ab
		summarizeBy: sum
		sourceColumn: Component Quantity

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Parent 2nd Item Number'
		dataType: string
		lineageTag: 0164e5d2-0809-4d27-b7a6-85033e115366
		summarizeBy: none
		sourceColumn: Parent 2nd Item Number

		annotation SummarizationSetBy = Automatic

	column '2nd Item Number'
		dataType: string
		lineageTag: 4a26a0cf-b7d4-4a0e-9074-e3e63b20e091
		summarizeBy: none
		sourceColumn: 2nd Item Number

		annotation SummarizationSetBy = Automatic

	column 'Bulk Item'
		dataType: string
		lineageTag: 3fe325cc-c5bd-47ff-943f-0770209af82c
		summarizeBy: none
		sourceColumn: Bulk Item

		annotation SummarizationSetBy = Automatic

	column 'Global Bulk Item'
		dataType: string
		lineageTag: ea874237-5438-49cb-ab67-22f648d1663c
		summarizeBy: none
		sourceColumn: Global Bulk Item

		annotation SummarizationSetBy = Automatic

	partition BOM = m
		mode: import
		source =
				let
				    Source = Sql.Database("ODSPROD", "ODS", [Query="/*#(lf)Staged multi-level BOM (IXTBM='M') as-of a point in time.#(lf)#(lf)Preserves:#(lf)- CURRENT rows effective as-of @AsOfNow#(lf)- PAST rows based on latest ParentLastThru per (Parent, Branch), then keeps only edges not present in CURRENT#(lf)- Explosion math: ResolvedComponentQty cascades down#(lf)- LogicalParentQty: sum ParentQty across DISTINCT ParentOccKey#(lf)- Display rules:#(lf)  LevelDown=0 => Parent Quantity = 0, Original Quantity = Component Qty Raw (your convention)#(lf)  LevelDown>0 => Parent Quantity = LogicalParentQty, Original Quantity = ComponentQtyRaw / LogicalParentQty#(lf)#(lf)*/#(lf)#(lf)-------------------------------#(lf)-- Parameters (edit as needed)#(lf)-------------------------------#(lf)DECLARE @AsOfDate          DATE          = NULL;             -- e.g., '2026-02-13'; NULL = GETDATE()#(lf)DECLARE @Branches          NVARCHAR(MAX) = N'CINC,CIN2,CIN4,COLR';#(lf)DECLARE @ExcludeStockTypes NVARCHAR(MAX) = N'O,I';              -- e.g., N'O'; use N'' to disable exclusions#(lf)DECLARE @RootItem2ndFilter NVARCHAR(30)  = NULL;              -- optional: e.g. N'MP4983R' (NULL = all roots)#(lf)#(lf)-- Compute as-of timestamp (end of @AsOfDate if provided)#(lf)DECLARE @AsOfNow DATETIME =#(lf)    COALESCE(#(lf)        CASE WHEN @AsOfDate IS NULL THEN NULL#(lf)             ELSE DATEADD(MILLISECOND, -3, DATEADD(DAY, 1, CAST(@AsOfDate AS DATETIME)))#(lf)        END,#(lf)        GETDATE()#(lf)    );#(lf)#(lf)------------------------------------------------------------#(lf)-- 0) Materialise branch + stocktype filters (collation-safe)#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #BranchFilter;#(lf)CREATE TABLE #BranchFilter#(lf)(#(lf)    Branch NVARCHAR(20) COLLATE DATABASE_DEFAULT NOT NULL PRIMARY KEY#(lf));#(lf)#(lf)INSERT INTO #BranchFilter(Branch)#(lf)SELECT TRIM(value) COLLATE DATABASE_DEFAULT#(lf)FROM STRING_SPLIT(@Branches, ',');#(lf)#(lf)DROP TABLE IF EXISTS #ExcludeStockType;#(lf)CREATE TABLE #ExcludeStockType#(lf)(#(lf)    StockType NVARCHAR(10) COLLATE DATABASE_DEFAULT NOT NULL PRIMARY KEY#(lf));#(lf)#(lf)IF @ExcludeStockTypes <> N''#(lf)BEGIN#(lf)    INSERT INTO #ExcludeStockType(StockType)#(lf)    SELECT TRIM(value) COLLATE DATABASE_DEFAULT#(lf)    FROM STRING_SPLIT(@ExcludeStockTypes, ',');#(lf)END;#(lf)#(lf)------------------------------------------------------------#(lf)-- 1) CURRENT snapshot of F3002 (dates computed ONCE)#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #F3002_Current;#(lf)#(lf)SELECT#(lf)    TRIM(B.IXMMCU) COLLATE DATABASE_DEFAULT AS Branch,#(lf)    CAST(B.IXKIT AS DECIMAL(15,0)) AS ParentItemId,#(lf)    CAST(B.IXITM AS DECIMAL(15,0)) AS ComponentItemId,#(lf)    CAST(B.IXLITM AS NVARCHAR(30)) COLLATE DATABASE_DEFAULT AS ComponentItem2nd,#(lf)    CAST(CAST(B.IXQNTY AS DECIMAL(18,0)) / 1000000.0 AS DECIMAL(38,12)) AS ComponentQty,#(lf)    CAST(B.IXOPSQ AS VARCHAR(20)) COLLATE DATABASE_DEFAULT AS OperSeq,#(lf)    dbo.From_JDE_Date(B.IXEFFF) AS EffectiveFrom,#(lf)    dbo.From_JDE_Date(B.IXEFFT) AS EffectiveThru#(lf)INTO #F3002_Current#(lf)FROM PRODDTA.F3002 B#(lf)WHERE B.IXTBM = 'M'#(lf)  --AND B.IXQNTY > 0#(lf)  AND B.IXMMCU NOT LIKE '%LAB%'#(lf)  AND TRIM(B.IXMMCU) COLLATE DATABASE_DEFAULT IN (SELECT Branch FROM #BranchFilter)#(lf)  AND dbo.From_JDE_Date(B.IXEFFF) <= @AsOfNow#(lf)  AND dbo.From_JDE_Date(B.IXEFFT)  > @AsOfNow;#(lf)#(lf)CREATE CLUSTERED INDEX CX_F3002C_Parent ON #F3002_Current (Branch, ParentItemId);#(lf)CREATE NONCLUSTERED INDEX IX_F3002C_Component ON #F3002_Current (Branch, ComponentItemId);#(lf)#(lf)------------------------------------------------------------#(lf)-- 2) PAST baseline per (Parent, Branch) + rows covering baseline#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #MaxParentThru;#(lf)#(lf)SELECT#(lf)    TRIM(B.IXMMCU) COLLATE DATABASE_DEFAULT AS Branch,#(lf)    CAST(B.IXKIT AS DECIMAL(15,0)) AS ParentItemId,#(lf)    MAX(dbo.From_JDE_Date(B.IXEFFT)) AS ParentLastThru#(lf)INTO #MaxParentThru#(lf)FROM PRODDTA.F3002 B#(lf)WHERE B.IXTBM = 'M'#(lf)  AND B.IXMMCU NOT LIKE '%LAB%'#(lf)  AND TRIM(B.IXMMCU) COLLATE DATABASE_DEFAULT IN (SELECT Branch FROM #BranchFilter)#(lf)  AND dbo.From_JDE_Date(B.IXEFFT) <= @AsOfNow#(lf)GROUP BY TRIM(B.IXMMCU), B.IXKIT;#(lf)#(lf)CREATE CLUSTERED INDEX CX_MaxThru ON #MaxParentThru (Branch, ParentItemId);#(lf)#(lf)DROP TABLE IF EXISTS #F3002_Past;#(lf)#(lf)SELECT#(lf)    TRIM(B.IXMMCU) COLLATE DATABASE_DEFAULT AS Branch,#(lf)    CAST(B.IXKIT AS DECIMAL(15,0)) AS ParentItemId,#(lf)    CAST(B.IXITM AS DECIMAL(15,0)) AS ComponentItemId,#(lf)    CAST(B.IXLITM AS NVARCHAR(30)) COLLATE DATABASE_DEFAULT AS ComponentItem2nd,#(lf)    CAST(CAST(B.IXQNTY AS DECIMAL(18,0)) / 1000000.0 AS DECIMAL(38,12)) AS ComponentQty,#(lf)    CAST(B.IXOPSQ AS VARCHAR(20)) COLLATE DATABASE_DEFAULT AS OperSeq,#(lf)    dbo.From_JDE_Date(B.IXEFFF) AS EffectiveFrom,#(lf)    dbo.From_JDE_Date(B.IXEFFT) AS EffectiveThru,#(lf)    M.ParentLastThru            AS BaselineThru#(lf)INTO #F3002_Past#(lf)FROM PRODDTA.F3002 B#(lf)JOIN #MaxParentThru M#(lf)  ON M.Branch = TRIM(B.IXMMCU) COLLATE DATABASE_DEFAULT#(lf) AND M.ParentItemId = B.IXKIT#(lf)WHERE B.IXTBM = 'M'#(lf)  --AND B.IXQNTY > 0#(lf)  AND B.IXMMCU NOT LIKE '%LAB%'#(lf)  AND TRIM(B.IXMMCU) COLLATE DATABASE_DEFAULT IN (SELECT Branch FROM #BranchFilter)#(lf)  AND dbo.From_JDE_Date(B.IXEFFF) <= M.ParentLastThru#(lf)  AND dbo.From_JDE_Date(B.IXEFFT) >= M.ParentLastThru;#(lf)#(lf)CREATE CLUSTERED INDEX CX_F3002P_Parent ON #F3002_Past (Branch, ParentItemId);#(lf)CREATE NONCLUSTERED INDEX IX_F3002P_Component ON #F3002_Past (Branch, ComponentItemId);#(lf)#(lf)------------------------------------------------------------#(lf)-- 3) Determine allowed roots (stock type exclusion preserved)#(lf)--    Roots are current parents that exist in current snapshot.#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #RootsAllowed;#(lf)#(lf)SELECT DISTINCT#(lf)    C.Branch,#(lf)    C.ParentItemId AS RootItemId,#(lf)    CAST(PIM.IMLITM AS NVARCHAR(30)) COLLATE DATABASE_DEFAULT AS RootItem2nd#(lf)INTO #RootsAllowed#(lf)FROM #F3002_Current C#(lf)JOIN PRODDTA.F4101 PIM#(lf)  ON PIM.IMITM = C.ParentItemId#(lf)JOIN PRODDTA.F4102 IMB_ROOT#(lf)  ON IMB_ROOT.IBITM = C.ParentItemId          -- ? numeric join (best)#(lf) AND TRIM(IMB_ROOT.IBMCU) COLLATE DATABASE_DEFAULT = C.Branch#(lf)WHERE PIM.IMLITM NOT LIKE '%-%'#(lf)  AND (#(lf)        @ExcludeStockTypes = N'' OR#(lf)        TRIM(IMB_ROOT.IBSTKT) COLLATE DATABASE_DEFAULT NOT IN (SELECT StockType FROM #ExcludeStockType)#(lf)      )#(lf)  AND (@RootItem2ndFilter IS NULL OR PIM.IMLITM = @RootItem2ndFilter);#(lf)#(lf)CREATE CLUSTERED INDEX CX_RootsAllowed ON #RootsAllowed (Branch, RootItemId);#(lf)#(lf)------------------------------------------------------------#(lf)-- 4) Create BOM staging tables (collation-safe schema)#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #BOM_Current;#(lf)CREATE TABLE #BOM_Current#(lf)(#(lf)    Branch               NVARCHAR(20) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    BOM_Level            INT NOT NULL,#(lf)    RootItemId           DECIMAL(15,0) NOT NULL,#(lf)    RootItem2nd          NVARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)#(lf)    ParentItemId         DECIMAL(15,0) NOT NULL,#(lf)    ParentItem2nd        NVARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    ParentQty            DECIMAL(38,12) NOT NULL,#(lf)#(lf)    ComponentItemId      DECIMAL(15,0) NOT NULL,#(lf)    ComponentItem2nd     NVARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    ComponentQty         DECIMAL(38,12) NOT NULL,#(lf)    ResolvedComponentQty DECIMAL(38,12) NOT NULL,#(lf)#(lf)    EffectiveFrom        DATETIME NOT NULL,#(lf)    EffectiveThru        DATETIME NOT NULL,#(lf)    BaselineThru         DATETIME NULL,#(lf)#(lf)    ParentPathNoQty      VARCHAR(600) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    StructPathNoQty      VARCHAR(600) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    ParentOccKey         VARCHAR(800) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    StructPathQty        VARCHAR(800) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)#(lf)    DataSetTag           VARCHAR(10)  COLLATE DATABASE_DEFAULT NOT NULL#(lf));#(lf)#(lf)DROP TABLE IF EXISTS #BOM_Past;#(lf)CREATE TABLE #BOM_Past#(lf)(#(lf)    Branch               NVARCHAR(20) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    BOM_Level            INT NOT NULL,#(lf)    RootItemId           DECIMAL(15,0) NOT NULL,#(lf)    RootItem2nd          NVARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)#(lf)    ParentItemId         DECIMAL(15,0) NOT NULL,#(lf)    ParentItem2nd        NVARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    ParentQty            DECIMAL(38,12) NOT NULL,#(lf)#(lf)    ComponentItemId      DECIMAL(15,0) NOT NULL,#(lf)    ComponentItem2nd     NVARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    ComponentQty         DECIMAL(38,12) NOT NULL,#(lf)    ResolvedComponentQty DECIMAL(38,12) NOT NULL,#(lf)#(lf)    EffectiveFrom        DATETIME NOT NULL,#(lf)    EffectiveThru        DATETIME NOT NULL,#(lf)    BaselineThru         DATETIME NOT NULL,#(lf)#(lf)    ParentPathNoQty      VARCHAR(600) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    StructPathNoQty      VARCHAR(600) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    ParentOccKey         VARCHAR(800) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)    StructPathQty        VARCHAR(800) COLLATE DATABASE_DEFAULT NOT NULL,#(lf)#(lf)    DataSetTag           VARCHAR(10)  COLLATE DATABASE_DEFAULT NOT NULL#(lf));#(lf)#(lf)------------------------------------------------------------#(lf)-- 5) CURRENT expansion (levels 1..7)#(lf)------------------------------------------------------------#(lf)-- Anchor level 1#(lf)INSERT INTO #BOM_Current#(lf)SELECT#(lf)    C.Branch,#(lf)    1 AS BOM_Level,#(lf)    RA.RootItemId,#(lf)    RA.RootItem2nd,#(lf)#(lf)    C.ParentItemId,#(lf)    CAST(PIM.IMLITM AS NVARCHAR(30)) COLLATE DATABASE_DEFAULT AS ParentItem2nd,#(lf)#(lf)    CAST(1.0 AS DECIMAL(38,12)) AS ParentQty,#(lf)#(lf)    C.ComponentItemId,#(lf)    C.ComponentItem2nd,#(lf)    C.ComponentQty,#(lf)    C.ComponentQty AS ResolvedComponentQty,#(lf)#(lf)    C.EffectiveFrom,#(lf)    C.EffectiveThru,#(lf)    CAST(NULL AS DATETIME) AS BaselineThru,#(lf)#(lf)    CAST(CAST(C.ParentItemId AS VARCHAR(20)) AS VARCHAR(600)) COLLATE DATABASE_DEFAULT AS ParentPathNoQty,#(lf)    CAST(CONCAT(CAST(C.ParentItemId AS VARCHAR(20)), '>', CAST(C.ComponentItemId AS VARCHAR(20))) AS VARCHAR(600)) COLLATE DATABASE_DEFAULT AS StructPathNoQty,#(lf)#(lf)    CAST(CONCAT(CAST(C.ParentItemId AS VARCHAR(20)), '#ROOT') AS VARCHAR(800)) COLLATE DATABASE_DEFAULT AS ParentOccKey,#(lf)    CAST(CONCAT(CAST(C.ParentItemId AS VARCHAR(20)), '>', CAST(C.ComponentItemId AS VARCHAR(20)), '#Q', C.OperSeq) AS VARCHAR(800)) COLLATE DATABASE_DEFAULT AS StructPathQty,#(lf)#(lf)    'CURRENT' AS DataSetTag#(lf)FROM #F3002_Current C#(lf)JOIN #RootsAllowed RA#(lf)  ON RA.Branch = C.Branch#(lf) AND RA.RootItemId = C.ParentItemId#(lf)JOIN PRODDTA.F4101 PIM#(lf)  ON PIM.IMITM = C.ParentItemId;#(lf)#(lf)CREATE CLUSTERED INDEX CX_BOMC_LevelJoin ON #BOM_Current (Branch, BOM_Level, ComponentItemId);#(lf)CREATE NONCLUSTERED INDEX IX_BOMC_Edge ON #BOM_Current (Branch, RootItem2nd, BOM_Level, ParentPathNoQty, ComponentItemId);#(lf)#(lf)DECLARE @lvl INT = 1;#(lf)WHILE @lvl < 7#(lf)BEGIN#(lf)    INSERT INTO #BOM_Current#(lf)    SELECT#(lf)        R.Branch,#(lf)        @lvl + 1,#(lf)        R.RootItemId,#(lf)        R.RootItem2nd,#(lf)#(lf)        C.ParentItemId,#(lf)        R.ComponentItem2nd AS ParentItem2nd,#(lf)#(lf)        CAST(R.ResolvedComponentQty AS DECIMAL(38,12)) AS ParentQty,#(lf)#(lf)        C.ComponentItemId,#(lf)        C.ComponentItem2nd,#(lf)        C.ComponentQty,#(lf)#(lf)        CAST(R.ResolvedComponentQty * C.ComponentQty AS DECIMAL(38,12)) AS ResolvedComponentQty,#(lf)#(lf)        C.EffectiveFrom,#(lf)        C.EffectiveThru,#(lf)        CAST(NULL AS DATETIME) AS BaselineThru,#(lf)#(lf)        R.StructPathNoQty AS ParentPathNoQty,#(lf)        CAST(CONCAT(R.StructPathNoQty, '>', CAST(C.ComponentItemId AS VARCHAR(20))) AS VARCHAR(600)) COLLATE DATABASE_DEFAULT AS StructPathNoQty,#(lf)#(lf)        R.StructPathQty AS ParentOccKey,#(lf)        CAST(CONCAT(R.StructPathQty, '>', CAST(C.ComponentItemId AS VARCHAR(20)), '#Q', C.OperSeq) AS VARCHAR(800)) COLLATE DATABASE_DEFAULT AS StructPathQty,#(lf)#(lf)        'CURRENT' AS DataSetTag#(lf)    FROM #BOM_Current R#(lf)    JOIN #F3002_Current C#(lf)      ON C.Branch = R.Branch#(lf)     AND C.ParentItemId = R.ComponentItemId#(lf)    WHERE R.BOM_Level = @lvl;#(lf)#(lf)    SET @lvl += 1;#(lf)END;#(lf)#(lf)------------------------------------------------------------#(lf)-- 6) PAST expansion (levels 1..7) for the same roots#(lf)------------------------------------------------------------#(lf)INSERT INTO #BOM_Past#(lf)SELECT#(lf)    P.Branch,#(lf)    1,#(lf)    RA.RootItemId,#(lf)    RA.RootItem2nd,#(lf)#(lf)    P.ParentItemId,#(lf)    CAST(PIM.IMLITM AS NVARCHAR(30)) COLLATE DATABASE_DEFAULT AS ParentItem2nd,#(lf)#(lf)    CAST(1.0 AS DECIMAL(38,12)) AS ParentQty,#(lf)#(lf)    P.ComponentItemId,#(lf)    P.ComponentItem2nd,#(lf)    P.ComponentQty,#(lf)    P.ComponentQty AS ResolvedComponentQty,#(lf)#(lf)    P.EffectiveFrom,#(lf)    P.EffectiveThru,#(lf)    P.BaselineThru,#(lf)#(lf)    CAST(CAST(P.ParentItemId AS VARCHAR(20)) AS VARCHAR(600)) COLLATE DATABASE_DEFAULT AS ParentPathNoQty,#(lf)    CAST(CONCAT(CAST(P.ParentItemId AS VARCHAR(20)), '>', CAST(P.ComponentItemId AS VARCHAR(20))) AS VARCHAR(600)) COLLATE DATABASE_DEFAULT AS StructPathNoQty,#(lf)#(lf)    CAST(CONCAT(CAST(P.ParentItemId AS VARCHAR(20)), '#ROOT') AS VARCHAR(800)) COLLATE DATABASE_DEFAULT AS ParentOccKey,#(lf)    CAST(CONCAT(CAST(P.ParentItemId AS VARCHAR(20)), '>', CAST(P.ComponentItemId AS VARCHAR(20)), '#Q', P.OperSeq) AS VARCHAR(800)) COLLATE DATABASE_DEFAULT AS StructPathQty,#(lf)#(lf)    'PAST'#(lf)FROM #F3002_Past P#(lf)JOIN #RootsAllowed RA#(lf)  ON RA.Branch = P.Branch#(lf) AND RA.RootItemId = P.ParentItemId#(lf)JOIN PRODDTA.F4101 PIM#(lf)  ON PIM.IMITM = P.ParentItemId;#(lf)#(lf)CREATE CLUSTERED INDEX CX_BOMP_LevelJoin ON #BOM_Past (Branch, BOM_Level, ComponentItemId);#(lf)CREATE NONCLUSTERED INDEX IX_BOMP_Edge ON #BOM_Past (Branch, RootItem2nd, BOM_Level, ParentPathNoQty, ComponentItemId);#(lf)#(lf)SET @lvl = 1;#(lf)WHILE @lvl < 7#(lf)BEGIN#(lf)    INSERT INTO #BOM_Past#(lf)    SELECT#(lf)        R.Branch,#(lf)        @lvl + 1,#(lf)        R.RootItemId,#(lf)        R.RootItem2nd,#(lf)#(lf)        C.ParentItemId,#(lf)        R.ComponentItem2nd AS ParentItem2nd,#(lf)#(lf)        CAST(R.ResolvedComponentQty AS DECIMAL(38,12)) AS ParentQty,#(lf)#(lf)        C.ComponentItemId,#(lf)        C.ComponentItem2nd,#(lf)        C.ComponentQty,#(lf)#(lf)        CAST(R.ResolvedComponentQty * C.ComponentQty AS DECIMAL(38,12)) AS ResolvedComponentQty,#(lf)#(lf)        C.EffectiveFrom,#(lf)        C.EffectiveThru,#(lf)        R.BaselineThru,#(lf)#(lf)        R.StructPathNoQty AS ParentPathNoQty,#(lf)        CAST(CONCAT(R.StructPathNoQty, '>', CAST(C.ComponentItemId AS VARCHAR(20))) AS VARCHAR(600)) COLLATE DATABASE_DEFAULT AS StructPathNoQty,#(lf)#(lf)        R.StructPathQty AS ParentOccKey,#(lf)        CAST(CONCAT(R.StructPathQty, '>', CAST(C.ComponentItemId AS VARCHAR(20)), '#Q', C.OperSeq) AS VARCHAR(800)) COLLATE DATABASE_DEFAULT AS StructPathQty,#(lf)#(lf)        'PAST'#(lf)    FROM #BOM_Past R#(lf)    JOIN #F3002_Past C#(lf)      ON C.Branch = R.Branch#(lf)     AND C.ParentItemId = R.ComponentItemId#(lf)     AND C.BaselineThru = R.BaselineThru#(lf)    WHERE R.BOM_Level = @lvl;#(lf)#(lf)    SET @lvl += 1;#(lf)END;#(lf)#(lf)------------------------------------------------------------#(lf)-- 7) LatestPast overlap fix: delete PAST edges that exist in CURRENT#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #CurrentEdges;#(lf)#(lf)SELECT DISTINCT#(lf)    Branch,#(lf)    RootItem2nd,#(lf)    BOM_Level,#(lf)    ParentPathNoQty,#(lf)    ComponentItemId#(lf)INTO #CurrentEdges#(lf)FROM #BOM_Current;#(lf)#(lf)CREATE CLUSTERED INDEX CX_CurrentEdges#(lf)ON #CurrentEdges (Branch, RootItem2nd, BOM_Level, ParentPathNoQty, ComponentItemId);#(lf)#(lf)DELETE P#(lf)FROM #BOM_Past P#(lf)WHERE EXISTS (#(lf)    SELECT 1#(lf)    FROM #CurrentEdges CE#(lf)    WHERE CE.Branch         = P.Branch#(lf)      AND CE.RootItem2nd     = P.RootItem2nd#(lf)      AND CE.BOM_Level       = P.BOM_Level#(lf)      AND CE.ParentPathNoQty = P.ParentPathNoQty#(lf)      AND CE.ComponentItemId = P.ComponentItemId#(lf));#(lf)#(lf)------------------------------------------------------------#(lf)-- 8) Union ALL into #BOM_All#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #BOM_All;#(lf)#(lf)SELECT * INTO #BOM_All FROM #BOM_Current#(lf)UNION ALL#(lf)SELECT * FROM #BOM_Past;#(lf)#(lf)CREATE CLUSTERED INDEX CX_BOMAll_Group#(lf)ON #BOM_All (Branch, RootItem2nd, BOM_Level, ParentItem2nd, ComponentItem2nd);#(lf)#(lf)------------------------------------------------------------#(lf)-- 9) ParentOcc + LogicalParentQty#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #ParentOcc;#(lf)SELECT#(lf)    Branch,#(lf)    RootItem2nd,#(lf)    BOM_Level,#(lf)    ParentItem2nd,#(lf)    ParentOccKey,#(lf)    MAX(ParentQty) AS ParentQtyOcc#(lf)INTO #ParentOcc#(lf)FROM #BOM_All#(lf)GROUP BY Branch, RootItem2nd, BOM_Level, ParentItem2nd, ParentOccKey;#(lf)#(lf)CREATE CLUSTERED INDEX CX_ParentOcc#(lf)ON #ParentOcc (Branch, RootItem2nd, BOM_Level, ParentItem2nd);#(lf)#(lf)DROP TABLE IF EXISTS #LogicalParent;#(lf)SELECT#(lf)    Branch,#(lf)    RootItem2nd,#(lf)    BOM_Level,#(lf)    ParentItem2nd,#(lf)    SUM(ParentQtyOcc) AS LogicalParentQty#(lf)INTO #LogicalParent#(lf)FROM #ParentOcc#(lf)GROUP BY Branch, RootItem2nd, BOM_Level, ParentItem2nd;#(lf)#(lf)CREATE CLUSTERED INDEX CX_LogicalParent#(lf)ON #LogicalParent (Branch, RootItem2nd, BOM_Level, ParentItem2nd);#(lf)#(lf)------------------------------------------------------------#(lf)-- 10) ComponentAgg (summed extended qty)#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #ComponentAgg;#(lf)SELECT#(lf)    Branch,#(lf)    RootItem2nd,#(lf)    BOM_Level,#(lf)    ParentItem2nd,#(lf)    ComponentItem2nd,#(lf)    SUM(ResolvedComponentQty) AS ComponentQtyRaw#(lf)INTO #ComponentAgg#(lf)FROM #BOM_All#(lf)GROUP BY Branch, RootItem2nd, BOM_Level, ParentItem2nd, ComponentItem2nd;#(lf)#(lf)CREATE CLUSTERED INDEX CX_ComponentAgg#(lf)ON #ComponentAgg (Branch, RootItem2nd, BOM_Level, ParentItem2nd, ComponentItem2nd);#(lf)#(lf)------------------------------------------------------------#(lf)-- 11) Pick representative row per (parent, component, level)#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #BOM_Pick;#(lf)#(lf)WITH Pick AS (#(lf)    SELECT#(lf)        A.*,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY A.Branch, A.RootItem2nd, A.ParentItem2nd, A.ComponentItem2nd, A.BOM_Level#(lf)            ORDER BY A.EffectiveThru DESC, A.EffectiveFrom DESC, A.ParentOccKey DESC, A.DataSetTag DESC#(lf)        ) AS rn#(lf)    FROM #BOM_All A#(lf))#(lf)SELECT *#(lf)INTO #BOM_Pick#(lf)FROM Pick#(lf)WHERE rn = 1;#(lf)#(lf)CREATE CLUSTERED INDEX CX_BOMPick#(lf)ON #BOM_Pick (Branch, RootItem2nd, BOM_Level, ParentItem2nd, ComponentItem2nd);#(lf)#(lf)------------------------------------------------------------#(lf)-- 12) Lowest Level helper (has children)#(lf)------------------------------------------------------------#(lf)DROP TABLE IF EXISTS #HasChildren;#(lf)#(lf)SELECT DISTINCT#(lf)    TRIM(IXMMCU) COLLATE DATABASE_DEFAULT AS Branch,#(lf)    CAST(IXKIT AS DECIMAL(15,0)) AS ParentItemId#(lf)INTO #HasChildren#(lf)FROM PRODDTA.F3002#(lf)WHERE IXTBM = 'M'#(lf)  AND IXMMCU NOT LIKE '%LAB%'#(lf)  --AND IXQNTY > 0#(lf)  AND TRIM(IXMMCU) COLLATE DATABASE_DEFAULT IN (SELECT Branch FROM #BranchFilter);#(lf)#(lf)CREATE CLUSTERED INDEX CX_HasChildren ON #HasChildren (Branch, ParentItemId);#(lf)#(lf)------------------------------------------------------------#(lf)-- 13) Final output (column order preserved)#(lf)------------------------------------------------------------#(lf);WITH S AS (#(lf)    SELECT#(lf)        BP.Branch                                        AS [Branch Plant],#(lf)        BP.RootItem2nd                                   AS [Original Item Number],#(lf)        IMROOT.IMUOM1                                    AS [Original Item UOM],#(lf)#(lf)        BP.ParentItem2nd                                 AS [Parent Item Number],#(lf)        IMP.IMUOM1                                       AS [Parent Item UOM],#(lf)        BP.BOM_Level - 1                                 AS [Level Down],#(lf)#(lf)        CASE WHEN HC.ParentItemId IS NULL THEN 1 ELSE 0 END AS [Lowest Level],#(lf)#(lf)        BP.ComponentItem2nd                              AS [Component Item Number],#(lf)#(lf)        CAST(CA.ComponentQtyRaw AS DECIMAL(38,12))        AS [Component Quantity Raw],#(lf)        CAST(LP.LogicalParentQty AS DECIMAL(38,12))       AS [Logical Parent Qty Raw],#(lf)#(lf)        IMC.IMUOM1                                       AS [Component Item UOM],#(lf)        F55C.IMGBLK                                      AS [Global Bulk Item],#(lf)        F55C.IMBULK                                      AS [Bulk Item],#(lf)        IMB.IBSTKT                                       AS [Stock Type Code],#(lf)        IMB.IBLTLV                                       AS [Lead Time Level],#(lf)        IMCost.COUNCS/10000                              AS [Std Cost],#(lf)        UDC.DRDL01                                       AS [Commodity Class Description],#(lf)        UDC_1.DRDL01                                     AS [Commodity Sub Class Description],#(lf)        IMB.IBVEND                                       AS [Supplier Number],#(lf)        ISNULL(AB.ABALPH,'Not Available')                AS [Supplier Name],#(lf)        BP.EffectiveFrom                                 AS [Effective From],#(lf)        BP.EffectiveThru                                 AS [Effective Through],#(lf)        IMCost.COITM                                     AS [ComID],#(lf)        IMP.IMITM                                        AS [ParID]#(lf)    FROM #BOM_Pick BP#(lf)    JOIN #ComponentAgg CA#(lf)      ON CA.Branch          = BP.Branch#(lf)     AND CA.RootItem2nd      = BP.RootItem2nd#(lf)     AND CA.BOM_Level        = BP.BOM_Level#(lf)     AND CA.ParentItem2nd    = BP.ParentItem2nd#(lf)     AND CA.ComponentItem2nd = BP.ComponentItem2nd#(lf)    LEFT JOIN #LogicalParent LP#(lf)      ON LP.Branch       = BP.Branch#(lf)     AND LP.RootItem2nd   = BP.RootItem2nd#(lf)     AND LP.BOM_Level     = BP.BOM_Level#(lf)     AND LP.ParentItem2nd = BP.ParentItem2nd#(lf)    LEFT JOIN #HasChildren HC#(lf)      ON HC.Branch       = BP.Branch#(lf)     AND HC.ParentItemId = BP.ComponentItemId#(lf)#(lf)    LEFT JOIN PRODDTA.F4101 IMC#(lf)      ON IMC.IMITM = BP.ComponentItemId#(lf)    LEFT JOIN PRODDTA.F4101 IMP#(lf)      ON IMP.IMITM = BP.ParentItemId#(lf)    LEFT JOIN PRODDTA.F4101 IMROOT#(lf)      ON IMROOT.IMITM = BP.RootItemId#(lf)#(lf)    LEFT JOIN PRODDTA.F4102 IMB#(lf)      ON IMB.IBITM = BP.ComponentItemId#(lf)     AND TRIM(IMB.IBMCU) COLLATE DATABASE_DEFAULT = BP.Branch#(lf)#(lf)    LEFT JOIN PRODDTA.F4105 IMCost#(lf)      ON IMCost.COITM = BP.ComponentItemId#(lf)     AND TRIM(IMCost.COMCU) COLLATE DATABASE_DEFAULT = BP.Branch#(lf)     AND IMCost.COLEDG = '07'#(lf)#(lf)    LEFT JOIN PRODCTL.F0005 UDC#(lf)      ON TRIM(UDC.DRKY) = IMB.IBPRP1 AND UDC.DRSY = '41' AND UDC.DRRT = 'P1'#(lf)    LEFT JOIN PRODCTL.F0005 UDC_1#(lf)      ON TRIM(UDC_1.DRKY) = TRIM(IMB.IBPRP2) AND UDC_1.DRSY = '41' AND UDC_1.DRRT = 'P2'#(lf)#(lf)    LEFT JOIN PRODDTA.F0101 AB#(lf)      ON AB.ABAN8 = IMB.IBVEND#(lf)#(lf)    LEFT JOIN PRODDTA.F554101 F55C#(lf)      ON TRIM(F55C.IMLITM) = TRIM(BP.ComponentItem2nd)#(lf))#(lf)#(lf)#(lf)SELECT#(lf)    S.[Branch Plant],#(lf)    S.[Parent Item Number]      AS [Parent 2nd Item Number],#(lf)    S.[Component Item Number]   AS [2nd Item Number],#(lf)    S.[Bulk Item],#(lf)    S.[Global Bulk Item],#(lf)    CAST(S.[Component Quantity Raw] AS DECIMAL(38,6)) AS [Component Quantity]#(lf)#(lf)#(lf)FROM S#(lf)#(lf)WHERE S.[Bulk Item] IN (#(lf)    '161017CX',#(lf)    '161190PX',#(lf)    '171143PX',#(lf)    '171228PX.E',#(lf)    '181020CX.E',#(lf)    '181136IX',#(lf)    '181192IX',#(lf)    '181193EU.E',#(lf)    '191011CX',#(lf)    '191026CX.E',#(lf)    '191245PX',#(lf)    '23409A',#(lf)    'ABEX2525',#(lf)    'APT10',#(lf)    'APT11',#(lf)    'DMAEMA',#(lf)    'EMA3065',#(lf)    'ET2012.E',#(lf)    'ET2022.E',#(lf)    'ET4075.E',#(lf)    'ET440.E',#(lf)    'FERSUL7W',#(lf)    'HP1432AT',#(lf)    'HP1632',#(lf)    'MD4020',#(lf)    'MD4020C',#(lf)    'MD4020S',#(lf)    'MD4021',#(lf)    'MD4021C',#(lf)    'MD4021S',#(lf)    'MD4022',#(lf)    'MD4022C',#(lf)    'MD4023',#(lf)    'MD4023C',#(lf)    'MDU20',#(lf)    'MDU2012.E',#(lf)    'MDU2012B.E',#(lf)    'MDU4075.E',#(lf)    'MDU4075B.E',#(lf)    'MDU440.E',#(lf)    'MDU440B.E',#(lf)    'MPEG2000',#(lf)    'MW40504',#(lf)    'MW40514',#(lf)    'NP4LF',#(lf)    'NP4LF.S',#(lf)    'OMS',#(lf)    'PUD1.E',#(lf)    'STODSO',#(lf)    'U1001',#(lf)    'U101',#(lf)    'U201',#(lf)    'U2022',#(lf)    'U2022EU.E',#(lf)    'U2023',#(lf)    'U204',#(lf)    'U204EU.E',#(lf)    'U470',#(lf)    'U501',#(lf)    'U501B',#(lf)    'U502',#(lf)    'U502.E',#(lf)    'U502X1.E',#(lf)    'U601',#(lf)    'U701',#(lf)    'U802',#(lf)    'U802.E',#(lf)    'WAV501',#(lf)    'WD40',#(lf)    'WD40T'#(lf))#(lf)#(lf)ORDER BY#(lf)    S.[Branch Plant] DESC,#(lf)#(tab)S.[Parent Item Number],#(lf)#(tab)S.[Component Item Number],#(lf)#(tab)S.[Std Cost],#(lf)#(tab)S.[Lead Time Level]"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

