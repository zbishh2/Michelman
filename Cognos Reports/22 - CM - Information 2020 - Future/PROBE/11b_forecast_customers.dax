// Distinct forecast customers (address x company): candidate Revenue BU and TM sources.
EVALUATE
VAR B = { "161017CX","161190PX","171143PX","171228PX.E","181020CX.E","181136IX","181192IX","181193EU.E","191011CX","191026CX.E","191245PX","23409A","ABEX2525","APT10","APT11","DMAEMA","EMA3065","ET2012.E","ET2022.E","ET4075.E","ET440.E","FERSUL7W","HP1432AT","HP1632","MD4020","MD4020C","MD4020S","MD4021","MD4021C","MD4021S","MD4022","MD4022C","MD4023","MD4023C","MDU20","MDU2012.E","MDU2012B.E","MDU4075.E","MDU4075B.E","MDU440.E","MDU440B.E","MPEG2000","MW40504","MW40514","NP4LF","NP4LF.S","OMS","PUD1.E","STODSO","U1001","U101","U201","U2022","U2022EU.E","U2023","U204","U204EU.E","U470","U501","U501B","U502","U502.E","U502X1.E","U601","U701","U802","U802.E","WAV501","WD40","WD40T" }
VAR F = FILTER(FactForecast, TRIM(RELATED('Item Branch'[Item Bulk])) IN B && FactForecast[RequestedDate] >= DATE(2026,8,1) && FactForecast[RequestedDate] <= DATE(2027,11,30) && FactForecast[QuantityForecast] > 0)
VAR A = SUMMARIZE(F, FactForecast[AddressSKey], FactForecast[AddressNum], FactForecast[Company])
RETURN
SELECTCOLUMNS(ADDCOLUMNS(A,
  "AddrSalesBU", LOOKUPVALUE('Address'[Sales Business Unit], 'Address'[AddressSKey], FactForecast[AddressSKey]),
  "AddrBUSKey", LOOKUPVALUE('Address'[BusinessUnitSKey], 'Address'[AddressSKey], FactForecast[AddressSKey]),
  "CustN", COUNTROWS(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey] && Customer[Company] = FactForecast[Company])),
  "CustSalesBU", MAXX(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey] && Customer[Company] = FactForecast[Company]), Customer[Sales Business Unit]),
  "CustBU", MAXX(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey] && Customer[Company] = FactForecast[Company]), Customer[Business Unit]),
  "CustRepCode", MAXX(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey] && Customer[Company] = FactForecast[Company]), Customer[Primary Sales Rep Code]),
  "CustRepName", MAXX(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey] && Customer[Company] = FactForecast[Company]), Customer[Primary Sales Rep Name]),
  "CustPrimaryRep", MAXX(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey] && Customer[Company] = FactForecast[Company]), Customer[Primary Sales Rep]),
  "CustAnyRepName", MAXX(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey]), Customer[Primary Sales Rep Name]),
  "CustAnySalesBU", MAXX(FILTER(Customer, Customer[AddressSKey] = FactForecast[AddressSKey]), Customer[Sales Business Unit])
), "AddressSKey", FactForecast[AddressSKey], "AddressNum", FactForecast[AddressNum], "Company", FactForecast[Company], "AddrSalesBU", [AddrSalesBU], "AddrBUSKey", [AddrBUSKey], "CustN", [CustN], "CustSalesBU", [CustSalesBU], "CustBU", [CustBU], "CustRepCode", [CustRepCode], "CustRepName", [CustRepName], "CustPrimaryRep", [CustPrimaryRep], "CustAnyRepName", [CustAnyRepName], "CustAnySalesBU", [CustAnySalesBU])
