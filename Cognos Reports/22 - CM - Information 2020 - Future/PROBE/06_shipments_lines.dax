// Probe 6 — Shipments at order-line grain for the 70 CM bulk items, not cancelled, promised ship date >= 2020-01-01,
// carrying every Cognos column's SSAS candidate plus the cost columns that might reproduce Raw Material Margin.
EVALUATE
VAR B = { "161017CX", "161190PX", "171143PX", "171228PX.E", "181020CX.E", "181136IX", "181192IX", "181193EU.E", "191011CX", "191026CX.E", "191245PX", "23409A", "ABEX2525", "APT10", "APT11", "DMAEMA", "EMA3065", "ET2012.E", "ET2022.E", "ET4075.E", "ET440.E", "FERSUL7W", "HP1432AT", "HP1632", "MD4020", "MD4020C", "MD4020S", "MD4021", "MD4021C", "MD4021S", "MD4022", "MD4022C", "MD4023", "MD4023C", "MDU20", "MDU2012.E", "MDU2012B.E", "MDU4075.E", "MDU4075B.E", "MDU440.E", "MDU440B.E", "MPEG2000", "MW40504", "MW40514", "NP4LF", "NP4LF.S", "OMS", "PUD1.E", "STODSO", "U1001", "U101", "U201", "U2022", "U2022EU.E", "U2023", "U204", "U204EU.E", "U470", "U501", "U501B", "U502", "U502.E", "U502X1.E", "U601", "U701", "U802", "U802.E", "WAV501", "WD40", "WD40T" }
VAR R =
    FILTER (
        Sales,
        TRIM ( RELATED ( 'Item Branch'[Item Bulk] ) ) IN B
            && Sales[Promised Shipment Date] >= DATE ( 2020, 1, 1 )
            && Sales[Cancelled_Flag] = 0
    )
RETURN
    SELECTCOLUMNS (
        R,
        "OrderCo", Sales[Order Company],
        "Branch", Sales[BusinessUnit],
        "OrderNum", Sales[Order Num],
        "LineNum", Sales[Line Num],
        "OpenFlag", Sales[Open Order Flag],
        "GlobalBulk", RELATED ( 'Item Branch'[Item Global Bulk] ),
        "Bulk", RELATED ( 'Item Branch'[Item Bulk] ),
        "Item2nd", Sales[Item Num 2nd],
        "Desc1", Sales[Description 1],
        "Desc2", Sales[Description 2],
        "FHC", Sales[Freight Handling Code],
        "NextStatus", Sales[Status Code Next],
        "USD", Sales[AmountOrderNetUSD],
        "EUR", Sales[AmountOrderNetEUR],
        "LB", Sales[QuantityOrderedLB],
        "KG", Sales[QuantityOrderedKG],
        "CM", Sales[ContributionMargin],
        "Net", Sales[AmountOrderNet],
        "ExtCost", Sales[AmountExtendedCost],
        "ExtCostUSD", Sales[AmountExtendedCostUSD],
        "ExtCostEUR", Sales[AmountExtendedCostEUR],
        "StdExtCostUSD", Sales[AmtStdExtCostUSD],
        "FSDUnitCost", Sales[FSDAmountUnitCost],
        "QtyOrd", Sales[QuantityOrdered],
        "RBU", RELATED ( 'Revenue Business Unit'[RBU] ),
        "TM", RELATED ( 'Territory Manager'[Mailing Name] ),
        "CustName", RELATED ( 'Customer Ship To'[Customer Ship To Name] ),
        "Country", RELATED ( 'Customer Ship To'[Country Desc] ),
        "GlobalParent", RELATED ( Customer[Global Parent Name] ),
        "PromDate", Sales[Promised Shipment Date],
        "Chemist", RELATED ( 'Item Branch'[Chemist Name] ),
        "LineType", Sales[Line Type],
        "OrderType", Sales[Order Type]
    )
