// Currency Rates: USD<->EUR pairs, Jan-Feb 2020 window
EVALUATE
SELECTCOLUMNS(
    FILTER(
        'Currency Rates',
        ('Currency Rates'[CurrencyCodeFrom] = "USD" && 'Currency Rates'[CurrencyCodeTo] = "EUR"
          || 'Currency Rates'[CurrencyCodeFrom] = "EUR" && 'Currency Rates'[CurrencyCodeTo] = "USD")
            && 'Currency Rates'[CalendarDate] >= DATE(2020,1,1)
            && 'Currency Rates'[CalendarDate] <= DATE(2020,2,5)
    ),
    "CcyFrom", 'Currency Rates'[CurrencyCodeFrom],
    "CcyTo", 'Currency Rates'[CurrencyCodeTo],
    "CalDate", 'Currency Rates'[CalendarDate],
    "PeriodEnd", 'Currency Rates'[PeriodEndDate],
    "EffDaily", 'Currency Rates'[EffectiveDateDaily],
    "RateDaily", 'Currency Rates'[ToRateDaily],
    "RateA", 'Currency Rates'[ToRateA],
    "RateM", 'Currency Rates'[ToRateM],
    "RateB", 'Currency Rates'[ToRateB],
    "ToCode", 'Currency Rates'[ToCode]
)
