EVALUATE
VAR B = { "161017CX","161190PX","171143PX","171228PX.E","181020CX.E","181136IX","181192IX","181193EU.E","191011CX","191026CX.E","191245PX","23409A","ABEX2525","APT10","APT11","DMAEMA","EMA3065","ET2012.E","ET2022.E","ET4075.E","ET440.E","FERSUL7W","HP1432AT","HP1632","MD4020","MD4020C","MD4020S","MD4021","MD4021C","MD4021S","MD4022","MD4022C","MD4023","MD4023C","MDU20","MDU2012.E","MDU2012B.E","MDU4075.E","MDU4075B.E","MDU440.E","MDU440B.E","MPEG2000","MW40504","MW40514","NP4LF","NP4LF.S","OMS","PUD1.E","STODSO","U1001","U101","U201","U2022","U2022EU.E","U2023","U204","U204EU.E","U470","U501","U501B","U502","U502.E","U502X1.E","U601","U701","U802","U802.E","WAV501","WD40","WD40T" }
VAR T = FILTER('Bill Of Material Expanded', TRIM(RELATED('Item Branch'[Item Bulk])) IN B)
RETURN
SELECTCOLUMNS(
  ADDCOLUMNS(
    SUMMARIZE(T, 'Bill Of Material Expanded'[Type Bill of Material], 'Bill Of Material Expanded'[Component BOM Level], 'Bill Of Material Expanded'[Is Interim Item]),
    "n", VAR a = 'Bill Of Material Expanded'[Type Bill of Material] VAR b = 'Bill Of Material Expanded'[Component BOM Level] VAR c = 'Bill Of Material Expanded'[Is Interim Item] RETURN COUNTROWS(FILTER(T, 'Bill Of Material Expanded'[Type Bill of Material] = a && 'Bill Of Material Expanded'[Component BOM Level] = b && 'Bill Of Material Expanded'[Is Interim Item] = c)),
    "minThru", VAR a = 'Bill Of Material Expanded'[Type Bill of Material] VAR b = 'Bill Of Material Expanded'[Component BOM Level] VAR c = 'Bill Of Material Expanded'[Is Interim Item] RETURN MINX(FILTER(T, 'Bill Of Material Expanded'[Type Bill of Material] = a && 'Bill Of Material Expanded'[Component BOM Level] = b && 'Bill Of Material Expanded'[Is Interim Item] = c), 'Bill Of Material Expanded'[BOM Effective Thru Date]),
    "maxThru", VAR a = 'Bill Of Material Expanded'[Type Bill of Material] VAR b = 'Bill Of Material Expanded'[Component BOM Level] VAR c = 'Bill Of Material Expanded'[Is Interim Item] RETURN MAXX(FILTER(T, 'Bill Of Material Expanded'[Type Bill of Material] = a && 'Bill Of Material Expanded'[Component BOM Level] = b && 'Bill Of Material Expanded'[Is Interim Item] = c), 'Bill Of Material Expanded'[BOM Effective Thru Date]),
    "minCal", VAR a = 'Bill Of Material Expanded'[Type Bill of Material] VAR b = 'Bill Of Material Expanded'[Component BOM Level] VAR c = 'Bill Of Material Expanded'[Is Interim Item] RETURN MINX(FILTER(T, 'Bill Of Material Expanded'[Type Bill of Material] = a && 'Bill Of Material Expanded'[Component BOM Level] = b && 'Bill Of Material Expanded'[Is Interim Item] = c), 'Bill Of Material Expanded'[CalendarDate]),
    "maxCal", VAR a = 'Bill Of Material Expanded'[Type Bill of Material] VAR b = 'Bill Of Material Expanded'[Component BOM Level] VAR c = 'Bill Of Material Expanded'[Is Interim Item] RETURN MAXX(FILTER(T, 'Bill Of Material Expanded'[Type Bill of Material] = a && 'Bill Of Material Expanded'[Component BOM Level] = b && 'Bill Of Material Expanded'[Is Interim Item] = c), 'Bill Of Material Expanded'[CalendarDate]),
    "nBlankThru", VAR a = 'Bill Of Material Expanded'[Type Bill of Material] VAR b = 'Bill Of Material Expanded'[Component BOM Level] VAR c = 'Bill Of Material Expanded'[Is Interim Item] RETURN COUNTROWS(FILTER(FILTER(T, 'Bill Of Material Expanded'[Type Bill of Material] = a && 'Bill Of Material Expanded'[Component BOM Level] = b && 'Bill Of Material Expanded'[Is Interim Item] = c), ISBLANK('Bill Of Material Expanded'[BOM Effective Thru Date])))
  ),
  "TypeBOM", 'Bill Of Material Expanded'[Type Bill of Material], "Level", 'Bill Of Material Expanded'[Component BOM Level], "IsInterim", 'Bill Of Material Expanded'[Is Interim Item],
  "n", [n], "minThru", [minThru], "maxThru", [maxThru], "minCal", [minCal], "maxCal", [maxCal], "nBlankThru", [nBlankThru])
