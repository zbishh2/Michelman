table Safety_Stock_HP
	lineageTag: 8f8d6925-2575-4181-ac85-27fbd2f9685f

	column REGION
		dataType: string
		lineageTag: db2eac05-faa2-4c15-b3e9-36937dc0aed8
		summarizeBy: none
