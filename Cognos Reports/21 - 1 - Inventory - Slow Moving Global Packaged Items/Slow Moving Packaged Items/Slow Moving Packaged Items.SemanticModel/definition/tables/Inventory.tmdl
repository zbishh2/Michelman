	/// From the FACT (snap.CategoryGLF41021), not the item. BUILD.md 0.1 - do not unify
	/// with the item-level column the other two tables use.
	column 'GL Class Code'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000105
		summarizeBy: none
		sourceColumn: GL Class Code

		annotation SummarizationSetBy = Automatic

	/// Raw. Bind 'Location (Display)' in visuals.
	column Location
		dataType: string
		isHidden
		lineageTag: 21a10000-0000-4000-8000-000000000106
		summarizeBy: none
		sourceColumn: Location

		annotation SummarizationSetBy = Automatic

	/// Cognos renders a missing dimension attribute as '-'. The raw value remains hidden.
	column 'Location (Display)' =
			VAR Raw = TRIM ( 'Inventory'[Location] )
			RETURN
			    IF ( LEN ( Raw ) = 0, "-", Raw )
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000107
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Raw. Bind 'Lot Number (Display)' in visuals.
	column 'Lot Number'
		dataType: string
		isHidden
		lineageTag: 21a10000-0000-4000-8000-000000000108
		summarizeBy: none
		sourceColumn: Lot Number

		annotation SummarizationSetBy = Automatic

	/// Cognos renders a missing dimension attribute as '-'. The raw value remains hidden.
	column 'Lot Number (Display)' =
			VAR Raw = TRIM ( 'Inventory'[Lot Number] )
			RETURN
			    IF ( LEN ( Raw ) = 0, "-", Raw )
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000109
