table 'Items - Active'
	lineageTag: 21a10000-0000-4000-8000-000000001003

	column 'Branch Plant'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000301
		summarizeBy: none
		sourceColumn: Branch Plant

		annotation SummarizationSetBy = Automatic

	/// Production SSAS global-bulk attribute. The legacy Cognos warehouse may display a dash
	/// where this model retains the derived item value.
	column 'Global Bulk Item'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000302
		summarizeBy: none
		sourceColumn: Global Bulk Item

		annotation SummarizationSetBy = Automatic

	/// Production SSAS bulk-item attribute.
	column 'Bulk Item'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000303
		summarizeBy: none
		sourceColumn: Bulk Item

		annotation SummarizationSetBy = Automatic

	column '2nd Item Number'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000304
		summarizeBy: none
		sourceColumn: 2nd Item Number

		annotation SummarizationSetBy = Automatic

	/// 'Active' on the page name means Stocking Type NOT IN ('O'), O = obsolete.
	column 'Stock Type Code'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000305
		summarizeBy: none
		sourceColumn: Stock Type Code

		annotation SummarizationSetBy = Automatic

	partition 'Items - Active' = m
		mode: import
		source =
				let
				    Raw = AnalysisServices.Database(
				        "SSASPROD",
				        "BIQLTabular",
				        [
				            Query = "
				EVALUATE
				DISTINCT (
				    SELECTCOLUMNS (
				        FILTER (
				            'Item Branch',
				            TRIM ( 'Item Branch'[Category GL F4101] ) = ""IN32""
				                && TRIM ( 'Item Branch'[Stocking Type] ) <> ""O""
				                && TRIM ( 'Item Branch'[Business Unit] )
				                    IN { ""CINC"", ""CIN2"", ""CIN4"", ""AUBA"", ""AUB2"", ""SING"", ""SNG4"" }
				        ),
				        ""Branch Plant"", TRIM ( 'Item Branch'[Business Unit] ),
				        ""Global Bulk Item"", TRIM ( 'Item Branch'[Item Global Bulk] ),
				        ""Bulk Item"", TRIM ( 'Item Branch'[Item Bulk] ),
				        ""2nd Item Number"", TRIM ( 'Item Branch'[Item Num 2nd] ),
				        ""Stock Type Code"", TRIM ( 'Item Branch'[Stocking Type] )
				    )
				)
				ORDER BY [Global Bulk Item], [Bulk Item], [2nd Item Number], [Branch Plant]
				"
				        ]
				    ),
				    Data = Table.TransformColumnNames(
				        Raw,
				        each if Text.StartsWith(_, "[") and Text.EndsWith(_, "]")
				            then Text.Middle(_, 1, Text.Length(_) - 2)
				            else _
				    )
				in
				    Data

	annotation PBI_ResultType = Table

