	/// DELIBERATELY TRUNCATED TO 5 CHARACTERS to reproduce a known Cognos defect.
	/// Cognos does substr(ORDER_LINE_ID, 1+instr(...,',',-1), 5) and then GROUPs BY the
	/// result, so line 10.001 renders as '10.00', collides with 10.000 and the two rows
	/// MERGE with summed quantities. Measured: 8 rows of the 2026-08-06 capture are such
	/// merges, and emulating the truncation is what lifts the local match from 17,251 to
	/// 17,259 of 17,259. Reproduced on Zack's 'build for parity' instruction of 2026-08-06.
	/// The correct unmerged form is a two-line edit - see Shipments.commented.m. D-21a.
	column 'Line Number'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000207
		summarizeBy: none
		sourceColumn: Line Number

		annotation SummarizationSetBy = Automatic

	column 'Last Status'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000208
		summarizeBy: none
		sourceColumn: Last Status

		annotation SummarizationSetBy = Automatic

	column 'Next Status'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000209
		summarizeBy: none
		sourceColumn: Next Status

		annotation SummarizationSetBy = Automatic

	/// D-21d, resolved by jumpbox probe P1 on 2026-08-06. dbo.FactSalesDetail has no column
	/// of this name; the answer is Next Status. Over all 17,259 export rows: 'N' <-> 999 on
	/// 16,363 rows, 'Y' <-> 540/530/560/535/580/525/550/570 on 896. Zero exceptions.
	/// StatusCodeNext is nchar - the TRIM is required or the = "999" test silently fails.
	/// DO NOT re-adopt SalesTableSource: BUILD.md 3.5 named it as the structural analog and it
	/// looked perfect on the 17,253 export-matched rows, but the probe found 252 lines with
	/// SalesTableSource = 1 AND StatusCodeNext = 999 that it would misclassify. The column has
	/// been removed from the query so it cannot be reinstated by accident. BUILD.md 7 #18.
	/// Display-only in this report - do NOT copy report 19's Open Indicator carve-out here.
	column 'Open Indicator' = IF ( TRIM ( 'Shipments'[Next Status] ) = "999", "N", "Y" )
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-00000000020a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Promised Ship Date'
