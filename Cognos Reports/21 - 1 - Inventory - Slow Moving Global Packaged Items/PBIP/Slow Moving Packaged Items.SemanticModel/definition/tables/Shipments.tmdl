	/// SUM(QuantityOrderedPrimaryUOM), net of cancellation in SQL. NOT
	/// QuantityOrdered * SalesFactor, which is the transaction quantity. BUILD.md 2.5.
	column 'Ordered Quantity'
		dataType: double
		formatString: #,0
		lineageTag: 21a10000-0000-4000-8000-00000000020c
		summarizeBy: none
		sourceColumn: Ordered Quantity

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column 'Ordering Unit of Measure'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-00000000020d
		summarizeBy: none
		sourceColumn: Ordering Unit of Measure

		annotation SummarizationSetBy = Automatic

	/// KG/LB rule, BUILD.md 2.4. primary UOM = LB -> quantity as-is;
	/// = KG -> quantity * [KG to LB]; anything else -> KGs * [KG to LB].
	/// Constants live only in the hidden 'Conversion Constants' table.
	column 'Ordered Quantity LBs' =
			VAR KGtoLB = MAXX ( 'Conversion Constants', 'Conversion Constants'[KG to LB] )
			VAR Qty    = 'Shipments'[Ordered Quantity]
			VAR UOM    = TRIM ( 'Shipments'[Primary Unit of Measure] )
			RETURN
			    SWITCH (
			        TRUE (),
			        UOM = "LB", Qty,
			        UOM = "KG", Qty * KGtoLB,
			        Qty * 'Shipments'[KG Factor] * KGtoLB
			    )
		dataType: double
		formatString: #,0
		lineageTag: 21a10000-0000-4000-8000-00000000020e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	/// KG/LB rule, BUILD.md 2.4 - the report's one real derivation.
	/// primary UOM = KG -> quantity as-is; = LB -> quantity * [LB to KG];
	/// anything else -> quantity * the per-item EDW [KG Factor].
	/// Constants live only in the hidden 'Conversion Constants' table.
	column 'Ordered Quantity KGs' =
			VAR LBtoKG = MAXX ( 'Conversion Constants', 'Conversion Constants'[LB to KG] )
			VAR Qty    = 'Shipments'[Ordered Quantity]
			VAR UOM    = TRIM ( 'Shipments'[Primary Unit of Measure] )
			RETURN
			    SWITCH (
			        TRUE (),
			        UOM = "KG", Qty,
			        UOM = "LB", Qty * LBtoKG,
			        Qty * 'Shipments'[KG Factor]
			    )
		dataType: double
		formatString: #,0
		lineageTag: 21a10000-0000-4000-8000-00000000020f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

