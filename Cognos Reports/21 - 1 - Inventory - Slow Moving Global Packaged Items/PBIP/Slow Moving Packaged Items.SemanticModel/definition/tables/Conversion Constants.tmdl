/// The two weight-conversion constants the Cognos DW applies, pinned in ONE place.
/// Measured on every row of the 2026-08-06 tight capture (BUILD.md 2.4, 7 #4):
/// Quantity on Hand LBs / Quantity on Hand KGs is the single constant 2.2045992
/// on 2,054/2,065 Inventory and 17,179/17,259 Shipments rows. It is NOT the
/// physical 2.20462262 and NOT JDE's 2.20462 - it is a 7-implied-decimal JDE
/// factor (22045992), corroborated in PRODDTA.F41002. No EDW column reproduces it:
/// DimItemUOMConversionLBKG.LB is 2.204620000 and FactSalesDetail.ConversionFactorLB
/// is 2.2046200. LB to KG is stored separately rather than derived as 1/2.2045992,
/// because the DW stores its own 9-decimal truncation 0.453597189 - multiplying by
/// the stored value reproduces the export EXACTLY where dividing by 2.2045992 is
/// off in the 6th decimal (Inventory 1,860 exact vs 1,108; Shipments 16,470 vs 8,657).
/// Change these two numbers here and nowhere else when D-21e resolves.
table 'Conversion Constants'
	isHidden
	lineageTag: 21a10000-0000-4000-8000-000000001004

	/// Kilograms -> pounds. Cognos DW constant. See the table description.
	column 'KG to LB'
		dataType: double
		lineageTag: 21a10000-0000-4000-8000-000000000901
		summarizeBy: none
		isNameInferred
		sourceColumn: [KG to LB]

		annotation SummarizationSetBy = Automatic

	/// Pounds -> kilograms. The DW's own stored 9-decimal reciprocal, not 1/2.2045992.
	column 'LB to KG'
		dataType: double
		lineageTag: 21a10000-0000-4000-8000-000000000902
		summarizeBy: none
		isNameInferred
		sourceColumn: [LB to KG]

		annotation SummarizationSetBy = Automatic

	partition 'Conversion Constants' = calculated
		mode: import
		source =
				DATATABLE (
				    "KG to LB", DOUBLE,
				    "LB to KG", DOUBLE,
				    { { 2.2045992, 0.453597189 } }
				)

	annotation PBI_ResultType = Table

