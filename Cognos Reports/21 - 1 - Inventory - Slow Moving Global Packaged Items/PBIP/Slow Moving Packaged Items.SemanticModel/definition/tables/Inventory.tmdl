	/// Raw. Bind 'Location (Display)' in visuals.
	column Location
		dataType: string
		isHidden
		lineageTag: 21a10000-0000-4000-8000-000000000106
		summarizeBy: none
		sourceColumn: Location

		annotation SummarizationSetBy = Automatic

	/// Cognos renders a MISSING dimension attribute as '-'; it is not stored data.
	/// The raw column is kept hidden so the real missing/blank distinction survives.
	/// The test is on trimmed LENGTH, not ISBLANK: in scope this column is blank or
	/// whitespace on the affected rows and NULL on none of them (BUILD.md 7 #11), so a
	/// BLANK-only test would render nothing at all. BUILD.md 4.5 case 1, 5.2.
	column 'Location (Display)' =
			VAR Raw = TRIM ( 'Inventory'[Location] )
			RETURN
			    IF ( LEN ( Raw ) = 0, "-", Raw )
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-000000000107
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Raw. Bind 'Lot Number (Display)' in visuals.
	column 'Lot Number'
