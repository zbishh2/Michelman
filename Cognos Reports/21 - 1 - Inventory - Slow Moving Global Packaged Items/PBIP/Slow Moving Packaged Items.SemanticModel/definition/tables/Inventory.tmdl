	column 'Quantity on Hand'
		dataType: double
		formatString: #,0
		lineageTag: 21a10000-0000-4000-8000-00000000010d
		summarizeBy: none
		sourceColumn: Quantity on Hand

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Header trap: the Cognos data item is named UOM but carries no label= override, so
	/// the export header reads 'Primary Unit of Measure'. BUILD.md 3.1.
	column 'Primary Unit of Measure'
		dataType: string
		lineageTag: 21a10000-0000-4000-8000-00000000010e
		summarizeBy: none
		sourceColumn: Primary Unit of Measure

		annotation SummarizationSetBy = Automatic

	/// KG/LB rule, BUILD.md 2.4 - the report's one real derivation.
	/// primary UOM = KG -> quantity as-is; = LB -> quantity * [LB to KG];
	/// anything else -> quantity * the per-item EDW [KG Factor].
	/// Constants live only in the hidden 'Conversion Constants' table.
	column 'Quantity on Hand KGs' =
			VAR LBtoKG = MAXX ( 'Conversion Constants', 'Conversion Constants'[LB to KG] )
			VAR Qty    = 'Inventory'[Quantity on Hand]
			VAR UOM    = TRIM ( 'Inventory'[Primary Unit of Measure] )
			RETURN
			    SWITCH (
			        TRUE (),
			        UOM = "KG", Qty,
			        UOM = "LB", Qty * LBtoKG,
			        Qty * 'Inventory'[KG Factor]
			    )
		dataType: double
		formatString: #,0
		lineageTag: 21a10000-0000-4000-8000-00000000010f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	/// KG/LB rule, BUILD.md 2.4. primary UOM = LB -> quantity as-is;
	/// = KG -> quantity * [KG to LB]; anything else -> KGs * [KG to LB].
	/// Constants live only in the hidden 'Conversion Constants' table.
	column 'Quantity on Hand LBs' =
			VAR KGtoLB = MAXX ( 'Conversion Constants', 'Conversion Constants'[KG to LB] )
			VAR Qty    = 'Inventory'[Quantity on Hand]
			VAR UOM    = TRIM ( 'Inventory'[Primary Unit of Measure] )
			RETURN
			    SWITCH (
			        TRUE (),
			        UOM = "LB", Qty,
			        UOM = "KG", Qty * KGtoLB,
			        Qty * 'Inventory'[KG Factor] * KGtoLB
			    )
		dataType: double
		formatString: #,0
		lineageTag: 21a10000-0000-4000-8000-000000000110
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

