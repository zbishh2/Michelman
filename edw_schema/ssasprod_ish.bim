          },
          {
            "name": "Exchange Rate",
            "expression": [
              "VAR SelectedCurrency = [Selected Currency]",
              "VAR ISCalendarDate =",
              "    SELECTEDVALUE ( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    SWITCH (",
              "        SelectedCurrency,",
              "        1,",
              "//        BLANK(),",
              "            --USD",
              "            CALCULATE (",
              "                MAXX ( 'Currency Rates', 'Currency Rates'[ToRateDaily] ),",
              "                TREATAS ( { ISCalendarDate }, 'Calendar Inventory Snapshot'[Calendar Date] ),",
              "                CROSSFILTER ( 'Currency Rates'[CurrencySKey], 'Inventory Snapshot'[CurrencyASKey], BOTH )",
              "            ),",
              "        2,",
              "            --EUR",
              "            CALCULATE (",
              "                MAXX ( 'Currency Rates', 'Currency Rates'[ToRateDaily] ),",
              "                TREATAS ( { ISCalendarDate }, 'Calendar Inventory Snapshot'[Calendar Date] ),",
              "                CROSSFILTER ( 'Currency Rates'[CurrencySKey], 'Inventory Snapshot'[CurrencyBSKey], BOTH ),",
              "                USERELATIONSHIP ( 'Currency Rates'[CurrencySKey], 'Inventory Snapshot'[CurrencyBSKey] )",
              "            ),",
              "        3,",
              "            --USD",
              "            CALCULATE (",
              "                MAXX ( 'Currency Rates', 'Currency Rates'[ToRateDaily] ),",
              "                TREATAS ( { ISCalendarDate }, 'Calendar Inventory Snapshot'[Calendar Date] ),",
              "                CROSSFILTER ( 'Currency Rates'[CurrencySKey], 'Inventory Snapshot'[CurrencyASKey], BOTH )",
              "            ),",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "0.0000"
          },
          {
            "name": "Amt Unit Cost IC Input USD",
            "expression": [
              "VAR ISCalendarDate =",
              "    SELECTEDVALUE ( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    CALCULATE(",
              "        MAXX(",
              "            'Inventory Snapshot',",
              "            'Inventory Snapshot'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] )",
              "        ),",
              "        TREATAS( { ISCalendarDate }, 'Calendar Inventory Snapshot'[Calendar Date] )",
              "    )"
            ],
            "isHidden": true
          },
          {
            "name": "Amt Unit Cost IC UOM USD",
            "expression": [
              "// Amt Unit Cost IC UOM",
              "VAR SelectedUOM = [Selected UOM]",
              "RETURN",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, SUMX( 'Inventory Snapshot', [Amt Unit Cost IC Input USD] ),",
              "        2,",
              "            SUMX(",
              "                'Inventory Snapshot',",
              "                [Amt Unit Cost IC Input USD] * 'Inventory Snapshot'[ToRateUMA]",
              "            ),",
              "        3,",
              "            SUMX(",
              "                'Inventory Snapshot',",
              "                [Amt Unit Cost IC Input USD] * 'Inventory Snapshot'[ToRateUMB]",
              "            ),",
              "        4,",
              "            SUMX(",
              "                'Inventory Snapshot',",
              "                [Amt Unit Cost IC Input USD] * 'Inventory Snapshot'[ToRateUMC]",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "isHidden": true
          },
          {
            "name": "Amt Unit Cost IC USD",
            "expression": [
              "//Amt Unit Cost IC UOM USD",
              "//VAR UnitCost = [Amt Unit Cost IC UOM USD]",
              "//RETURN",
              "//IF(",
              "//    ISFILTERED( 'Item Branch'[Item Num 2nd and Desc] )",
              "//        || ISFILTERED( 'Item Branch'[Item Num 2nd] )",
              "//        || ISFILTERED( 'Item Branch'[Item Num 3rd] )",
              "//        || ISFILTERED( 'Item Branch'[Item Num Short] ),",
              "  [Amt Unit Cost IC UOM USD]",
              "//    BLANK( )",
              "//)"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Unit Cost"
          },
          {
            "name": "Total Ext Cost IC USD",
            "expression": [
              "CALCULATE(",
              "    SUMX( 'Inventory Snapshot', [Amt Unit Cost IC UOM USD] * [FCR Qty On Hand] )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD"
          },
          {
            "name": "MaxLocation",
            "description": "[F41021.LILOCN]",
            "expression": [
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR SelectedStringValue = ",
              "    CALCULATE(",
              "        MAX('Inventory Snapshot'[Location]),",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        )",
              "    )",
              "",
              "RETURN",
              "SelectedStringValue"
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "MaxLotNum",
            "description": "[F41021.LILOTN]",
            "expression": [
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR SelectedStringValue = ",
              "    CALCULATE(",
              "        MAX('Inventory Snapshot'[LotNum]),",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        )",
              "    )",
              "",
              "RETURN",
              "SelectedStringValue"
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "Total Unit Cost USD",
            "expression": [
              "//SUMX('Inventory Snapshot', [A1 Unit] + [B1 Unit] + [C1 Unit] + [C2 Unit] + [D1 Unit] + [X1 Unit] )",
              "",
              "VAR Master =",
              "    VAR ItemList =",
              "        VALUES ( 'Inventory Snapshot')",
              "    RETURN",
              "        GENERATE (",
              "            ItemList,",
              "            VAR A1Unit = [A1 Unit Cost USD]",
              "            VAR B1Unit = [B1 Unit Cost USD]",
              "            VAR C1Unit = [C1 Unit Cost USD]",
              "            VAR C2Unit = [C2 Unit Cost USD]",
              "            VAR D1Unit = [D1 Unit Cost USD]",
              "            VAR X1Unit = [X1 Unit Cost USD]",
              "            VAR AllUnit = A1Unit + B1Unit + C1Unit + C2Unit + D1Unit + X1Unit",
              "            RETURN",
              "                ROW ( \"AllUnit\", AllUnit )",
              "        )",
              "RETURN",
              "    MAXX ( Master, [AllUnit] )"
            ],
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD"
          },
          {
            "name": "Total Ext Cost USD",
            "expression": [
              "VAR Master =",
              "    VAR ItemList =",
              "        VALUES ( 'Inventory Snapshot')",
              "    RETURN",
              "        GENERATE (",
              "            ItemList,",
              "            VAR A1Ext = [A1 Ext Cost USD]",
              "            VAR B1Ext = [B1 Ext Cost USD]",
              "            VAR C1Ext = [C1 Ext Cost USD]",
              "            VAR C2Ext = [C2 Ext Cost USD]",
              "            VAR D1Ext = [D1 Ext Cost USD]",
              "            VAR X1Ext = [X1 Ext Cost USD]",
              "            VAR AllExt = A1Ext + B1Ext + C1Ext + C2Ext + D1Ext + X1Ext",
              "            RETURN",
              "                ROW ( \"AllExt\", AllExt )",
              "        )",
              "RETURN",
              "    SUMX ( Master, [AllExt] )"
            ],
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD"
          },
          {
            "name": "Total Ext Cost IS",
            "expression": [
              "CALCULATE(",
              "    SUMX( 'Inventory Snapshot', [Amt Unit Cost IS UOM] * [FCR Qty On Hand] )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "Total Ext Cost IS USD",
            "expression": [
              "CALCULATE(",
              "    SUMX( 'Inventory Snapshot', [Amt Unit Cost IS UOM USD] * [FCR Qty On Hand] )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD"
          },
          {
            "name": "Amt Unit Cost IS UOM USD",
            "expression": [
              "// Amt Unit Cost IC UOM",
              "VAR SelectedUOM = [Selected UOM]",
              "RETURN",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, SUMX( 'Inventory Snapshot', [Amt Unit Cost IS Input USD] ),",
              "        2,",
              "            SUMX(",
              "                'Inventory Snapshot',",
              "                [Amt Unit Cost IS Input USD] * 'Inventory Snapshot'[ToRateUMA]",
              "            ),",
              "        3,",
              "            SUMX(",
              "                'Inventory Snapshot',",
              "                [Amt Unit Cost IS Input USD] * 'Inventory Snapshot'[ToRateUMB]",
              "            ),",
              "        4,",
              "            SUMX(",
              "                'Inventory Snapshot',",
              "                [Amt Unit Cost IS Input USD] * 'Inventory Snapshot'[ToRateUMC]",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "isHidden": true
          },
          {
            "name": "Amt Unit Cost IS Input USD",
            "expression": [
              "VAR ISCalendarDate =",
              "    SELECTEDVALUE ( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    CALCULATE(",
              "        MAXX(",
              "            'Inventory Snapshot',",
              "            'Inventory Snapshot'[AmountUnitCost_IS] * RELATED( 'Currency Rates'[ToRateDaily] )",
              "        ),",
              "        TREATAS( { ISCalendarDate }, 'Calendar Inventory Snapshot'[Calendar Date] )",
              "    )"
            ],
            "isHidden": true
          },
          {
            "name": "Qty On Hand KG old",
            "expression": [
              "//VAR SelectedUOM = [Selected UOM]",
              "",
              "VAR AverageRateUMB = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMB])",
              ")",
              "",
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR TotalQOH = SUMX(",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[BranchISKey],",
              "        'Inventory Snapshot'[ItemNumShort],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "        \"AverageQty\", ",
              "        AVERAGE('Inventory Snapshot'[QuantityOnHandPrimaryUOM]) * AverageRateUMB",
              "    ),",
              "    [AverageQty]",
              ")",
              "",
              "VAR AverageQOH = TotalQOH / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "",
              "RETURN",
              "AverageQOH"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "displayFolder": "_Qty\\_KG_LB"
          },
          {
            "name": "Qty On Hand LB old",
            "expression": [
              "//VAR SelectedUOM = [Selected UOM]",
              "",
              "VAR AverageRateUMA = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMA])",
              ")",
              "",
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR TotalQOH = SUMX(",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[BranchISKey],",
              "        'Inventory Snapshot'[ItemNumShort],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "        \"AverageQty\", ",
              "        AVERAGE('Inventory Snapshot'[QuantityOnHandPrimaryUOM]) * AverageRateUMA",
              "    ),",
              "    [AverageQty]",
              ")",
              "",
              "VAR AverageQOH = TotalQOH / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "",
              "RETURN",
              "AverageQOH"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "displayFolder": "_Qty\\_KG_LB"
          },
          {
            "name": "Off Spec Amount New",
            "expression": [
              "SUMX(",
              "    'Inventory Snapshot',",
              "    VAR CATGL = TRIM( SELECTEDVALUE( 'Inventory Snapshot'[CategoryGLF41021] ) )",
              "    VAR DOH = [Days on Hand]",
              "    VAR LSC = SELECTEDVALUE( 'Inventory Snapshot'[Lot Status Code] )",
              "    VAR AUC = [Amt Unit Cost IS]",
              "    VAR QOH = [Qty On Hand]",
              "    RETURN",
              "        IF(",
              "            HASONEVALUE( 'Inventory Snapshot'[CategoryGLF41021] ),  --eliminates Total = 0.00 in pbi",
              "            SWITCH(",
              "                TRUE( ),",
              "                CATGL IN { \"IN32\", \"IN38\" } && DOH >= 365, 0,",
              "                LSC IN { \"H\", \"E\", \"R\" }, 0.6,",
              "                LSC IN { \"B\" }, 0.25,",
              "                LSC IN { \"P\", \"Z\" }, 1,",
              "                0",
              "            )",
              "                * AUC",
              "                * QOH,",
              "            BLANK( )",
              "        )",
              ")"
            ],
            "displayFolder": "_Amt\\_Off Spec"
          },
          {
            "name": "Off Spec Quantity New",
            "expression": [
              "SUMX(",
              "    'Inventory Snapshot',",
              "    VAR CATGL = TRIM( SELECTEDVALUE( 'Inventory Snapshot'[CategoryGLF41021] ) )",
              "    VAR DOH = [Days on Hand]",
              "    VAR LSC = SELECTEDVALUE( 'Inventory Snapshot'[Lot Status Code] )",
              "    --VAR AUC = [Amt Unit Cost IS]",
              "    VAR QOH = [Qty On Hand]",
              "    RETURN",
              "        IF(",
              "            HASONEVALUE( 'Inventory Snapshot'[CategoryGLF41021] ),  --eliminates Total = 0.00 in pbi",
              "            SWITCH(",
              "                TRUE( ),",
              "                CATGL IN { \"IN32\", \"IN38\" } && DOH >= 365, 0,",
              "                LSC IN { \"H\", \"E\", \"R\" }, 0.6,",
              "                LSC IN { \"B\" }, 0.25,",
              "                LSC IN { \"P\", \"Z\" }, 1,",
              "                0",
              "            )",
              "                -- * AUC",
              "                * QOH,",
              "            BLANK( )",
              "        )",
              ")"
            ],
            "displayFolder": "_Qty"
          },
          {
            "name": "Off Spec Disposal New",
            "expression": [
              "SUMX(",
              "    'Inventory Snapshot',",
              "    VAR CATGL = TRIM( SELECTEDVALUE( 'Inventory Snapshot'[CategoryGLF41021] ) )",
              "    VAR DOH = [Days on Hand]",
              "    VAR LSC = SELECTEDVALUE( 'Inventory Snapshot'[Lot Status Code] )",
              "    --VAR AUC = [Amt Unit Cost IS]",
              "    VAR QOH = [Qty On Hand]",
              "    RETURN",
              "        IF(",
              "            HASONEVALUE( 'Inventory Snapshot'[CategoryGLF41021] ),  --eliminates Total = 0.00 in pbi",
              "            SWITCH(",
              "                TRUE( ),",
              "                CATGL IN { \"IN32\", \"IN38\" } && DOH >= 365, 0,       -- && is the DAX And syntax",
              "                LSC IN { \"H\", \"E\", \"R\" }, 0.6,",
              "                LSC IN { \"B\" }, 0.25,",
              "                LSC IN { \"P\", \"Z\" }, 1,",
              "                0",
              "            )",
              "                -- * AUC",
              "                * QOH",
              "                * [Lot Status Disposal Multiplier Input],",
              "            BLANK( )",
              "        )",
              ")"
            ],
            "displayFolder": "_Qty"
          },
          {
            "name": "Aging Amount New",
            "expression": [
              "SUMX(",
              "    'Inventory Snapshot',                   --note this includes defined variables for Off Spec Amt New just to show consistency",
              "    VAR CATGL = TRIM( SELECTEDVALUE( 'Inventory Snapshot'[CategoryGLF41021] ) )",
              "    VAR DOH = [Days on Hand]",
              "    VAR LSC = SELECTEDVALUE( 'Inventory Snapshot'[Lot Status Code] )",
              "    VAR MPF = SELECTEDVALUE( 'Item Branch'[Master Planning Family] )",
              "    VAR AUC = [Amt Unit Cost IS]",
              "    VAR QOH = [Qty On Hand]",
              "    RETURN",
              "        IF(",
              "            HASONEVALUE( 'Inventory Snapshot'[CategoryGLF41021] ),  --eliminates Total = 0.00 in pbi",
              "            SWITCH(",
              "                TRUE( ),",
              "                CATGL IN { \"IN21\", \"IN30\" } && LSC IN { \"B\", \"E\", \"H\", \"P\", \"R\", \"Z\" }, 0,",
              "                MPF <> { \"PKG\" } && DOH >= 365 && CATGL IN { \"IN21\", \"IN30\" }, 0.40,",
              "                CATGL IN { \"IN32\", \"IN38\" } && DOH >= 365, 1,",
              "                0",
              "            )",
              "                * AUC",
              "                * QOH,",
              "            BLANK( )",
              "        )",
              ")"
            ],
            "displayFolder": "_Amt\\_Aging"
          },
          {
