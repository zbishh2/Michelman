          {
            "name": "Total Ext Cost IC",
            "expression": [
              "CALCULATE(",
              "    SUMX( 'Inventory Snapshot', [Amt Unit Cost IC UOM] * [FCR Qty On Hand] )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "FCR Amt Off Spec",
            "expression": [
              "[FCR Qty On Hand] * [Amt Unit Cost IC]",
              "    * [Lot Status Multiplier Input]"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "isHidden": true,
            "displayFolder": "_Frozen Cost Rollup\\_Temp",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "FCR Amt Aging",
            "expression": "[FCR Qty Aging] * [Amt Unit Cost IC]",
            "isHidden": true,
            "displayFolder": "_Frozen Cost Rollup\\_Temp"
          },
          {
            "name": "Total Ext Cost IC Sum",
            "expression": [
              "SUMX(",
              "    SUMMARIZE(",
              "        'Inventory Snapshot',",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        \"Total Average\",",
              "            AVERAGEX( 'Inventory Snapshot', [Amt Unit Cost IC] * [FCR Qty On Hand] )",
              "    ),",
              "    [Total Average]",
              ")"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "Total Ext Cost Sum",
            "expression": [
              "SUMX(",
              "    SUMMARIZE(",
              "        'Inventory Snapshot',",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        \"Total Average\",",
              "            AVERAGEX( 'Inventory Snapshot', [Total Ext Cost] )",
              "    ),",
              "    [Total Average]",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "Off Spec Quantity",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        [Qty On Hand] * [Lot Status Multiplier Input]",
              "    )",
              ")"
            ],
            "displayFolder": "_Qty"
          },
          {
            "name": "Off Spec Disposal",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        [Qty On Hand] * [Lot Status Multiplier Input]",
              "            * [Lot Status Disposal Multiplier Input]",
              "    )",
              ")"
            ],
            "displayFolder": "_Qty"
          },
          {
            "name": "Aging Quantity",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        [Qty On Hand] * [Aging Flag Input]",
              "            * [Aging Multiplier Input]",
              "    )",
              ")"
            ],
            "displayFolder": "_Qty"
          },
          {
            "name": "Aging Disposal",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        [Qty On Hand] * [Lot Status Multiplier Input]",
              "    )",
              ")"
            ],
            "displayFolder": "_Qty"
          },
          {
            "name": "Off Spec Amount",
            "expression": [
              "SUMX(",
              "    SUMMARIZE(",
              "        'Inventory Snapshot',",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        \"Total Average\",",
              "            AVERAGEX( 'Inventory Snapshot', [FCR Amt Off Spec] )",
              "    ),",
              "    [Total Average]",
              ")"
            ],
            "displayFolder": "_Amt\\_Off Spec"
          },
          {
            "name": "Aging Amount",
            "expression": [
              "SUMX(",
              "    SUMMARIZE(",
              "        'Inventory Snapshot',",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        \"Total Average\",",
              "            AVERAGEX( 'Inventory Snapshot', [FCR Amt Aging] )",
              "    ),",
              "    [Total Average]",
              ")"
            ],
            "displayFolder": "_Amt\\_Aging"
          },
          {
            "name": "SS Variance",
            "expression": "[Qty Available] - [Safety Stock]",
            "displayFolder": "_Reorder and SS"
          },
          {
            "name": "Total Ext Cost IC Sum USD",
            "expression": [
              "VAR ISCalendarDate =",
              "    SELECTEDVALUE ( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    CALCULATE(",
              "        SUMX(",
              "            SUMMARIZE(",
              "                'Inventory Snapshot',",
              "                'Inventory Snapshot'[ItemBranchISKey],",
              "                'Inventory Snapshot'[Location],",
              "                'Inventory Snapshot'[LotNum],",
              "                \"Total Average\",",
              "                AVERAGEX( 'Inventory Snapshot', [Total Ext Cost IC USD] )",
              "            ),",
              "            [Total Average]",
              "        ),",
              "        TREATAS ( { ISCalendarDate }, 'Inventory Snapshot'[Calendar Date] )",
              "    )"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD"
          },
          {
            "name": "Qty On Hand : Eff not Exp",
            "expression": [
              "// Qty On Hand",
              "SUMX(",
              "    FILTER(",
              "        'Lot',",
              "        'Lot'[Lot Expiration Date] > TODAY() &&",
              "        'Lot'[Lot Effectivity Date] < TODAY()",
              "    ),",
              "    [Qty On Hand]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "_Qty"
          },
          {
            "name": "Qty On Hand : Exp not Eff",
            "expression": [
              "// Qty On Hand",
              "SUMX(",
              "    FILTER(",
              "        'Lot',",
              "        'Lot'[Lot Expiration Date] <= TODAY() ||",
              "        'Lot'[Lot Effectivity Date] > TODAY()",
              "    ),",
              "    [Qty On Hand]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "_Qty"
          },
          {
            "name": "Safety Stock %",
            "description": "[F4102.IBSAFE]",
            "expression": [
              "// Safety Stock %",
              "DIVIDE([Qty Available],[Safety Stock])",
              "",
              "/*",
              "VAR SelectedUOM = [Selected UOM]",
              "",
              "VAR SSPC = DIVIDE([Qty Available],SUM('Item Branch'[SafetyStock]))",
              "",
              "RETURN",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, SSPC,",
              "        2, SSPC * MAX( 'Inventory Snapshot'[ToRateUMA] ),",
              "        3, SSPC * MAX( 'Inventory Snapshot'[ToRateUMB] ),",
              "        4, SSPC * MAX( 'Inventory Snapshot'[ToRateUMC] ),",
              "        BLANK( )",
              "    )",
              "    */"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "_Reorder and SS"
          },
          {
            "name": "QoH PUOM 060",
            "expression": "SUMX(FILTER('Inventory Snapshot', RELATED('Lot'[060]) = 1), 'Inventory Snapshot'[QuantityOnHandPrimaryUOM])",
            "formatString": "#,0",
            "displayFolder": "_60_90_120_180\\_Primary UOM"
          },
