          {
            "name": "A1 Ext Cost USD",
            "expression": [
              "//VAR ISCalendarDate =",
              "//    SELECTEDVALUE ( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "//VAR UnitCost = [A1 Ext]",
              "//RETURN",
              "//    CALCULATE(",
              "//        MAXX(",
              "//            'Inventory Snapshot',",
              "//            UnitCost * RELATED( 'Currency Rates'[ToRateDaily] )",
              "//        ),",
              "//        TREATAS ( { ISCalendarDate }, 'Currency Rates'[CalendarDate] )",
              "//    )",
              "//",
              "//",
              "",
              "//SUMX( 'Inventory Snapshot', [A1 Unit Cost USD] * [FCR Qty On Hand] )",
              "",
              "VAR Master =",
              "    VAR ItemList =",
              "        VALUES ( 'Inventory Snapshot')",
              "    RETURN",
              "        GENERATE (",
              "            ItemList,",
              "            VAR A1Ext = [A1 Unit Cost USD]",
              "            VAR FCR = [FCR Qty On Hand]",
              "            VAR AllExt = A1Ext * FCR",
              "            RETURN",
              "                ROW ( \"AllExt\", AllExt )",
              "        )",
              "RETURN",
              "    SUMX ( Master, [AllExt] )"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Ext\\_USD"
          },
