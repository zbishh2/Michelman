        "partitions": [
          {
            "name": "Inventory Snapshot History",
            "mode": "import",
            "source": {
              "query": "select * from BIQL.TbInventorySnapshotFCR_History",
              "dataSource": "BIQLJDE"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM BIQL.TbInventorySnapshot_ItemBranch</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Reorder Point",
            "description": "[F4102.IBROPI]",
            "expression": [
              "// Reorder Point",
              "VAR SelectedUOM = [Selected UOM]",
              "RETURN",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, SUM( 'Item Branch'[ReorderPoint] ),",
              "        2,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderPoint]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMA] )",
              "            ),",
              "        3,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderPoint]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMB] )",
              "            ),",
              "        4,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderPoint]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMC] )",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "_Reorder and SS"
          },
          {
            "name": "Reorder Qty",
            "description": "[F4102.IBROQI]",
            "expression": [
              "// Reorder Qty",
              "//SUM('Item Branch'[ReorderQuantity])",
              "VAR SelectedUOM = [Selected UOM]",
              "RETURN",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, SUM( 'Item Branch'[ReorderQuantity] ),",
              "        2,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantity]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMA] )",
              "            ),",
              "        3,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantity]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMB] )",
              "            ),",
              "        4,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantity]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMC] )",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "_Reorder and SS"
          },
          {
            "name": "Reorder Qty Max",
            "description": "[F4102.IBRQMX]",
            "expression": [
              "// Reorder Qty Max",
              "VAR SelectedUOM = [Selected UOM]",
              "RETURN",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, SUM( 'Item Branch'[ReorderQuantityMaximum] ),",
              "        2,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantityMaximum]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMA] )",
              "            ),",
              "        3,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantityMaximum]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMB] )",
              "            ),",
              "        4,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantityMaximum]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMC] )",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "_Reorder and SS"
          },
          {
            "name": "Reorder Qty Min",
            "description": "[F4102.IBRQMN]",
            "expression": [
              "// Reorder Qty Min",
              "VAR SelectedUOM = [Selected UOM]",
              "RETURN",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, SUM( 'Item Branch'[ReorderQuantityMinimum] ),",
              "        2,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantityMinimum]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMA] )",
              "            ),",
              "        3,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantityMinimum]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMB] )",
              "            ),",
              "        4,",
              "            SUMX(",
              "                'Item Branch',",
              "                'Item Branch'[ReorderQuantityMinimum]",
              "                    * MAX( 'Inventory Snapshot'[ToRateUMC] )",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "_Reorder and SS"
          },
          {
            "name": "Safety Stock",
            "description": "[F4102.IBSAFE]",
            "expression": [
              "VAR SelectedUOM = [Selected UOM]",
              "",
              "//VAR AverageRateUMA = CALCULATE(",
              "//    AVERAGE('Inventory Snapshot'[ToRateUMA])",
              "//)",
              "//",
              "//VAR AverageRateUMB = CALCULATE(",
              "//    AVERAGE('Inventory Snapshot'[ToRateUMB])",
              "//)",
              "//",
              "//VAR AverageRateUMC = CALCULATE(",
              "//    AVERAGE('Inventory Snapshot'[ToRateUMC])",
              "//)",
              "//",
              "//VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "//",
              "//VAR TotalQ = SUMX(",
              "//    SUMMARIZE(",
              "//        FILTER(",
              "//            'Inventory Snapshot', ",
              "//            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "//        ),",
              "//        'Inventory Snapshot'[ItemBranchISKey],",
              "//        'Inventory Snapshot'[Location],",
              "//        'Inventory Snapshot'[LotNum],",
              "//        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "//        \"AverageQty\", ",
              "//        SWITCH(",
              "//            SelectedUOM,",
              "//            1, AVERAGE('Inventory Snapshot'[SafetyStock]),",
              "//            2, AVERAGE('Inventory Snapshot'[SafetyStock]) * AverageRateUMA,",
              "//            3, AVERAGE('Inventory Snapshot'[SafetyStock]) * AverageRateUMB,",
              "//            4, AVERAGE('Inventory Snapshot'[SafetyStock]) * AverageRateUMC,",
              "//               AVERAGE('Inventory Snapshot'[SafetyStock]) // Default to no conversion if none match.",
              "//        )",
              "//    ),",
              "//    [AverageQty]",
              "//)",
              "//",
              "//VAR AverageQ = TotalQ / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "//",
              "//RETURN",
              "//AverageQ",
              "RETURN",
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        SWITCH(",
              "            SelectedUOM,",
              "            1,  'Inventory Snapshot'[SafetyStock] ,",
              "            2,  'Inventory Snapshot'[SafetyStock]  * 'Inventory Snapshot'[ToRateUMA],",
              "            3,  'Inventory Snapshot'[SafetyStock]  * 'Inventory Snapshot'[ToRateUMB],",
              "            4,  'Inventory Snapshot'[SafetyStock]  * 'Inventory Snapshot'[ToRateUMC],",
              "            'Inventory Snapshot'[SafetyStock]",
              "            ",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "_Reorder and SS"
          },
          {
            "name": "Qty On Hand Primary UOM",
            "expression": [
              "//VAR SelectedUOM = [Selected UOM]",
              "",
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR TotalQOH = SUMX(",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "        \"AverageQty\", ",
              "        AVERAGE('Inventory Snapshot'[QuantityOnHandPrimaryUOM])",
              "    ),",
              "    [AverageQty]",
              ")",
              "",
              "VAR AverageQOH = TotalQOH / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "",
              "RETURN",
              "AverageQOH"
            ],
            "isHidden": true
          },
          {
            "name": "Lot Status Disposal Multiplier Input",
            "expression": [
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR TotalLSM = SUMX(",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "        \"AverageQty\", ",
              "        AVERAGE('Inventory Snapshot'[DisposalMultiplier])",
              "    ),",
              "    [AverageQty]",
              ")",
              "",
              "VAR AverageLSM = TotalLSM / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "",
              "RETURN",
              "AverageLSM"
            ],
            "isHidden": true
          },
          {
            "name": "Lot Status Multiplier Input",
            "expression": [
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR TotalLSM = SUMX(",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "        \"AverageQty\", ",
              "        AVERAGE('Inventory Snapshot'[LotStatusMultiplier])",
              "    ),",
              "    [AverageQty]",
              ")",
              "",
              "VAR AverageLSM = TotalLSM / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "",
              "RETURN",
              "AverageLSM"
            ],
            "isHidden": true
          },
          {
            "name": "Aging Multiplier Input",
            "expression": "CALCULATE( MAX( 'Inventory Snapshot'[AgingMultiplier] ) )",
            "isHidden": true
          },
          {
            "name": "Aging Flag Input",
            "expression": [
              "VAR MaxAgingFlag = MAX('Inventory Snapshot'[AgingFlag])",
              "",
              "RETURN",
              "MaxAgingFlag"
            ],
            "isHidden": true
          },
          {
            "name": "Total Unit Cost",
            "expression": [
              "//SUMX('Inventory Snapshot', [A1 Unit] + [B1 Unit] + [C1 Unit] + [C2 Unit] + [D1 Unit] + [X1 Unit] )",
              "",
              "VAR Master =",
              "    VAR ItemList =",
              "        VALUES ( 'Inventory Snapshot')",
              "    RETURN",
              "        GENERATE (",
              "            ItemList,",
              "            VAR A1Unit = [A1 Unit]",
              "            VAR B1Unit = [B1 Unit]",
              "            VAR C1Unit = [C1 Unit]",
              "            VAR C2Unit = [C2 Unit]",
              "            VAR D1Unit = [D1 Unit]",
              "            VAR X1Unit = [X1 Unit]",
              "            VAR AllUnit = A1Unit + B1Unit + C1Unit + C2Unit + D1Unit + X1Unit",
              "            RETURN",
              "                ROW ( \"AllUnit\", AllUnit )",
              "        )",
              "RETURN",
              "    MAXX ( Master, [AllUnit] )"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "Total Ext Cost",
            "expression": [
              "//SUMX( 'Inventory Snapshot', ( [A1 Ext] + [B1 Ext] + [C1 Ext] + [C2 Ext] + [D1 Ext] + [X1 Ext] ) )",
              "",
              "VAR Master =",
              "    VAR ItemList =",
              "        VALUES ( 'Inventory Snapshot')",
              "    RETURN",
              "        GENERATE (",
              "            ItemList,",
              "            VAR A1Ext = [A1 Ext]",
              "            VAR B1Ext = [B1 Ext]",
              "            VAR C1Ext = [C1 Ext]",
              "            VAR C2Ext = [C2 Ext]",
              "            VAR D1Ext = [D1 Ext]",
              "            VAR X1Ext = [X1 Ext]",
              "            VAR AllExt = A1Ext + B1Ext + C1Ext + C2Ext + D1Ext + X1Ext",
              "            RETURN",
              "                ROW ( \"AllExt\", AllExt )",
              "        )",
              "RETURN",
              "    SUMX ( Master, [AllExt] )"
            ],
            "formatString": "#,0.00",
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "X1 Ext",
            "expression": [
              "//SUMX( 'Inventory Snapshot', [X1 Unit] * [FCR Qty On Hand] )",
              "",
              "VAR Master =",
              "    VAR ItemList =",
              "        VALUES ( 'Inventory Snapshot')",
              "    RETURN",
              "        GENERATE (",
              "            ItemList,",
              "            VAR A1Ext = [X1 Unit]",
              "            VAR FCR = [FCR Qty On Hand]",
              "            VAR AllExt = A1Ext * FCR",
              "            RETURN",
              "                ROW ( \"AllExt\", AllExt )",
              "        )",
              "RETURN",
              "    SUMX ( Master, [AllExt] )"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Ext"
          },
          {
            "name": "D1 Ext",
            "expression": [
              "//SUMX( 'Inventory Snapshot', [D1 Unit] * [FCR Qty On Hand] )",
