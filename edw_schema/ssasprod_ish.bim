          {
            "name": "Item Branch_Sales",
            "mode": "import",
            "source": {
              "query": "SELECT * FROM BIQL.TbItemBranch_Sales_History",
              "dataSource": "BIQLJDE"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM BIQL.TbItemBranch_Sales</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Safety Stock (Item Branch)",
            "expression": [
              "",
              "",
              "VAR detail =",
              "",
              "    CALCULATE(",
              "    MIN('Item Branch'[SafetyStock])",
              ")",
              "    ",
              "VAR summary =",
              "    CALCULATE(",
              "        SUM( 'Item Branch'[SafetyStock] ) ",
              "    )",
              "RETURN",
              "    SWITCH ( TRUE (), ISINSCOPE ( 'Item Branch'[SafetyStock] ), detail, summary )",
              "",
              ""
            ],
            "formatString": "#,0"
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "Item Branch"
          },
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": [
              "SELECT IB.*, ",
              "            I.CategoryGL as Category_GL_4101 ",
              "FROM BIQL.TbItemBranch AS IB",
              "LEFT JOIN dbo.DimItem AS I",
              "   ON I.ItemNumShort = IB.[Item Num Short]"
            ]
          },
          {
            "name": "QueryEditorSerialization",
            "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM BIQL.TbItemBranch</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
          }
        ]
      },
