            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Unit Cost"
          },
          {
            "name": "A1 Unit Input",
            "expression": [
              "VAR SelectedCurrency = [Selected Currency] ",
              "VAR ISCalendarDate =",
              "    SELECTEDVALUE ( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    //\tISCalendarDate",
              "    SWITCH (",
              "        SelectedCurrency,",
              "        1, --local",
              "        MAXX ( 'Inventory Snapshot', 'Inventory Snapshot'[A1_Unit] ),",
              "        2,",
              "            --USD",
              "            CALCULATE (",
              "                MAXX (",
              "                    'Inventory Snapshot',",
              "                    'Inventory Snapshot'[A1_Unit] * RELATED ( 'Currency Rates'[ToRateDaily] )",
              "                ),",
              "                TREATAS ( { ISCalendarDate }, 'Inventory Snapshot'[Calendar Date] )",
