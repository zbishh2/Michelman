            "sourceColumn": "Calendar Desc"
          },
          {
            "name": "CalendarPatternSKey",
            "dataType": "int64",
            "sourceColumn": "CalendarPatternSKey"
          },
          {
            "name": "DefaultCalendar",
            "dataType": "int64",
            "sourceColumn": "DefaultCalendar"
          }
        ],
        "partitions": [
          {
            "name": "Calendar Filter",
            "source": {
              "query": "SELECT * FROM BIQL.TbCalendarFilter",
              "dataSource": "BIQLJDE"
            }
          }
        ],
        "measures": [
          {
            "name": "SelectedCalendar",
            "expression": [
              "",
              "IF(",
              "    HASONEVALUE( 'Calendar Filter'[CalendarPatternSKey] ),",
              "    VALUES( 'Calendar Filter'[CalendarPatternSKey] ),",
              "    CALCULATE(",
              "        MIN( 'Calendar Filter'[CalendarPatternSKey] ),",
              "        'Calendar Filter'[DefaultCalendar] = 1",
              "    )",
              ")"
            ]
          }
        ]
      },
