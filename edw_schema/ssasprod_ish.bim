              "//                2, AVERAGE( 'Inventory Snapshot'[QuantityOnHandPrimaryUOM] ) * AverageRateUMA,",
              "//                3, AVERAGE( 'Inventory Snapshot'[QuantityOnHandPrimaryUOM] ) * AverageRateUMB,",
