        "name": "Selected UOM Filter",
        "columns": [
          {
            "name": "Selected UOM Code",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Selected UOM Code"
          },
          {
            "name": "Selected UOM Filter",
            "dataType": "string",
            "sourceColumn": "Selected UOM Filter"
          },
          {
            "name": "DefaultUOM",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "DefaultUOM"
          }
        ],
        "partitions": [
          {
            "name": "Selected UOM Filter",
            "mode": "import",
            "source": {
              "query": "select * from BIQL.TbSelectedUOMFilter",
              "dataSource": "BIQLJDE"
            }
          }
        ],
        "measures": [
          {
            "name": "Selected UOM",
            "expression": [
              "",
              "//Selected UOM",
              "IF(",
              "    HASONEVALUE( 'Selected UOM Filter'[Selected UOM Filter] ),",
              "    VALUES( 'Selected UOM Filter'[Selected UOM Code] ),",
              "    CALCULATE(",
              "        SELECTEDVALUE( 'Selected UOM Filter'[Selected UOM Code] ),",
              "        'Selected UOM Filter'[DefaultUOM] = 1",
              "    )",
              ")"
            ],
            "isHidden": true
          }
        ]
      },
