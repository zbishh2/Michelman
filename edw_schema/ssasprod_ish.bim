            "name": "Item Cost X1 Unit Input",
            "expression": [
              "VAR SelectedCurrency = [Selected Currency]",
              "VAR ISCalendarDate = SELECTEDVALUE( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    //\tISCalendarDate",
              "    SWITCH(",
              "        SelectedCurrency,",
              "        1, --local",
              "        MAXX( 'Item Cost', 'Item Cost'[X1_Unit] ),",
              "        2,",
              "            --USD",
              "            CALCULATE(",
              "                CALCULATE(",
              "                    MAXX( 'Item Cost', 'Item Cost'[X1_Unit] * RELATED( 'Currency Rates'[ToRateDaily] ) ),",
              "                    TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                ),",
              "                USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyASKey] )",
              "            ),",
              "        3,",
              "            --EUR",
              "            CALCULATE(",
              "                CALCULATE(",
              "                    MAXX( 'Item Cost', 'Item Cost'[X1_Unit] * RELATED( 'Currency Rates'[ToRateDaily] ) ),",
              "                    TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                ),",
              "                USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyBSKey] )",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#0.0000",
            "isHidden": true
          },
          {
            "name": "Unit Cost Total",
            "expression": [
              "//A1 Unit",
              "VAR UnitCost = [Item Cost Unit]",
              "RETURN",
              "    IF(",
              "        ISFILTERED( 'Item Branch'[Item Num 2nd and Desc] ) || ISFILTERED( 'Item Branch'[Item Num 2nd] )",
              "            || ISFILTERED( 'Item Branch'[Item Num 3rd] )",
              "            || ISFILTERED( 'Item Branch'[Item Num Short] ),",
              "        MAXX( 'Item Cost', UnitCost ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,##0.0000000",
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "Unit Cost Total Avg USD",
            "expression": "MAXX( 'Item Cost', [Unit Cost Total] * RELATED( 'Currency Rates'[ToRateA] ) )",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD\\Average"
          },
          {
            "name": "Unit Cost Total Avg USD KG",
            "expression": "MAXX( 'Item Cost', [Unit Cost Total] * RELATED( 'Currency Rates'[ToRateA] ) * [ConvertKG] )",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD_KG\\Average"
          },
          {
            "name": "Unit Cost Total Avg USD LBS",
            "expression": "[Unit Cost Total Avg USD] * [ConvertLB]",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD_LBS\\Average"
          },
          {
            "name": "Unit Cost Total Budget USD",
            "expression": "MAXX( 'Item Cost', [Unit Cost Total] * RELATED( 'Currency Rates'[ToRateB] ) )",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD\\Budget"
          },
          {
            "name": "Unit Cost Total Budget USD KG",
            "expression": "MAXX( 'Item Cost', [Unit Cost Total] * RELATED( 'Currency Rates'[ToRateB] ) * [ConvertKG] )",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD_KG\\Budget"
          },
          {
            "name": "Unit Cost Total Budget USD LBS",
            "expression": "[Unit Cost Total Budget USD] * [ConvertLB] ",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD_LBS\\Budget"
          },
          {
            "name": "Unit Cost Total UOM",
            "expression": [
              "//A1 Unit",
              "VAR UnitCost = [Item Cost Unit UOM]",
              "RETURN",
              "    IF(",
              "        ISFILTERED( 'Item Branch'[Item Num 2nd and Desc] ) || ISFILTERED( 'Item Branch'[Item Num 2nd] )",
              "            || ISFILTERED( 'Item Branch'[Item Num 3rd] )",
              "            || ISFILTERED( 'Item Branch'[Item Num Short] ),",
              "        MAXX( 'Item Cost', UnitCost ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,##0.000000000",
            "displayFolder": "_Frozen Cost Rollup\\_Total"
          },
          {
            "name": "Unit Cost Total USD",
            "expression": "MAXX( 'Item Cost', [Unit Cost Total] * RELATED( 'Currency Rates'[ToRateDaily] ) )",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD\\Daily"
          },
          {
            "name": "Unit Cost Total USD KG",
            "expression": "MAXX( 'Item Cost', [Unit Cost Total] * RELATED( 'Currency Rates'[ToRateDaily] ) * [ConvertKG] )",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD_KG\\Daily"
          },
          {
            "name": "Unit Cost Total USD LBS",
            "expression": "[Unit Cost Total Avg USD] * [ConvertLB] ",
            "formatString": "#,##0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Total\\_USD_LBS\\Daily"
          }
        ]
      },
