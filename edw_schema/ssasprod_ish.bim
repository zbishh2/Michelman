        "partitions": [
          {
            "name": "Calendar",
            "source": {
              "query": "SELECT * FROM BIQL.TbCalendarSnapshot",
              "dataSource": "BIQLJDE"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM BIQL.TbCalendarSnapshot</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Thru Date 1",
            "expression": [
              "",
              "VAR SelectedCalendar =",
              "    FILTER(",
              "        'Calendar Inventory Snapshot',",
              "        'Calendar Inventory Snapshot'[CalendarPatternSKey] = [SelectedCalendar]",
              "    )",
              "RETURN",
              "    FORMAT(",
              "        CALCULATE(",
              "            MAX( 'Calendar Inventory Snapshot'[Calendar Date] ),",
              "            SelectedCalendar",
              "        ),",
              "        \"MM/DD/YYYY\"",
              "    )"
            ],
            "displayFolder": "_Date Titles"
          },
          {
            "name": "Range Date 1",
            "expression": [
              "",
              "VAR SelectedCalendar =",
              "    FILTER(",
              "        'Calendar Inventory Snapshot',",
              "        'Calendar Inventory Snapshot'[CalendarPatternSKey] = [SelectedCalendar]",
              "    )",
              "RETURN",
              "    FORMAT(",
              "        CALCULATE(",
              "            MIN( 'Calendar Inventory Snapshot'[Calendar Date] ),",
              "            SelectedCalendar",
              "        ),",
              "        \"MM/DD/YYYY\"",
              "    )",
              "        & \"  to  \"",
              "        & FORMAT(",
              "            CALCULATE(",
              "                MAX( 'Calendar Inventory Snapshot'[Calendar Date] ),",
              "                SelectedCalendar",
              "            ),",
              "            \"MM/DD/YYYY\"",
              "        )"
            ],
            "displayFolder": "_Date Titles"
          },
          {
            "name": "Period Title 1",
            "expression": [
              "",
              "VAR SelectedCalendar =",
              "    FILTER(",
              "        'Calendar Inventory Snapshot',",
              "        'Calendar Inventory Snapshot'[CalendarPatternSKey] = [SelectedCalendar]",
              "    )",
              "RETURN",
              "    \"Period Ending \"",
              "        & CALCULATE(",
              "            CALCULATE(",
              "                VALUES( 'Calendar Inventory Snapshot'[Period Year] ),",
              "                FILTER(",
              "                    'Calendar Inventory Snapshot',",
              "                    'Calendar Inventory Snapshot'[Calendar Date]",
              "                        = MAX( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "                )",
              "            ),",
              "            SelectedCalendar",
              "        )"
            ],
            "displayFolder": "_Date Titles"
          }
        ],
        "hierarchies": [
