          {
            "name": "Lot",
            "source": {
              "query": "SELECT * FROM BIQL.TbLot",
              "dataSource": "BIQLJDE"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM BIQL.TbLot</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Days on Hand",
            "description": "Based on selected Calendar Date from Calendar Inventory Snapshot",
            "expression": [
              "",
              "VAR SelectedCalendar =",
              "    FILTER(",
              "        'Calendar Inventory Snapshot',",
              "        'Calendar Inventory Snapshot'[CalendarPatternSKey] = [SelectedCalendar]",
              "    )",
              "VAR SelectedDate =",
              "    MAX( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    CALCULATE(",
              "        AVERAGEX(",
              "            'Inventory Snapshot',",
              "            IF(",
              "                SelectedDate > RELATED( Lot[On Hand Date] ),",
              "                DATEDIFF( RELATED( Lot[On Hand Date] ), SelectedDate, DAY ),",
              "                0",
              "            )",
              "        ),",
              "        SelectedCalendar",
              "    )"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Days to Expiry Date",
            "description": "Lot Expiration Date (F4108.IOMMEJ) - Calendar Date",
            "expression": [
              "",
              "VAR SelectedCalendar =",
              "    FILTER(",
              "        'Calendar Inventory Snapshot',",
              "        'Calendar Inventory Snapshot'[CalendarPatternSKey] = [SelectedCalendar]",
              "    )",
              "VAR SelectedDate =",
              "    MAX( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    CALCULATE(",
              "        AVERAGEX(",
              "            'Inventory Snapshot',",
              "            IF(",
              "                RELATED( Lot[Lot Expiration Date] ) > SelectedDate,",
              "                DATEDIFF(",
              "                    SelectedDate,",
              "                    RELATED( Lot[Lot Expiration Date] ),",
              "                    DAY",
              "                ),",
              "                0",
              "            )",
              "        ),",
              "        SelectedCalendar",
              "    )"
            ],
            "formatString": "#,##0"
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "Lot"
          },
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": "SELECT * FROM BIQL.TbLot"
