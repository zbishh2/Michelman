        "partitions": [
          {
            "name": "Item Cost",
            "mode": "import",
            "source": {
              "query": "SELECT * FROM [BIQL].[TbItemCostFCR_History]",
              "dataSource": "BIQLJDE"
            }
          }
        ],
        "measures": [
          {
            "name": "ConvertKG",
            "expression": "MAXX( 'Item Cost', 'Item Cost'[ToRateUMB] )",
            "isHidden": true
          },
          {
            "name": "ConvertLB",
            "expression": [
              "MAXX( 'Item Cost', 'Item Cost'[ToRateUMA] )",
              ""
            ],
            "isHidden": true
          },
          {
            "name": "ConvertTM",
            "expression": "MAXX( 'Item Cost', 'Item Cost'[ToRateUMC] )",
            "isHidden": true
          },
          {
            "name": "Item Cost A1 Unit",
            "expression": [
              "//A1 Unit",
              "VAR UnitUOM = [Item Cost A1 Unit Input]",
              "RETURN",
              "    IF(",
              "        ISFILTERED( 'Item Branch'[Item Num 2nd and Desc] ) || ISFILTERED( 'Item Branch'[Item Num 2nd] )",
              "            || ISFILTERED( 'Item Branch'[Item Num 3rd] )",
              "            || ISFILTERED( 'Item Branch'[Item Num Short] ),",
              "        MAXX( 'Item Cost', UnitUOM ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Unit"
          },
          {
            "name": "Item Cost A1 Unit Cost Avg USD",
            "expression": "MAXX( 'Item Cost', [Item Cost A1 Unit] * RELATED( 'Currency Rates'[ToRateA] ) )",
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Unit\\_USD\\Average"
          },
          {
            "name": "Item Cost A1 Unit Cost Budget USD",
            "expression": "MAXX( 'Item Cost', [Item Cost A1 Unit] * RELATED( 'Currency Rates'[ToRateB] ) )",
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Unit\\_USD\\Budget"
          },
          {
            "name": "Item Cost A1 Unit Cost USD",
            "expression": "MAXX( 'Item Cost', [Item Cost A1 Unit] * RELATED( 'Currency Rates'[ToRateDaily] ) )",
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Unit\\_USD\\Daily"
          },
          {
            "name": "Item Cost A1 Unit Input",
            "expression": [
              "VAR SelectedCurrency = [Selected Currency] ",
              "VAR ISCalendarDate =",
              "    SELECTEDVALUE ( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    //\tISCalendarDate",
              "    SWITCH (",
              "        SelectedCurrency,",
              "        1, --local",
              "        MAXX ( 'Item Cost', 'Item Cost'[A1_Unit] ),",
              "        2,",
              "            --USD",
              "            CALCULATE(",
              "                CALCULATE(",
              "                    MAXX(",
              "                        'Item Cost',",
              "                        'Item Cost'[A1_Unit] * RELATED( 'Currency Rates'[ToRateDaily] )",
              "                    ),",
              "                    TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                ),",
              "                USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyASKey] )",
              "            ),",
              "        3,",
              "            --EUR",
              "            CALCULATE(",
              "                CALCULATE (",
              "                    MAXX (",
              "                        'Item Cost',",
              "                        'Item Cost'[A1_Unit] * RELATED ( 'Currency Rates'[ToRateDaily] )",
              "                    ),",
              "                    TREATAS ( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                ),",
              "                USERELATIONSHIP ( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyBSKey] )",
              "            ),",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "#0.0000",
            "isHidden": true
          },
          {
            "name": "Item Cost A2 Unit",
            "expression": [
              "//A2 Unit",
              "VAR UnitUOM = [Item Cost A2 Unit Input]",
              "RETURN",
              "IF(",
              "    ISFILTERED( 'Item Branch'[Item Num 2nd and Desc] )",
              "        || ISFILTERED( 'Item Branch'[Item Num 2nd] )",
              "        || ISFILTERED( 'Item Branch'[Item Num 3rd] )",
              "        || ISFILTERED( 'Item Branch'[Item Num Short] ),",
              "    MAXX( 'Item Cost', UnitUOM ),",
              "    BLANK( )",
              ")"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Unit"
          },
          {
            "name": "Item Cost A2 Unit Cost Avg USD",
