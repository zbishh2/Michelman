          {
            "name": "Qty On Hand KG",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        SWITCH(",
              "            \"KG\",",
              "            'Inventory Snapshot'[UOMPrimary], 'Inventory Snapshot'[QuantityOnHandPrimaryUOM],",
              "            'Inventory Snapshot'[QuantityOnHandPrimaryUOM] * 'Inventory Snapshot'[ToRateUMB]",
              "        )",
              "    )",
              ")"
            ],
            "displayFolder": "_Qty\\_KG_LB"
          },
          {
            "name": "Qty On Hand LB",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        SWITCH(",
              "            \"LB\",",
              "            'Inventory Snapshot'[UOMPrimary], 'Inventory Snapshot'[QuantityOnHandPrimaryUOM],",
              "            'Inventory Snapshot'[QuantityOnHandPrimaryUOM] * 'Inventory Snapshot'[ToRateUMA]",
              "        )",
              "        ",
              "    )",
              ")"
            ],
            "displayFolder": "_Qty\\_KG_LB"
          },
          {
            "name": "Qty On Hand Off Spec KG",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        [Qty On Hand KG] * [Lot Status Multiplier Input]",
              "    )",
              ")"
            ],
            "displayFolder": "_Qty\\_KG_LB"
          },
          {
            "name": "Qty On Hand Off Spec LB",
            "expression": [
              "CALCULATE(",
