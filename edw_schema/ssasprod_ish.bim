          {
            "name": "FCR Qty Aging",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        'Inventory Snapshot',",
              "        [FCR Qty On Hand] * [Aging Flag Input]",
              "            * [Aging Multiplier Input]",
              "    )",
              ")"
            ],
            "isHidden": true
          },
          {
            "name": "FCR Qty Available",
            "description": "[F41021.LIPQOH] - ([F41021.LIPBCK] + [F41021.LIHCOM] + [F41021.LIQOWO])",
            "expression": [
              "VAR SelectedUOM = [Selected UOM]",
              "",
              "VAR AverageRateUMA = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMA])",
              ")",
              "",
              "VAR AverageRateUMB = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMB])",
              ")",
              "",
              "VAR AverageRateUMC = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMC])",
              ")",
              "",
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR TotalQ = SUMX(",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "        \"AverageQty\", ",
              "        SWITCH(",
              "            SelectedUOM,",
              "            1, AVERAGE('Inventory Snapshot'[QuantityAvailable]),",
              "            2, AVERAGE('Inventory Snapshot'[QuantityAvailable]) * AverageRateUMA,",
              "            3, AVERAGE('Inventory Snapshot'[QuantityAvailable]) * AverageRateUMB,",
              "            4, AVERAGE('Inventory Snapshot'[QuantityAvailable]) * AverageRateUMC,",
              "               AVERAGE('Inventory Snapshot'[QuantityAvailable]) // Default to no conversion if none match.",
              "        )",
              "    ),",
              "    [AverageQty]",
              ")",
              "",
              "VAR AverageQ = TotalQ / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "",
              "RETURN",
              "AverageQ"
            ],
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "FCR Qty Committed",
            "description": "[F41021.LIHCOM] + [F41021.LIPCOM]",
            "expression": [
              "VAR SelectedUOM = [Selected UOM]",
              "",
              "VAR AverageRateUMA = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMA])",
              ")",
              "",
              "VAR AverageRateUMB = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMB])",
              ")",
              "",
              "VAR AverageRateUMC = CALCULATE(",
              "    AVERAGE('Inventory Snapshot'[ToRateUMC])",
              ")",
              "",
              "VAR MaxCalendarDate = MAX('Inventory Snapshot'[Calendar Date])",
              "",
              "VAR TotalQ = SUMX(",
              "    SUMMARIZE(",
              "        FILTER(",
              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
