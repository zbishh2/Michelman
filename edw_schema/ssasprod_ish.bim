              "            'Inventory Snapshot', ",
              "            'Inventory Snapshot'[Calendar Date] = MaxCalendarDate",
              "        ),",
              "        'Inventory Snapshot'[ItemBranchISKey],",
              "        'Inventory Snapshot'[Location],",
              "        'Inventory Snapshot'[LotNum],",
              "        'Inventory Snapshot'[CostMethod], // Include CostMethod to maintain context",
              "        \"AverageQty\", ",
              "        SWITCH(",
              "            SelectedUOM,",
              "            1, AVERAGE('Inventory Snapshot'[QuantityOnPurchaseOrde]),",
              "            2, AVERAGE('Inventory Snapshot'[QuantityOnPurchaseOrde]) * AverageRateUMA,",
              "            3, AVERAGE('Inventory Snapshot'[QuantityOnPurchaseOrde]) * AverageRateUMB,",
              "            4, AVERAGE('Inventory Snapshot'[QuantityOnPurchaseOrde]) * AverageRateUMC,",
              "               AVERAGE('Inventory Snapshot'[QuantityOnPurchaseOrde]) // Default to no conversion if none match.",
              "        )",
              "    ),",
              "    [AverageQty]",
              ")",
              "",
              "VAR AverageQ = TotalQ / DISTINCTCOUNT('Inventory Snapshot'[CostMethod])",
              "",
              "RETURN",
              "AverageQ"
            ],
            "formatString": "#,0",
            "isHidden": true
          },
