          },
          {
            "name": "Item Cost Unit",
            "expression": [
              "VAR SelectedCurrency = [Selected Currency]",
              "VAR ISCalendarDate = SELECTEDVALUE( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    //\tISCalendarDate",
              "    SWITCH(",
              "        SelectedCurrency,",
              "        1, --local",
              "        MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] ),",
              "        2,",
              "            --USD",
              "            CALCULATE(",
              "                CALCULATE(",
              "                    MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) ),",
              "                    TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                ),",
              "                USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyASKey] )",
              "            ),",
              "        3,",
              "            --EUR",
              "            CALCULATE(",
              "                CALCULATE(",
              "                    MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) ),",
              "                    TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                ),",
              "                USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyBSKey] )",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,##0.0000",
            "isHidden": true
          },
          {
            "name": "Item Cost Unit UOM",
            "expression": [
              "VAR SelectedUOM = [Selected UOM]",
              "VAR SelectedCurrency = [Selected Currency]",
              "VAR ISCalendarDate = SELECTEDVALUE( 'Calendar Inventory Snapshot'[Calendar Date] )",
              "RETURN",
              "    //\tISCalendarDate",
              "    SWITCH(",
              "        SelectedUOM,",
              "        1, --primary",
              "            SWITCH(",
              "                SelectedCurrency,",
              "                1, --local",
              "                MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] ),",
              "                2,",
              "                    --USD",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyASKey] )",
              "                    ),",
              "                3,",
              "                    --EUR",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyBSKey] )",
              "                    ),",
              "                BLANK( )",
              "            ),       ",
              "        //LB",
              "        2,",
              "            SWITCH(",
              "                SelectedCurrency,",
              "                1, --local",
              "                MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED('UOM Conversion'[LB]) ),",
              "                2,",
              "                    --USD",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) * RELATED('UOM Conversion'[LB]) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyASKey] )",
              "                    ),",
              "                3,",
              "                    --EUR",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) * RELATED('UOM Conversion'[LB]) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyBSKey] )",
              "                    ),",
              "                BLANK( )",
              "            ),       ",
              "        //KG",
              "        3,",
              "            SWITCH(",
              "                SelectedCurrency,",
              "                1, --local",
              "                MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED('UOM Conversion'[KG]) ),",
              "                2,",
              "                    --USD",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) * RELATED('UOM Conversion'[KG]) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyASKey] )",
              "                    ),",
              "                3,",
              "                    --EUR",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) * RELATED('UOM Conversion'[KG]) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyBSKey] )",
              "                    ),",
              "                BLANK( )",
              "            ),       ",
              "        //TM",
              "        4,",
              "            SWITCH(",
              "                SelectedCurrency,",
              "                1, --local",
              "                MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED('UOM Conversion'[TM]) ),",
              "                2,",
              "                    --USD",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) * RELATED('UOM Conversion'[TM]) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyASKey] )",
              "                    ),",
              "                3,",
              "                    --EUR",
              "                    CALCULATE(",
              "                        CALCULATE(",
              "                            MAXX( 'Item Cost', 'Item Cost'[AmountUnitCost_IC] * RELATED( 'Currency Rates'[ToRateDaily] ) * RELATED('UOM Conversion'[TM]) ),",
              "                            TREATAS( { ISCalendarDate }, 'Item Cost'[Calendar Date] )",
              "                        ),",
              "                        USERELATIONSHIP( 'Currency Rates'[CurrencySKey], 'Item Cost'[CurrencyBSKey] )",
              "                    ),",
              "                BLANK( )",
              "            ),",
              "        BLANK( )",
              "    )"
            ],
            "formatString": "#,##0.000000000",
            "isHidden": true
          },
          {
            "name": "Item Cost X1 Unit",
            "expression": [
              "//X1 Unit",
              "VAR UnitUOM = [Item Cost X1 Unit Input]",
              "RETURN",
              "IF(",
              "    ISFILTERED( 'Item Branch'[Item Num 2nd and Desc] )",
              "        || ISFILTERED( 'Item Branch'[Item Num 2nd] )",
              "        || ISFILTERED( 'Item Branch'[Item Num 3rd] )",
              "        || ISFILTERED( 'Item Branch'[Item Num Short] ),",
              "    MAXX( 'Item Cost', UnitUOM ),",
              "    BLANK( )",
              ")"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "_Frozen Cost Rollup\\_Unit"
          },
          {
            "name": "Item Cost X1 Unit Cost Avg USD",
            "expression": "MAXX( 'Item Cost', [Item Cost X1 Unit] * RELATED( 'Currency Rates'[ToRateA] ) )",
            "displayFolder": "_Frozen Cost Rollup\\_Unit\\_USD\\Average"
          },
          {
            "name": "Item Cost X1 Unit Cost Budget USD",
            "expression": "MAXX( 'Item Cost', [Item Cost X1 Unit] * RELATED( 'Currency Rates'[ToRateB] ) )",
            "displayFolder": "_Frozen Cost Rollup\\_Unit\\_USD\\Budget"
          },
          {
