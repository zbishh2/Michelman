	/// Line-grain key: Order Company, Order Num, Order Type, Order Suffix and Line Num joined by a pipe. Counted by [Order Lines].
	column OrderKey = ```
			
			    'FactSalesDetail'[Order Company] & "|"
			    & FORMAT('FactSalesDetail'[Order Num],"0") & "|"
			    & 'FactSalesDetail'[Order Type] & "|"
			    & 'FactSalesDetail'[Order Suffix] & "|"
			    & FORMAT('FactSalesDetail'[Line Num],"0")
			```
		lineageTag: 0da1872a-abce-4605-a10e-5966c5b075bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Constant 0.99, for a fixed reference line on order charts.
	column 'Target Line' = .99
		formatString: 0%;-0%;0%
		lineageTag: d4a25b86-bf5a-4977-8c73-201cebdac45c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// 1 when the line has no OTIF-relevant revision, else 0. Stored flag behind the static on-time measures.
	column 'On Time' = IF(CALCULATE(COUNTROWS(FactScheduleChange),FactScheduleChange[Is OTIF Relevant]=true)>0,0,1)
		formatString: 0
		lineageTag: feb97855-2598-4903-9344-1c99dbf43398
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// 1 when the line has at least one OTIF-relevant revision, else 0. Complement of [On Time].
	column Late = IF(CALCULATE(COUNTROWS(FactScheduleChange),FactScheduleChange[Is OTIF Relevant]=true)>0,1,0)
		formatString: 0
		lineageTag: cc97c313-5230-4aa9-b666-310ef2b0515d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

