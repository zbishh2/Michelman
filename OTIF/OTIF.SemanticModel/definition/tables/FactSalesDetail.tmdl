	/// Line number with any split suffix removed: FLOOR([Line Num]), so 1.001 and 1.002 both roll up to 1.000. Descriptive only — nothing is collapsed on it yet.
	column 'Parent Line Num'
		dataType: double
		formatString: 0.000
		lineageTag: 4a6c8e15-9b73-42d0-8f21-6e5a3c9b7d84
		summarizeBy: none
		sourceColumn: Parent Line Num

		annotation SummarizationSetBy = Automatic

	/// [Order Line ID] with the line number floored to its parent, so split children share one key. On a non-split line this is IDENTICAL to [Order Line ID]. Group by this instead of [Order Line ID] to see one row per commercial line.
	column 'Parent Order Line ID'
		dataType: string
		lineageTag: 7d2b5f91-6a48-4c37-b90e-3f8c1e4a6b25
		summarizeBy: none
		sourceColumn: Parent Order Line ID

		annotation SummarizationSetBy = Automatic

	/// 1 = this row is a split child (line number has a non-zero fraction, e.g. 1.001). Note freight also lands here: the BILLABLE FREIGHT line sits at .010. Use [Is Parent Row] to filter, not this column.
	column 'Is Split Child'
		dataType: int64
		formatString: 0
		lineageTag: 2f9a7c63-5d81-4b0e-a374-8c6b2e1f9d47
		summarizeBy: none
		sourceColumn: Is Split Child

		annotation SummarizationSetBy = Automatic

	/// Master Planning Family code (JDE F4102.IBPRP4, UDC 41/P4), folded fact-side from BIQL.TbItemBranch at (ItemSKey, Business Unit). 3-char code, trimmed at source. Use with [Master Planning Family Desc]; e.g. exclude 'PKG' to drop packaging/quilts.
	column 'Master Planning Family'
		dataType: string
		lineageTag: 8c1f4a72-3d6b-4e59-9a10-5b7e2c8d4f13
		summarizeBy: none
		sourceColumn: Master Planning Family

		annotation SummarizationSetBy = Automatic

	/// Decode of [Master Planning Family] via UDC 41/P4 (F0005.DRDL01). Blank where the UDC has no entry for the code.
	column 'Master Planning Family Desc'
		dataType: string
		lineageTag: 5e93b1d0-7c24-4f88-b6a3-1d0f9e6a72c5
		summarizeBy: none
		sourceColumn: Master Planning Family Desc

		annotation SummarizationSetBy = Automatic

	/// 1 = this row is the PARENT of its split family: the lowest [Line Num] within [Parent Order Line ID]. That is the .000 row where one exists, and the lowest child for the 117 families that have none - so no family is ever dropped. The report-level filter keeps only these rows, collapsing splits to one row per commercial line with every field already carrying the parent's own value. Freight sits at .010 and is therefore never the parent. Do NOT filter on [Is Split Child] = 0 instead: that would delete those 117 families entirely.
	column 'Is Parent Row' =
			VAR MinLine =
			    CALCULATE (
			        MIN ( 'FactSalesDetail'[Line Num] ),
			        ALLEXCEPT ( 'FactSalesDetail', 'FactSalesDetail'[Parent Order Line ID] )
			    )
			RETURN
			    IF ( 'FactSalesDetail'[Line Num] = MinLine, 1, 0 )
		formatString: 0
		lineageTag: 1d4f7a26-9c53-4e81-b072-5f8a3c6d9e14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Qty Ordered summed across the whole split family, FREIGHT EXCLUDED ([Line Type] = "FS"). Carried identically on every row of the family, so it is only meaningful alongside [Is Parent Row] = 1 - without that filter it repeats the family total once per child and inflates. Safe to sum: excluding freight, no multi-row family disagrees on Item or UoM (verified 2026-08-04).
	column 'Qty Ordered (Family)' =
			CALCULATE (
			    SUM ( 'FactSalesDetail'[Qty Ordered] ),
			    ALLEXCEPT ( 'FactSalesDetail', 'FactSalesDetail'[Parent Order Line ID] ),
			    'FactSalesDetail'[Line Type] <> "FS"
			)
		formatString: #,##0
		lineageTag: 2e5a8b37-0d64-4f92-a183-6b9c4d7e0f25
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Qty Shipped summed across the split family, freight excluded. See [Qty Ordered (Family)] for the caveat - only valid with [Is Parent Row] = 1.
	column 'Qty Shipped (Family)' =
			CALCULATE (
			    SUM ( 'FactSalesDetail'[Qty Shipped] ),
			    ALLEXCEPT ( 'FactSalesDetail', 'FactSalesDetail'[Parent Order Line ID] ),
			    'FactSalesDetail'[Line Type] <> "FS"
			)
		formatString: #,##0
		lineageTag: 3f6b9c48-1e75-4a03-b294-7c0d5e8f1a36
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Qty Open summed across the split family, freight excluded. See [Qty Ordered (Family)] for the caveat - only valid with [Is Parent Row] = 1.
	column 'Qty Open (Family)' =
			CALCULATE (
			    SUM ( 'FactSalesDetail'[Qty Open] ),
			    ALLEXCEPT ( 'FactSalesDetail', 'FactSalesDetail'[Parent Order Line ID] ),
			    'FactSalesDetail'[Line Type] <> "FS"
			)
		formatString: #,##0
		lineageTag: 4a7c0d59-2f86-4b14-c3a5-8d1e6f902b47
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Qty Backordered summed across the split family, freight excluded. See [Qty Ordered (Family)] for the caveat - only valid with [Is Parent Row] = 1.
	column 'Qty Backordered (Family)' =
			CALCULATE (
			    SUM ( 'FactSalesDetail'[Qty Backordered] ),
			    ALLEXCEPT ( 'FactSalesDetail', 'FactSalesDetail'[Parent Order Line ID] ),
			    'FactSalesDetail'[Line Type] <> "FS"
			)
		formatString: #,##0
		lineageTag: 5b8d1e6a-3097-4c25-d4b6-9e2f7a013c58
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column OnTime = IF(CALCULATE(COUNTROWS(FactScheduleChange),FactScheduleChange[Is OTIF Relevant]=true)>0,"No","Yes")
		lineageTag: a9b489d8-5f11-4635-ae71-66f4ba9352b9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// JDE next status for the line. 999 = closed; anything below is an open line.
	column 'Status Code Next'
		dataType: string
		lineageTag: da664f56-715f-444a-9d7a-39adf90de227
		summarizeBy: none
		sourceColumn: Status Code Next

		annotation SummarizationSetBy = Automatic

	/// 1 = the invoiced population (GL-posted, GL Date on or after 1/1/2024) every shipped OTIF number reads; page-level filters hold Flag = 1 on every page except OTIF Backlog (Open Orders). 0 = open order line (Status Code Next below 999), which carries the JDE 1900 GL-date placeholder until invoicing.
	column 'Flag In Population' = IF ( 'FactSalesDetail'[GL Date] >= DATE ( 2024, 1, 1 ), 1, 0 )
		formatString: 0
		lineageTag: 97f6c57c-6db8-4e04-9c7f-3842a6784479
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition FactSalesDetail = m
		mode: import
		source =
				// Orders (denominator) — EDW Fact/Dim star
				// Source: EDWPROD.michem.com / EDW / dbo.FactSalesDetail. The orders feed is
				// current (through 2026); only Salesforce is stale. "Orders" = distinct
				// [Order Num] (a measure). Column aliases match Complaints.xlsx 'Sales Orders'.
				//
				// CONNECTION: native query (Sql.Database with [Query=...]). This matches the
				// deployed PBIP partition (Executive Dashboard.SemanticModel ... Orders.tmdl) and
				// binds to the shared on-prem data gateway for scheduled refresh in the Power BI
				// Service. The SELECT is the source-of-truth column set (wider than the old
				// navigation-pattern draft — notably it keeps [Order Line ID] and the
				// item/customer/shipment columns). Note: a native query is a fixed passthrough,
				// so downstream PQ steps past Typed may not fold — keep transforms in the SQL.
				//
				// SERVER must match the gateway's registered data source string — registered
				// as the short name "EDWPROD" — and resolve where the PBIX refreshes in Desktop
				// (the jump box; the short name resolves there via DNS suffix). Gateway creds:
				// Windows auth, UPN "ZackB@michem.com" (NOT the michelman.com mail address, NOT
				// "Zack.bishop" — the AD account is ZackB and the AD domain is michem.com).
				//
				// Notes:
				//  - SSAS helper cols (Order Exclude / Filter Active Types / Exclude Freight)
				//    don't exist in the raw fact — apply the equivalent on Order Type / Line
				//    Type / Cancelled_Flag (kept raw, filtered in the measure; Greg to lock).
				//  - WINDOW: GLDate >= 2024-01-01 keeps the invoiced (GL-posted) population; OR
				//    StatusCodeNext <> '999' adds the open order lines (~800 orders / ~1.2k lines), which carry the JDE
				//    1900 GLDate placeholder until invoicing. [Flag In Population] (DAX) = 1 marks
				//    the invoiced population; page-level filters hold Flag = 1 on every page except
				//    OTIF Backlog (Open Orders), so shipped numbers read the invoiced population.
				//    The Executive Dashboard partition keeps the invoiced-only window — open lines
				//    stay out of revenue reporting.
				//  - RecordType 'GL Detail' rows (= Line Type 'AA') are dropped at source. The
				//    "IS NULL OR" guard keeps NULL RecordType rows under SQL's three-valued logic.
				//  - [Business Unit Revenue] = JDE revenue business unit (MCU): first 2 digits =
				//    company (10 = Americas, 20 = Europe); remainder = cost center / product line.
				//
				// COGNOS FILTERSETS AS SOFT FLAGS (added 2026-06-28): the IT-provided Cognos query
				//   hard-filters five conditions. Per request these are NOT hard-filtered here —
				//   each is emitted as a 1/0 [Flag ...] column so the report can reproduce the
				//   Cognos population exactly via slicer (Flag = 1 on all five) without losing rows.
				//   GLDate >= 2024-01-01 stays the only hard bound (analogous to keeping the floor).
				//   FactSalesDetail carries every source column, so these are EXACT, not proxies:
				//     [Flag Positive Volume]          (QuantityOrdered*ConversionFactorLB*SalesFactor) > 0
				//     [Flag Line Type S]              LineType = 'S'
				//     [Flag Not Sched]                UserID <> 'SCHED'   (UserID = JDE SDUSER, last-updated-by)
				//     [Flag Updated In Cognos Window] UpdatedDate in 2024-01-01..2025-02-24
				//     [Flag Not India Tax]            ItemNum2nd not in IGST/CGST/SGST/CVD/ADD
				//   ⚠ India-tax: Cognos keys off decode(GLOBAL_BULK_ITEM,'-',ITEM_NUMBER_2ND,
				//     GLOBAL_BULK_ITEM); FactSalesDetail has no GlobalBulkItem column, so we test
				//     ItemNum2nd directly. Equivalent unless a bulk item overrides the 2nd item #.
				//   Supporting raw cols [Updated Date]/[Updated By]/[Conversion Factor LB]/
				//   [Sales Factor]/[Revision Reason] are surfaced so the flags are auditable and
				//   [Revision Reason] is available alongside [Order Line ID] for FactScheduleChange.
				//
				// MASTER PLANNING FAMILY (added 2026-08-04): [Master Planning Family] + its decode are
				//   folded on as FACT columns, not via a new dimension + relationship. MPF is
				//   F4102.IBPRP4 (item BRANCH, not item master), decoded by UDC 41/P4, and is exposed
				//   only on the BIQL view — dbo.DimItemBranch does not carry the enrichment columns
				//   (CLAUDE.md §4). Its grain is (ItemSKey, Business Unit), BOTH of which this SELECT
				//   already carries, so the fold is a LEFT JOIN with no new source.
				//   Fact-side by design: a 1:1 dimension hop in a wide-grid group-by is what caused the
				//   OOM documented in CLAUDE.md §7, and the fix there was exactly this — push the
				//   attribute onto FactSalesDetail. It also means zero DAX changes and no bidirectional
				//   filter risk.
				//   ⚠ FAN-OUT GUARD: the join target is a GROUP BY derived table, so it emits at most one
				//   row per (ItemSKey, BU) and this join therefore cannot change the fact row count.
				//   TbItemBranch is not documented as unique on that pair — report 14
				//   (Inventory.commented.m) deduped it defensively with ROW_NUMBER for the same reason.
				//   A GROUP BY derived table is hash-aggregated once; it is NOT the correlated per-row
				//   lookup (OUTER APPLY / ROW_NUMBER) that hung report 14 twice, per CLAUDE.md §7.
				//   MIN() is the tie-break. Run edw_schema/probe9_mpf_itembranch.sql on the jumpbox
				//   BEFORE the first refresh: probe 3 says whether duplicate pairs exist at all, probe 4
				//   whether any DISAGREE on MPF (only then is MIN an arbitrary pick needing a real rule).
				//   Both sides are nchar(12) so ANSI padding makes '=' trailing-space-insensitive; the
				//   TRIMs are belt-and-braces and match report 14's pairing.
				//   NOT hard-filtered. The ask that motivated this is excluding MPF = 'PKG' (packaging /
				//   quilts), but per the soft-flag convention above no rows are dropped here — slice it
				//   in the report. Lock the exclusion list first, then promote it to a [Flag ...] column.
				//
				// SPLIT LINES (added 2026-08-04, descriptive columns only): JDE splits a sales order
				//   line into 1.000 / 1.001 / 1.002 (LineNum is decimal(9,3)). Ivan's concern is that
				//   these inflate the OTIF line count and late-line count when they are commercially one
				//   line. Three descriptive columns are added — [Parent Line Num],
				//   [Parent Order Line ID], [Is Split Child] — and NOTHING is collapsed or filtered.
				//   The grain is deliberately UNCHANGED: [Order Line ID] is the join key for
				//   FactScheduleChange, the key LineComments rides on, and is embedded inside RevisionKey,
				//   which is what every writeback row in D1 is keyed by (writeback/ARCHITECTURE.md).
				//   Re-graining the fact would orphan every existing revision override and line comment.
				//   The parent roll-up therefore belongs in DAX measures over [Parent Order Line ID],
				//   which can sit beside the existing line-grain measures for comparison.
				//   Agreed rule (Zack, 2026-08-04): take the PARENT row's values for everything, and only
				//   order qty aggregates across the family.
				//   ⚠ That rule is only safe if split children agree with the parent on the OTIF dates —
				//   a split often exists BECAUSE the delivery split, in which case the child carries its
				//   own later promised date and parent-only would hide the late remainder. Probe 4 of
				//   edw_schema/probe10_line_splits.sql measures exactly this. Measures are on hold until
				//   it comes back. Probe 2 also confirms how much of the fractional-line population is
				//   kit components rather than splits.
				let
				    Source = Sql.Database(
				        "EDWPROD",
				        "EDW",
				        [Query = "
				SELECT
				    OrderNum                 AS [Order Num],
				    OrderCompany             AS [Order Company],
				    OrderType                AS [Order Type],
				    OrderSuffix              AS [Order Suffix],
				    LineNum                  AS [Line Num],
				    LineType                 AS [Line Type],
				    LineTypeDesc             AS [Line Type Desc],
				    RecordType               AS [Record Type],
				    Cancelled_Flag,
				    StatusCodeLast           AS [Status Code Last],
				    StatusCodeNext           AS [Status Code Next],  -- 999 = closed; anything below is an open line
				    GLDate                   AS [GL Date],
				    ActualShipDate           AS [Actual Ship Date],
				    OrderDate                AS [Order Date],
				    QuantityOrdered          AS [Qty Ordered],
				    QuantityShipped          AS [Qty Shipped],
				    QuantityCanceledScrapped AS [Qty Cancelled],
				    UOMTransaction           AS [UoM],
				    LotSKey,
				    LotNum                   AS [Lot Num],
				    ShipToCustomerSKey,
				    PromisedDeliveryDate         AS [Promised Delivery Date],
				    RequestedDate                AS [Requested Date],
				    PromisedShipmentDate         AS [Promised Shipment Date],
				    OriginalPromisedDeliveryDate AS [Original Promised Delivery Date],
				    ScheduledPickDate            AS [Scheduled Pick Date],
				    Description1             AS [Product Description],
				    Description2             AS [Product Description 2],
				    ItemNumShort             AS [Item Num],
				    ItemNum2nd               AS [Item Num 2nd],
				    Location                 AS [Location],
				    BusinessUnit             AS [Business Unit],
				    BusinessUnitRevenue      AS [Business Unit Revenue],
				    OrderTakenBy             AS [Order Taken By],
				    OrderedBy                AS [Ordered By],
				    ShipmentNum              AS [Shipment Num],
				    BillOfLading             AS [Bill Of Lading],
				    OrderLineID              AS [Order Line ID],
				    OrderHeaderID            AS [Order Header ID],
				    -- Split-line roll-up helpers. LineNum is decimal(9,3); 1.001/1.002 are JDE split
				    -- children of parent line 1.000. [Parent Order Line ID] is derived by string surgery
				    -- on the REAL OrderLineID rather than reconstructed from its parts, so the prefix
				    -- matches byte-for-byte whatever format EDW uses — and on a non-split line it comes
				    -- out identical to [Order Line ID], which is the built-in self-check.
				    -- An [Is Kit Line] flag was tried here (KitMasterLineNum/KitIdentifier <> 0) and
				    -- REMOVED 2026-08-04: it returned 1 on 91% of rows, so those EDW columns are not
				    -- zero-defaulted and the test was meaningless. It is also unnecessary — the real
				    -- confound inside a parent family turned out to be the FREIGHT line, not kits
				    -- (measured live: every family carries its product splits at .001-.00n and a
				    -- LineType 'FS' BILLABLE FREIGHT line at .010). Freight is already identifiable
				    -- via [Line Type] = 'FS'; exclude it from any parent roll-up. Verified in the
				    -- refreshed model: with FS rows excluded, ZERO of the 8,119 multi-row families
				    -- disagree on Item, UoM or Master Planning Family.
				    CAST(FLOOR(LineNum) AS decimal(9,3)) AS [Parent Line Num],
				    LEFT(LTRIM(RTRIM(OrderLineID)),
				         LEN(LTRIM(RTRIM(OrderLineID))) - CHARINDEX(',', REVERSE(LTRIM(RTRIM(OrderLineID)))))
				      + ',' + CAST(CAST(FLOOR(LineNum) AS decimal(9,3)) AS varchar(12)) AS [Parent Order Line ID],
				    CASE WHEN LineNum <> FLOOR(LineNum) THEN 1 ELSE 0 END AS [Is Split Child],
				    SerialNumLot             AS [Serial Num Lot],
				    AmountExtendedPrice      AS [Ext Price],
				    AmountOpen               AS [Amount Open],
				    QuantityBackordered      AS [Qty Backordered],
				    QuantityOpen             AS [Qty Open],
				    QuantityShippedtoDate    AS [Qty Shipped To Date],
				    GrossWeight              AS [Gross Weight],
				    UnitWeight               AS [Unit Weight],
				    HoldOrdersCode           AS [Hold Code],
				    ReasonCode               AS [Reason Code],
				    ReasonCodeDesc           AS [Reason Code Desc],
				    ModeOfTransport          AS [Mode Of Transport],
				    CarrierNum               AS [Carrier Num],
				    FreightHandlingCode      AS [Freight Handling Code],
				    CancelDate               AS [Cancel Date],
				    InvoiceDate              AS [Invoice Date],
				    ShipToAddressSKey,
				    SoldToAddressSKey,
				    SoldToCustomerSKey,
				    ParentCustomerSKey,
				    f.ItemSKey,
				    -- Master Planning Family (F4102.IBPRP4, UDC 41/P4) folded from BIQL.TbItemBranch
				    -- at (ItemSKey, Business Unit). Dedup guaranteed by the GROUP BY in the join below.
				    ib.MasterPlanningFamily     AS [Master Planning Family],
				    ib.MasterPlanningFamilyDesc AS [Master Planning Family Desc],
				    -- Supporting raw columns for the Cognos flags below (and FactScheduleChange link)
				    UpdatedDate              AS [Updated Date],
				    UserID                   AS [Updated By],
				    ConversionFactorLB       AS [Conversion Factor LB],
				    SalesFactor              AS [Sales Factor],
				    RevisionReason           AS [Revision Reason],
				    -- Cognos filterset flags (soft): 1 = row matches the Cognos WHERE condition.
				    -- Slice Flag = 1 on all five to reproduce the Cognos population; none drop rows.
				    CASE WHEN (QuantityOrdered * ConversionFactorLB * SalesFactor) > 0 THEN 1 ELSE 0 END AS [Flag Positive Volume],
				    CASE WHEN LineType = 'S' THEN 1 ELSE 0 END AS [Flag Line Type S],
				    CASE WHEN LTRIM(RTRIM(UserID)) <> 'SCHED' THEN 1 ELSE 0 END AS [Flag Not Sched],
				    CASE WHEN UpdatedDate BETWEEN '2024-01-01' AND '2025-02-24' THEN 1 ELSE 0 END AS [Flag Updated In Cognos Window],
				    CASE WHEN LTRIM(RTRIM(ItemNum2nd)) NOT IN ('IGST','CGST','SGST','CVD','ADD') THEN 1 ELSE 0 END AS [Flag Not India Tax]
				FROM dbo.FactSalesDetail f
				LEFT JOIN (
				    SELECT ItemSKey,
				           LTRIM(RTRIM([Business Unit]))                    AS BU,
				           MIN(LTRIM(RTRIM([Master Planning Family])))      AS MasterPlanningFamily,
				           MIN(LTRIM(RTRIM([Master Planning Family Desc]))) AS MasterPlanningFamilyDesc
				    FROM BIQL.TbItemBranch
				    GROUP BY ItemSKey, LTRIM(RTRIM([Business Unit]))
				) ib ON ib.ItemSKey = f.ItemSKey
				    AND ib.BU       = LTRIM(RTRIM(f.BusinessUnit))
				WHERE (GLDate >= '2024-01-01' OR StatusCodeNext <> '999')
				  AND (RecordType IS NULL OR RecordType <> 'GL Detail')
				"]
				    ),
				    Typed = Table.TransformColumnTypes(
				        Source,
				        {
				            {"GL Date", type date},
				            {"Actual Ship Date", type date},
				            {"Order Date", type date},
				            {"Promised Delivery Date", type date},
				            {"Requested Date", type date},
				            {"Promised Shipment Date", type date},
				            {"Original Promised Delivery Date", type date},
				            {"Scheduled Pick Date", type date},
				            {"Cancel Date", type date},
				            {"Invoice Date", type date},
				            {"Updated Date", type date}
				        },
				        "en-US"
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

