table FactSalesDetail
	lineageTag: b8b0720f-9250-48fc-8769-ecf8dd16b18c

	/// Region for the order company: 10 Americas, 20 EMEA, 30/34/35 Asia, anything else Unmapped. Join key to 'Dim Region'[Region].
	column Region =
			SWITCH (
			    VALUE ( 'FactSalesDetail'[Order Company] ),
			    10, "Americas",
			    20, "EMEA",
			    30, "Asia",
			    34, "Asia",
			    35, "Asia",
			    "Unmapped"
			)
		lineageTag: 65933f8c-5840-4383-951c-c620f0b06ee3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

