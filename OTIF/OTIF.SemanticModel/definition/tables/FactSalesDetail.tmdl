	/// Total forward promised-date movement, in days, across the line's OTIF-relevant revisions. Negative moves are excluded, so pull-ins do not offset slips.
	column 'Days Moved' = CALCULATE(SUM(FactScheduleChange[Days Moved]),FactScheduleChange[OTIF Relevant]=1,FactScheduleChange[Days Moved]>0)
		formatString: 0
		lineageTag: f6b28436-146b-447e-b5c7-9799c2074695
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Actual lead time in days: Actual Ship Date minus Order Date.
	column 'Actual Order to Ship LT' = 'FactSalesDetail'[Actual Ship Date] - 'FactSalesDetail'[Order Date]
		dataType: int64
		formatString: 0
		lineageTag: 7ca40ef9-22d1-40f8-a12c-0bcb5bfffa2a
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	/// Comma-separated list of the line's OTIF-relevant revision reasons, each followed by its total days moved.
	column 'Revision Reasons' =
			
			VAR RelevantRows =
			    FILTER (
			        RELATEDTABLE ( FactScheduleChange ),
			        FactScheduleChange[Is OTIF Relevant] = TRUE()
			            && NOT ISBLANK ( FactScheduleChange[RevisionReason] )
			    )
			VAR ReasonSummary =
			    GROUPBY (
			        RelevantRows,
			        FactScheduleChange[RevisionReason],
			        "TotalDaysMoved",
			            SUMX ( CURRENTGROUP (), FactScheduleChange[Days Moved] )
			    )
			RETURN
			    CONCATENATEX (
			        ReasonSummary,
			        FactScheduleChange[RevisionReason]
			            & " ("
			            & [TotalDaysMoved]
			            & " Days)",
			        ", ",
			        FactScheduleChange[RevisionReason],
			        ASC
			    )
		lineageTag: f29352e6-d5fe-4ec2-9911-c99a78eb2c14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// 1 when Actual Ship Date is on or before Requested Date, else 0. An unshipped line carries the JDE empty ship date, which precedes any requested date and so scores as 1.
	column 'Shipped as Requested' = IF('FactSalesDetail'[Actual Ship Date]<='FactSalesDetail'[Requested Date],1,0)
		formatString: 0
		lineageTag: f331e23a-59e2-4227-93f3-8d344962ff65
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// On-time flag scored on the original JDE reason codes, ignoring Revision Log Editor overrides and exclusions.
	column 'On Time (As Reported)' = IF(CALCULATE(COUNTROWS(FactScheduleChange),FactScheduleChange[Is OTIF Relevant (As Reported)]=true)>0,0,1)
		dataType: int64
		formatString: 0
		lineageTag: eec51f0a-c39b-4ca4-acce-d7d0a2d315ef
		summarizeBy: sum

	/// Line number formatted to three decimals, matching the line-number component of the revision ledger's OrderLineID.
	column 'Line Num Text' = FORMAT ( 'FactSalesDetail'[Line Num], "0.000" )
		dataType: string
		lineageTag: 83f4ece4-2053-4439-8697-47f3978217bb
		summarizeBy: none

	/// JDE transaction unit of measure for the line (F4211.SDUOM, EDW dbo.FactSalesDetail.UOMTransaction).
	/// Shown beside Qty Ordered / Qty Shipped so quantities are readable and never totalled across mixed UoMs.
	column UoM
		dataType: string
		lineageTag: 5a1c9d70-6b2e-4f18-9c3a-7e10d4b8f2a6
		summarizeBy: none
		sourceColumn: UoM

		annotation SummarizationSetBy = Automatic

	/// Sold-To name pulled from the related dimension row, so it can sit in a wide grid without a dimension hop in the group-by.
	column 'Sold-To Name' = RELATED('Sold-To'[Sold-To Name])
		dataType: string
		lineageTag: 53b461d0-11f5-453c-acab-922cf692a51b
		summarizeBy: none

	/// Ship-To name pulled from the related dimension row, so it can sit in a wide grid without a dimension hop in the group-by.
	column 'Ship-To Name' = RELATED('Ship-To'[Ship-To Name])
		dataType: string
		lineageTag: 69a77626-02ce-4e12-8049-8c5ca83e1962
