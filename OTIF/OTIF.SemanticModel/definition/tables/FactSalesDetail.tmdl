	/// Customer tier (Bronze/Silver/Gold/Platinum) pulled from the related Sold-To row, so tier is available fact-side without a dimension hop.
	column 'Customer Segmentation' = RELATED('Sold-To'[Customer Segmentation])
		dataType: string
