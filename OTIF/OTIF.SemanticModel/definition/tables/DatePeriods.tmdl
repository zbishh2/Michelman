	column ValidMonthly
		formatString: 0
		lineageTag: 0e428cb2-7b1c-4986-932a-17fdedf997f4
		summarizeBy: sum
		isNameInferred
		sourceColumn: [ValidMonthly]

		annotation SummarizationSetBy = Automatic

	partition DatePeriods = calculated
		mode: import
		source =
				
				VAR __Today = TODAY()
				VAR __MonStart = __Today - WEEKDAY(__Today, 2) + 1
				VAR __MTDStart = DATE(YEAR(__Today), MONTH(__Today), 1)
				
				VAR __PreviousMonthStart = EOMONTH(__Today, -2) + 1
				VAR __PreviousMonthEnd = EOMONTH(__Today, -1)
				VAR __LastMonthEnd = EOMONTH(__Today, -1)
				
				VAR __Last3MonthsStart = EOMONTH(__Today, -4) + 1
				
				VAR __L6M = EDATE(__Today, -6)
				VAR __L6MStart = DATE(YEAR(__L6M), MONTH(__L6M), 1)
				
				VAR __L12M = EDATE(__Today, -12)
				VAR __L12MStart = DATE(YEAR(__L12M), MONTH(__L12M), 1)
				
				VAR __QTDStart = DATE(YEAR(__Today), INT((MONTH(__Today) - 1) / 3) * 3 + 1, 1)
				VAR __YTDStart = DATE(YEAR(__Today), 1, 1)
				
				VAR __LastYearStart = DATE(YEAR(__Today) - 1, 1, 1)
				VAR __LastYearEnd = DATE(YEAR(__Today) - 1, 12, 31)
				
				RETURN
				UNION (
				    ADDCOLUMNS(CALENDAR(__Today - 9, __Today), "Type", "Last 10 Calendar Days", "Sort", 1, "ValidDaily", 1, "ValidWeekly", 0, "ValidMonthly", 0),
				    ADDCOLUMNS(CALENDAR(__Today - 29, __Today), "Type", "Last 30 Days", "Sort", 2, "ValidDaily", 1, "ValidWeekly", 0, "ValidMonthly", 0),
				    ADDCOLUMNS(CALENDAR(__MonStart, __Today), "Type", "WTD", "Sort", 3, "ValidDaily", 1, "ValidWeekly", 0, "ValidMonthly", 0),
				    ADDCOLUMNS(CALENDAR(__MTDStart, __Today), "Type", "MTD", "Sort", 4, "ValidDaily", 1, "ValidWeekly", 0, "ValidMonthly", 0),
				    ADDCOLUMNS(CALENDAR(__QTDStart, __Today), "Type", "QTD", "Sort", 5, "ValidDaily", 0, "ValidWeekly", 1, "ValidMonthly", 0),
				    ADDCOLUMNS(CALENDAR(__YTDStart, __Today), "Type", "YTD", "Sort", 6, "ValidDaily", 1, "ValidWeekly", 1, "ValidMonthly", 1),
				    ADDCOLUMNS(CALENDAR(__PreviousMonthStart, __PreviousMonthEnd), "Type", "Previous Month", "Sort", 7, "ValidDaily", 1, "ValidWeekly", 0, "ValidMonthly", 1),
				    ADDCOLUMNS(CALENDAR(__Last3MonthsStart, __LastMonthEnd), "Type", "Last 3 Months", "Sort", 8, "ValidDaily", 1, "ValidWeekly", 1, "ValidMonthly", 1),
				    ADDCOLUMNS(CALENDAR(__L6MStart, __LastMonthEnd), "Type", "Last 6 Months", "Sort", 9, "ValidDaily", 0, "ValidWeekly", 0, "ValidMonthly", 1),
				    ADDCOLUMNS(CALENDAR(__L12MStart, __LastMonthEnd), "Type", "Last 12 Months", "Sort", 10, "ValidDaily", 0, "ValidWeekly", 0, "ValidMonthly", 1),
				    ADDCOLUMNS(CALENDAR(__Today - 90, __Today), "Type", "Last 13 Weeks", "Sort", 11, "ValidDaily", 0, "ValidWeekly", 1, "ValidMonthly", 0),
				    ADDCOLUMNS(CALENDAR(__Today - 181, __Today), "Type", "Last 26 Weeks", "Sort", 12, "ValidDaily", 0, "ValidWeekly", 1, "ValidMonthly", 0),
				    ADDCOLUMNS(CALENDAR(__LastYearStart, __LastYearEnd), "Type", "Last Year", "Sort", 13, "ValidDaily", 0, "ValidWeekly", 0, "ValidMonthly", 1),
				    ADDCOLUMNS(CALENDAR(MIN(DateTable[Date]), MAX(DateTable[Date])), "Type", "All Time", "Sort", 14, "ValidDaily", 0, "ValidWeekly", 0, "ValidMonthly", 1)
				)

	annotation PBI_Id = a2e2e748e0f94a6aa399d94ad4eff1dc

